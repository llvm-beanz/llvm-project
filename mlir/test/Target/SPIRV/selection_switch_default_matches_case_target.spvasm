; RUN: %if spirv-tools %{ spirv-as --target-env spv1.0 %s -o - | mlir-translate --deserialize-spirv - -o - | FileCheck %s %}

; This tests deserializing an OpSwitch where the default target and one of
; the case-literal targets are the *same* block (%13), which itself takes an
; OpPhi-derived block argument -- a real
; dEQP-VK.graphicsfuzz.switch-with-fall-through-cases shape (a `switch` whose
; `case 2` falls through into `default`). Each occurrence of a repeated
; target (default or case-literal) is its own successor entry and must get
; its own copy of the block argument; previously only the default
; occurrence's target was ever rebuilt with the block argument when `target`
; matched the default, leaving any case-literal duplicate of that same block
; with zero block arguments and failing verification ("branch has 0 operands
; for successor #N, but target block has 1").

; CHECK:      spirv.Switch {{%.*}} : si32, [
; CHECK-NEXT:   default: ^[[dup:.+]]({{%.*}} : f32),
; CHECK-NEXT:   0: ^[[other:.+]],
; CHECK-NEXT:   1: ^[[dup]]({{%.*}} : f32)
; CHECK-NEXT: ]

               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main"
               OpExecutionMode %main LocalSize 1 1 1
               OpName %switch "switch"
               OpName %main "main"
       %void = OpTypeVoid
        %int = OpTypeInt 32 1
          %1 = OpTypeFunction %void %int
      %float = OpTypeFloat 32
    %float_1 = OpConstant %float 1
    %float_3 = OpConstant %float 3
         %25 = OpTypeFunction %void
     %switch = OpFunction %void None %1
          %5 = OpFunctionParameter %int
          %6 = OpLabel
               OpSelectionMerge %90 None
               OpSwitch %5 %13 0 %14 1 %13
         %13 = OpLabel
         %16 = OpPhi %float %float_1 %6
               OpBranch %90
         %14 = OpLabel
               OpBranch %90
         %90 = OpLabel
         %22 = OpPhi %float %16 %13 %float_3 %14
               OpReturn
               OpFunctionEnd
       %main = OpFunction %void None %25
         %27 = OpLabel
               OpReturn
               OpFunctionEnd
