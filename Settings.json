{
  "CMakeOptions": {
    "Targets": {
      "Values": [
        "Native",
        "AArch64",
        "AMDGPU",
        "ARM",
        "AVR",
        "BPF",
        "Hexagon",
        "Lanai",
        "LoongArch",
        "Mips",
        "MSP430",
        "NVPTX",
        "PowerPC",
        "RISCV",
        "Sparc",
        "SPIRV",
        "SystemZ",
        "VE",
        "WebAssembly",
        "X86",
        "XCore"
      ],
      "Option": "LLVM_TARGETS_TO_BUILD",
      "Default": "Native",
      "Description": "The list of targets to build. Use 'Native' to build only the host target.",
      "MultipleValues": true
    },
    "Projects": {
      "Values": [
        "all",
        "bolt",
        "clang",
        "clang-tools-extra",
        "cross-project-tests",
        "lldb",
        "mlir",
        "polly",
        "lld"
      ],
      "Option": "LLVM_ENABLE_PROJECTS",
      "Default": "",
      "Description": "The list of projects to build. Use 'all' to build all projects. Defaults to building only the LLVM core libraries.",
      "MultipleValues": true
    },
    "Runtimes": {
      "Values": [
        "all",
        "compiler-rt",
        "libcxx",
        "libcxxabi",
        "libunwind",
        "libclc",
        "openmp"
      ],
      "Option": "LLVM_ENABLE_RUNTIMES",
      "Default": "",
      "Description": "The list of runtimes to build. Defaults to building no runtimes.",
      "MultipleValues": true
    },
    "BuildType": {
      "Values": [
        "Debug",
        "Release",
        "RelWithDebInfo",
        "MinSizeRel"
      ],
      "Option": "CMAKE_BUILD_TYPE",
      "Default": "Release",
      "Description": "The build type to build."
    }
  },
  "Dependencies": {
    "CMake": {
      "required": true,
      "file": "cmake",
      "apt": "cmake",
      "brew": "cmake",
      "pkg": "cmake",
      "url": "https://cmake.org/download/",
      "category": "build configuration"
    },
    "Ninja": {
      "required": false,
      "recommend": true,
      "file": "ninja",
      "apt": "ninja-build",
      "brew": "ninja",
      "pkg": "ninja",
      "url": "https://github.com/ninja-build/ninja/releases",
      "category": "build tool"
    },
    "Make": {
      "required": false,
      "file": "make",
      "apt": "make",
      "brew": "make",
      "pkg": "make",
      "url": "https://www.gnu.org/software/make/",
      "category": "build tool"
    },
    "Xcode": {
      "required": false,
      "hide": "sys.platform != 'darwin'",
      "file": "xcodebuild",
      "url": "https://developer.apple.com/xcode/",
      "category": "build tool"
    },
    "Visual Studio": {
      "required": false,
      "hide": "sys.platform != 'win32'",
      "file": "devenv",
      "url": "https://visualstudio.microsoft.com/",
      "category": "build tool"
    },
    "LLD": {
      "hide": "sys.platform == 'darwin'",
      "recommend": "sys.platform != 'darwin'",
      "message": "LLD is strongly encouraged on ELF platforms (Linux & BSD)",
      "file": "lld",
      "apt": "lld",
      "brew": "lld",
      "pkg": "lld",
      "url": "https://github.com/llvm/llvm-project/releases",
      "category": "linker"
    },
    "sccache": {
      "required": false,
      "file": "sccache",
      "apt": "sccache",
      "brew": "sccache",
      "pkg": "sccache",
      "url": "https://github.com/mozilla/sccache/releases",
      "category": "compiler cache"
    },
    "ccache": {
      "required": false,
      "file": "ccache",
      "apt": "ccache",
      "brew": "ccache",
      "pkg": "ccache",
      "url": "https://ccache.dev/download.html",
      "category": "compiler cache"
    },
    "clang": {
      "required": true,
      "file": "clang",
      "apt": "clang",
      "brew": "clang",
      "pkg": "clang",
      "url": "https://gcc.gnu.org/releases.html",
      "category": "compiler"
    },
    "gcc": {
      "required": true,
      "file": "gcc",
      "apt": "gcc",
      "brew": "gcc",
      "pkg": "gcc",
      "url": "https://gcc.gnu.org/releases.html",
      "category": "compiler"
    }
  }
}
