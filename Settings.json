{
  "CMakeOptions": {
    "Targets": {
      "Values": [
        "NATIVE",
        "X86",
        "ARM",
        "AArch64"
      ],
      "Option": "LLVM_TARGETS_TO_BUILD",
      "Default": "NATIVE",
      "Description": "The list of targets to build. Use 'NATIVE' to build only the host target.",
      "MultipleValues": true
    },
    "BuildType": {
      "Values": [
        "Debug",
        "Release",
        "RelWithDebInfo",
        "MinSizeRel"
      ],
      "Option": "CMAKE_BUILD_TYPE",
      "Default": "Release",
      "Description": "The build type to build."
    }
  },
  "Dependencies": {
    "CMake": {
      "required": true,
      "file": "cmake",
      "apt": "cmake",
      "brew": "cmake",
      "pkg": "cmake",
      "url": "https://cmake.org/download/",
      "category": "build configuration"
    },
    "Ninja": {
      "required": false,
      "recommend": true,
      "file": "ninja",
      "apt": "ninja-build",
      "brew": "ninja",
      "pkg": "ninja",
      "url": "https://github.com/ninja-build/ninja/releases",
      "category": "build tool"
    },
    "Make": {
      "required": false,
      "file": "make",
      "apt": "make",
      "brew": "make",
      "pkg": "make",
      "url": "https://www.gnu.org/software/make/",
      "category": "build tool"
    },
    "Xcode": {
      "required": false,
      "hide": "sys.platform != 'darwin'",
      "file": "xcodebuild",
      "url": "https://developer.apple.com/xcode/",
      "category": "build tool"
    },
    "Visual Studio": {
      "required": false,
      "hide": "sys.platform != 'win32'",
      "file": "devenv",
      "url": "https://visualstudio.microsoft.com/",
      "category": "build tool"
    },
    "LLD": {
      "hide": "sys.platform == 'darwin'",
      "recommend": "sys.platform != 'darwin'",
      "message": "LLD is strongly encouraged on ELF platforms (Linux & BSD)",
      "file": "lld",
      "apt": "lld",
      "brew": "lld",
      "pkg": "lld",
      "url": "https://github.com/llvm/llvm-project/releases",
      "category": "LLVM linker"
    },
    "sccache": {
      "required": false,
      "file": "sccache",
      "apt": "sccache",
      "brew": "sccache",
      "pkg": "sccache",
      "url": "https://github.com/mozilla/sccache/releases",
      "category": "compiler cache"
    },
    "ccache": {
      "required": false,
      "file": "ccache",
      "apt": "ccache",
      "brew": "ccache",
      "pkg": "ccache",
      "url": "https://ccache.dev/download.html",
      "category": "compiler cache"
    },
    "clang": {
      "required": true,
      "file": "clang",
      "apt": "clang",
      "brew": "clang",
      "pkg": "clang",
      "url": "https://gcc.gnu.org/releases.html",
      "category": "compiler"
    },
    "gcc": {
      "required": true,
      "file": "gcc",
      "apt": "gcc",
      "brew": "gcc",
      "pkg": "gcc",
      "url": "https://gcc.gnu.org/releases.html",
      "category": "compiler"
    }
  }
}
