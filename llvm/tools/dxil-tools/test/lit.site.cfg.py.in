@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.dxil_include_dir = "@DXIL_TOOLS_SOURCE_DIR@/include"
config.dxil_test_exec_root = "@CMAKE_CURRENT_BINARY_DIR@"

import lit.llvm

