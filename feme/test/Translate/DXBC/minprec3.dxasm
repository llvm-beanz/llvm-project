// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK lines below are dxilconv's reference output for this shader,
// instruction for instruction.

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Note: shader requires additional functionality:
//       Minimum-precision data types
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   x           0     NONE  min16i   x   
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   x           0   TARGET     int   x   
//
ps_5_0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_input_ps constant v0.x {min16i}
dcl_output o0.x
dcl_temps 2
iadd r0.x {min16i}, v0.x {min16i}, l(2) {def32 as min16i}
ieq r1.x, r0.x {min16i}, l(7)
if_nz r1.x
  mov o0.x, l(4)
  ret 
else 
  mov o0.x, l(1)
  ret 
endif 
ret 
// Approximately 10 instruction slots used

// CHECK-LABEL: define void @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT: %0 = call i16 @dx.op.loadInput.i16(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %1 = add i16 %0, 2
// CHECK-NEXT: %2 = sext i16 %1 to i32
// CHECK-NEXT: %3 = icmp eq i32 %2, 7
// CHECK-NEXT: br i1 %3, label %if0.then, label %if0.else
// CHECK: if0.then:                                         ; preds = %entry
// CHECK-NEXT: call void @dx.op.storeOutput.i32(i32 5, i32 0, i32 0, i8 0, i32 4)
// CHECK-NEXT: ret void
// CHECK: if0.else:                                         ; preds = %entry
// CHECK-NEXT: call void @dx.op.storeOutput.i32(i32 5, i32 0, i32 0, i8 0, i32 1)
// CHECK-NEXT: ret void
