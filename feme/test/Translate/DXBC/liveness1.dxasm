ps_5_0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xyzw
dcl_input_ps constant v1.x
dcl_output o0.x
dcl_temps 1
dp2 r0.x, v0.yxyy, v0.zwzz
ieq r0.y, v1.x, l(1)
if_nz r0.y
  add r0.y, r0.x, l(44.000000)
else 
  add r0.y, v0.y, l(-77.000000)
endif 
mul o0.x, r0.x, r0.y
ret 
