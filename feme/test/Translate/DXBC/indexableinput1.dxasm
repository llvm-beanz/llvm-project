// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK-LABEL: define void @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT: %[[INDEX:[0-9]+]] = call i32 @dx.op.loadInput.i32(i32 4, i32 6, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %[[A2Y:[0-9]+]] = call float @dx.op.loadInput.f32(i32 4, i32 3, i32 0, i8 1, i32 undef)
// CHECK-NEXT: %[[ADJUSTED:[0-9]+]] = add i32 %[[INDEX]], 4
// CHECK-NEXT: %[[ROW:[0-9]+]] = sub i32 %[[ADJUSTED]], 4
// CHECK-NEXT: %[[C:[0-9]+]] = call float @dx.op.loadInput.f32(i32 4, i32 5, i32 %[[ROW]], i8 0, i32 undef)
// CHECK-NEXT: %[[SUM:[0-9]+]] = fadd fast float %[[A2Y]], %[[C]]
// CHECK-NEXT: %[[B:[0-9]+]] = call float @dx.op.loadInput.f32(i32 4, i32 1, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %[[RESULT:[0-9]+]] = fadd fast float %[[SUM]], %[[B]]
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 0, float %[[RESULT]])
// CHECK-NEXT: ret void
//
// CHECK-DAG: ![[CINDICES:[0-9]+]] = !{i32 0, i32 1, i32 2, i32 3}
// CHECK-DAG: !{{[0-9]+}} = !{i32 5, !"C", i8 9, i8 0, ![[CINDICES]], i8 2, i32 4, i8 2, i32 4, i8 0, null}
// CHECK-DAG: !{{[0-9]+}} = !{i32 6, !"D", i8 4, i8 0,

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xy          0     NONE   float       
// B                        0     zw        0     NONE   float     z 
// A                        1   xy          1     NONE   float       
// A                        2   xy          2     NONE   float    y  
// A                        3   xy          3     NONE   float       
// C                        0   xy          4     NONE   float   x   
// C                        1   xy          5     NONE   float   x   
// C                        2   xy          6     NONE   float   x   
// C                        3   xy          7     NONE   float   x   
// D                        0   x           8     NONE     int   x   
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_TARGET                0   x           0   TARGET   float   x   
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.z
dcl_input_ps linear v2.y
dcl_input_ps linear v4.x
dcl_input_ps linear v5.x
dcl_input_ps linear v6.x
dcl_input_ps linear v7.x
dcl_input_ps constant v8.x
dcl_output o0.x
dcl_temps 1
dcl_indexrange v4.x 4
mov r0.x, v8.x
add r0.x, v2.y, v[r0.x + 4].x
add o0.x, r0.x, v0.z
ret 
// Approximately 4 instruction slots used
