// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
//
// The DXBC -> DXIL translation does not cover this shader yet (see
// agent_thoughts.md); until it does, this checks that dxbc-as
// assembles the fxc disassembly and that the dxsa importer decodes
// the result. The reference DXIL is in the .ref file next to this one.
//
// CHECK: dxsa.module

//
// Generated by Microsoft (R) D3D Shader Disassembler
//
//
// Note: SHADER WILL ONLY WORK WITH THE DEBUG SDK LAYER ENABLED.
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// no Input
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   xyzw        0   TARGET    uint   xyzw
//
ps_5_0
dcl_temps 1
dcl_output o0.xyzw
dcl_input vCycleCounter.x
mov r0.xyzw, l(0)
mov r0.z, vCycleCounter.x
mov o0.xyzw, r0.xyzw
// Approximately 0 instruction slots used
