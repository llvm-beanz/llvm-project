//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   x           0     NONE    uint   x   
// B                        0    y          0     NONE    uint    y  
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   xyzw        0   TARGET   float   xyzw
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_uav_raw u3
dcl_input_ps constant v0.x
dcl_input_ps constant v0.y
dcl_output o0.xyzw
dcl_temps 2
ld_raw_indexable(raw_buffer)(mixed,mixed,mixed,mixed) r0.x, v0.x, u3.xxxx
utof r0.x, r0.x
ld_raw_s_indexable(raw_buffer)(mixed,mixed,mixed,mixed) null, r1.x, v0.x, u3.xxxx
check_access_fully_mapped r0.y, r1.x
utof r0.y, r0.y
mad r0.xyzw, r0.yyyy, l(2.000000, 2.000000, 2.000000, 2.000000), r0.xxxx
ftou r1.x, r0.w
mov o0.xyzw, r0.xyzw
store_raw u3.xyzw, v0.y, r1.xxxx
ret 
