// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
//
// The DXBC -> DXIL translation does not cover this shader yet (see
// agent_thoughts.md); until it does, this checks that dxbc-as
// assembles the fxc disassembly and that the dxsa importer decodes
// the result. The reference DXIL is in the .ref file next to this one.
//
// CHECK: dxsa.module

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Note: shader requires additional functionality:
//       Minimum-precision data types
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   x           0     NONE  min16f   x   
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   x           0   TARGET     int   x   
//
ps_5_0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_input_ps linear v0.x {min16f}
dcl_output o0.x
mov o0.x, v0.x {min16f as def32}
ret 
// Approximately 2 instruction slots used
