ps_5_0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.x
dcl_input_ps constant v1.xy
dcl_output o0.x
dcl_temps 1
switch v1.x
  case l(1)
  ieq r0.y, v1.y, l(11)
  if_nz r0.y
    mov r0.x, l(5.000000)
    break 
  endif 
  mov r0.x, l(5.500000)
  break 
  case l(2)
  ieq r0.y, v1.y, l(12)
  breakc_nz r0.y
  mov r0.x, v0.x
  break 
  default 
  mov r0.x, l(3.000000)
  break 
endswitch 
mov o0.x, r0.x
ret 
