  mov r0.w, l(0)
  loop 
    ige r2.x, r0.w, v1.y
    breakc_nz r2.x
    ieq r2.x, r1.z, l(16)
    if_nz r2.x
      mov r0.y, r1.w
      mov r1.zw, r0.xxxy
      break 
    endif 
    add r1.w, r1.w, v0.x
    iadd r0.w, r0.w, l(1)
  endloop 
  mov r1.xy, r1.zwzz
  iadd r0.z, r0.z, l(1)
endloop 
mov o0.x, r1.y
ret 
