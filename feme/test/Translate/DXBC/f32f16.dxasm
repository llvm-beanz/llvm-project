// B                        0   xyzw        1     NONE    uint   xyz 
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_TARGET                0   xyzw        0   TARGET   float   xyzw
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xyw
dcl_input_ps constant v1.xyz
dcl_output o0.xyzw
dcl_temps 2
f32tof16 r0.xyzw, v0.xxyw
utof r0.xyzw, r0.xyzw
f16tof32 r1.xyzw, v1.zyxx
add o0.xyzw, r0.xyzw, r1.xyzw
ret 
