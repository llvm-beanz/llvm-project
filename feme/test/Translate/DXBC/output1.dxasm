dcl_output o0.xyzw
dcl_output o5.xyzw
dcl_output oDepth
dcl_temps 2
utof r0.x, v1.x
add r0.xyzw, r0.xxxx, v0.xyzw
and r1.x, v1.y, l(0x3f800000)
add r0.xyzw, r0.xyzw, r1.xxxx
mov oDepth, r0.x
mov o0.xyzw, r0.xyzw
mov o5.xyzw, r0.xyzw
ret 
