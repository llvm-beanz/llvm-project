// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
//
// The DXBC -> DXIL translation does not cover this shader yet (see
// agent_thoughts.md); until it does, this checks that dxbc-as
// assembles the fxc disassembly and that the dxsa importer decodes
// the result. The reference DXIL is in the .ref file next to this one.
//
// CHECK: dxsa.module

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xyzw        0     NONE   float   xyzw
// B                        0   xyzw        1     NONE   float   xyzw
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   xyzw        0   TARGET   float   xyzw
// SV_Target                5   xyzw        5   TARGET   float   xyzw
// SV_DepthGreaterEqual     0    N/A oDepthGE  DEPTHGE   float    YES
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xyzw
dcl_input_ps linear v1.xyzw
dcl_output o0.xyzw
dcl_output o5.xyzw
dcl_output oDepthGE
dcl_temps 1
add r0.xyzw, v0.xyzw, v1.xyzw
mov oDepthGE, r0.x
mov o0.xyzw, r0.xyzw
mov o5.xyzw, r0.xyzw
ret 
// Approximately 5 instruction slots used
