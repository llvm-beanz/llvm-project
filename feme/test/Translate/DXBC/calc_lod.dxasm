// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK lines below are dxilconv's reference output for this shader,
// instruction for instruction.

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Resource Bindings:
//
// Name                                 Type  Format         Dim      HLSL Bind  Count
// ------------------------------ ---------- ------- ----------- -------------- ------
// samp1                             sampler      NA          NA             s0      1 
// tex1                              texture  float4          2d             t0      1 
// tex2                              texture  float4     2darray             t1      1 
// tex3                              texture  float4   cubearray             t2      1 
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xyzw        0     NONE   float   xyz 
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   xyzw        0   TARGET   float   xyzw
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_sampler s0, mode_default
dcl_resource_texture2d (float,float,float,float) t0
dcl_resource_texture2darray (float,float,float,float) t1
dcl_resource_texturecubearray (float,float,float,float) t2
dcl_input_ps linear v0.xyz
dcl_output o0.xyzw
dcl_temps 1
lod r0.x, v0.xyxx, t0.x, s0
lod r0.y, v0.xyxx, t1.x, s0
add r0.x, r0.y, r0.x
lod r0.y, v0.xyzx, t2.x, s0
add o0.xyzw, r0.yyyy, r0.xxxx
ret 
// Approximately 6 instruction slots used

// CHECK-LABEL: define void @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT: %0 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 0, i32 0, i1 false)
// CHECK-NEXT: %1 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 1, i32 1, i1 false)
// CHECK-NEXT: %2 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 2, i32 2, i1 false)
// CHECK-NEXT: %3 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 3, i32 0, i32 0, i1 false)
// CHECK-NEXT: %4 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %5 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 1, i32 undef)
// CHECK-NEXT: %6 = call float @dx.op.calculateLOD.f32(i32 81, %dx.types.Handle %0, %dx.types.Handle %3, float %4, float %5, float undef, i1 true)
// CHECK-NEXT: %7 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %8 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 1, i32 undef)
// CHECK-NEXT: %9 = call float @dx.op.calculateLOD.f32(i32 81, %dx.types.Handle %1, %dx.types.Handle %3, float %7, float %8, float undef, i1 true)
// CHECK-NEXT: %10 = fadd fast float %9, %6
// CHECK-NEXT: %11 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
