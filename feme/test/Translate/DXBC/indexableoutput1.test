;; Rewritten from a .ref-based test (see feme/docs/Design.md's "Building
;; complete legacy DXBC containers for testing") now that a full DXContainer
;; with real ISGN/OSGN bytes is available: this shader's output signature
;; indexes o2 and o7, and dxilconv's real OSGN carries eight elements (seven
;; arbitrary "F"s at registers 0-6, then SV_Position at register 7) that a
;; bare .dxasm fixture's dcl_output declarations alone cannot reconstruct --
;; they only declare the two registers this shader actually writes. Building
;; a full container (yaml2obj + dxbc-as + llvm-objcopy, as in
;; feme/test/Tools/dxbc-as/full-container.test) and feeding it to
;; --dxsa-to-llvmir via --dxbc-container lets the translator read the real
;; signature instead of synthesizing one, so the storeOutput calls below
;; name signature element 2 and 7 (dxilconv's real indices) rather than 0
;; and 1 (what synthesis from declarations alone would produce).

; RUN: split-file %s %t
; RUN: yaml2obj %t/container.yaml -o %t/skeleton.dxbc
; RUN: dxbc-as --emit=binary %t/shader.dxasm -o %t/shex.bin
; RUN: llvm-objcopy --add-section=SHEX=%t/shex.bin %t/skeleton.dxbc %t/full.dxbc
; RUN: dxbc-as %t/shader.dxasm | feme-translate --import-dxsa-bin - \
; RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t/full.dxbc - \
; RUN:   | FileCheck %s

;; CHECK lines were derived from dxilconv's reference output for this
;; shader; see agent_thoughts.md for the known differences.
; CHECK-LABEL: define void @main()
; CHECK-NEXT: entry:
; CHECK-NEXT: %0 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 2, i32 0, i8 0, float %0)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 2, i32 0, i8 1, float %0)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 2, i32 0, i8 2, float %0)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 2, i32 0, i8 3, float %0)
; CHECK-NEXT: %1 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 7, i32 0, i8 0, float %1)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 7, i32 0, i8 1, float %1)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 7, i32 0, i8 2, float %1)
; CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 7, i32 0, i8 3, float %1)
; CHECK-NEXT: ret void

;--- container.yaml
--- !dxcontainer
Header:
  Hash:            [ 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
                     0x0, 0x0, 0x0, 0x0, 0x0, 0x0 ]
  Version:
    Major:           1
    Minor:           0
  PartCount:       2
Parts:
  - Name:            ISGN
    Size:            61
    LegacySignature:
      Parameters:
        - Name:            A
          Index:           0
          SystemValue:     Undefined
          CompType:        Float32
          Register:        0
          Mask:            1
          ExclusiveMask:   0
        - Name:            B
          Index:           0
          SystemValue:     Undefined
          CompType:        UInt32
          Register:        1
          Mask:            1
          ExclusiveMask:   0
  - Name:            OSGN
    Size:            215
    LegacySignature:
      Parameters:
        - Name:            F
          Index:           0
          SystemValue:     Undefined
          CompType:        Float32
          Register:        0
          Mask:            15
          ExclusiveMask:   0
        - Name:            F
          Index:           1
          SystemValue:     Undefined
          CompType:        Float32
          Register:        1
          Mask:            15
          ExclusiveMask:   0
        - Name:            F
          Index:           2
          SystemValue:     Undefined
          CompType:        Float32
          Register:        2
          Mask:            15
          ExclusiveMask:   0
        - Name:            F
          Index:           3
          SystemValue:     Undefined
          CompType:        Float32
          Register:        3
          Mask:            15
          ExclusiveMask:   0
        - Name:            F
          Index:           4
          SystemValue:     Undefined
          CompType:        Float32
          Register:        4
          Mask:            15
          ExclusiveMask:   0
        - Name:            F
          Index:           5
          SystemValue:     Undefined
          CompType:        Float32
          Register:        5
          Mask:            15
          ExclusiveMask:   0
        - Name:            F
          Index:           6
          SystemValue:     Undefined
          CompType:        Float32
          Register:        6
          Mask:            15
          ExclusiveMask:   0
        - Name:            SV_Position
          Index:           0
          SystemValue:     Position
          CompType:        Float32
          Register:        7
          Mask:            15
          ExclusiveMask:   0
...

;--- shader.dxasm
//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   x           0     NONE   float   x
// B                        0   x           1     NONE    uint
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// F                        0   xyzw        0     NONE   float
// F                        1   xyzw        1     NONE   float
// F                        2   xyzw        2     NONE   float   xyzw
// F                        3   xyzw        3     NONE   float
// F                        4   xyzw        4     NONE   float
// F                        5   xyzw        5     NONE   float
// F                        6   xyzw        6     NONE   float
// SV_POSITION              0   xyzw        7      POS   float   xyzw
//
vs_5_0
dcl_globalFlags refactoringAllowed
dcl_input v0.x
dcl_output o2.xyzw
dcl_output_siv o7.xyzw, position
mov o2.xyzw, v0.xxxx
mov o7.xyzw, v0.xxxx
ret
// Approximately 3 instruction slots used
