// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK-LABEL: define void @main() {
// CHECK:       entry:
// CHECK:         %[[LIMIT:[0-9]+]] = call i32 @dx.op.loadInput.i32
// CHECK:         br label %loop0
// CHECK:       loop0:
// CHECK-DAG:     %[[INDEX:dx.v32.r2.0]] = phi i32
// CHECK-DAG:     %[[SUM:dx.v32.r1.0]] = phi float
// CHECK:         %[[BOUND:[0-9]+]] = call i32 @dx.op.loadInput.i32
// CHECK:         %[[DONE:[0-9]+]] = icmp sge i32 %[[INDEX]], %[[BOUND]]
// CHECK:         br i1 %[[DONE]], label %loop0.end, label %loop0.breakc0
// CHECK:       loop0.breakc0:
// CHECK:         %[[RETURN:[0-9]+]] = icmp eq i32 %[[LIMIT]], 5
// CHECK:         call void @dx.op.storeOutput.f32({{.*}}float %[[SUM]])
// CHECK:         br i1 %[[RETURN]], label %retc0, label %afterretc0
// CHECK:       retc0:
// CHECK-NEXT:    ret void
// CHECK:       afterretc0:
// CHECK:         %[[EARLY:[0-9]+]] = icmp eq i32 %[[LIMIT]], 7
// CHECK:         br i1 %[[EARLY]], label %if0.then, label %if0.end
// CHECK:       if0.then:
// CHECK:         call void @dx.op.storeOutput.f32({{.*}}float %[[SUM]])
// CHECK-NEXT:    ret void
// CHECK:       if0.end:
// CHECK:         %[[VALUE:[0-9]+]] = call float @dx.op.loadInput.f32
// CHECK:         %[[NEXT_SUM:[0-9]+]] = fadd fast float %[[SUM]], %[[VALUE]]
// CHECK:         %[[NEXT_INDEX:[0-9]+]] = add i32 %[[INDEX]], 1
// CHECK:         br label %loop0
// CHECK:       loop0.end:
// CHECK:         call void @dx.op.storeOutput.f32({{.*}}float %[[SUM]])
// CHECK-NEXT:    ret void
//
// CHECK: !dx.shaderModel = !{![[SM:[0-9]+]]}
// CHECK: ![[SM]] = !{!"ps", i32 6, i32 0}

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xy          0     NONE   float   x   
// B                        0   xyz         1     NONE     int   x z 
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   x           0   TARGET   float   x   
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.x
dcl_input_ps constant v1.xz
dcl_output o0.x
dcl_temps 1
mov r0.x, v1.z
mov r0.yz, l(0,0,0,0)
loop 
  ige r0.w, r0.z, v1.x
  breakc_nz r0.w
  ieq r0.w, r0.x, l(5)
  mov o0.x, r0.y
  retc_nz r0.w
  ieq r0.w, r0.x, l(7)
  if_nz r0.w
    mov o0.x, r0.y
    ret 
  endif 
  add r0.y, r0.y, v0.x
  iadd r0.z, r0.z, l(1)
endloop 
mov o0.x, r0.y
ret 
// Approximately 18 instruction slots used
