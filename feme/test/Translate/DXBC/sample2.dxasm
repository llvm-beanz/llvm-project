// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK lines below are dxilconv's reference output for this shader,
// instruction for instruction.

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Buffer Definitions: 
//
// cbuffer Foo
// {
//
//   float4 g0;                         // Offset:    0 Size:    16 [unused]
//   float4 g1;                         // Offset:   16 Size:    16 [unused]
//   float4 g2;                         // Offset:   32 Size:    16
//
// }
//
//
// Resource Bindings:
//
// Name                                 Type  Format         Dim      HLSL Bind  Count
// ------------------------------ ---------- ------- ----------- -------------- ------
// samp1                             sampler      NA          NA             s5      1 
// text1                             texture  float2          2d             t3      1 
// Foo                               cbuffer      NA          NA            cb0      1 
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xy          0     NONE   float   xy  
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   xy          0   TARGET   float   xy  
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_constantbuffer CB0[3], immediateIndexed
dcl_sampler s5, mode_default
dcl_resource_texture2d (float,float,float,float) t3
dcl_input_ps linear v0.xy
dcl_output o0.xy
dcl_temps 1
sample_indexable(texture2d)(float,float,float,float) r0.xy, v0.xyxx, t3.xyzw, s5
add o0.xy, r0.xyxx, cb0[2].xyxx
ret 
// Approximately 3 instruction slots used

// CHECK-LABEL: define void @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT: %0 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 0, i32 3, i1 false)
// CHECK-NEXT: %1 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 2, i32 0, i32 0, i1 false)
// CHECK-NEXT: %2 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 3, i32 0, i32 5, i1 false)
// CHECK-NEXT: %3 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %4 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 1, i32 undef)
// CHECK-NEXT: %5 = call %dx.types.ResRet.f32 @dx.op.sample.f32(i32 60, %dx.types.Handle %0, %dx.types.Handle %2, float %3, float %4, float undef, float undef, i32 0, i32 0, i32 undef, float 0.000000e+00)
// CHECK-NEXT: %6 = extractvalue %dx.types.ResRet.f32 %5, 0
// CHECK-NEXT: %7 = extractvalue %dx.types.ResRet.f32 %5, 1
// CHECK-NEXT: %8 = call %dx.types.CBufRet.f32 @dx.op.cbufferLoadLegacy.f32(i32 59, %dx.types.Handle %1, i32 2)
// CHECK-NEXT: %9 = extractvalue %dx.types.CBufRet.f32 %8, 0
// CHECK-NEXT: %10 = extractvalue %dx.types.CBufRet.f32 %8, 1
// CHECK-NEXT: %11 = fadd fast float %6, %9
// CHECK-NEXT: %12 = fadd fast float %7, %10
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 0, float %11)
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 1, float %12)
// CHECK-NEXT: ret void
