// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK lines below are dxilconv's reference output for this shader,
// instruction for instruction.

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Note: shader requires additional functionality:
//       Tiled resources
//
//
// Resource Bindings:
//
// Name                                 Type  Format         Dim      HLSL Bind  Count
// ------------------------------ ---------- ------- ----------- -------------- ------
// buf1                              texture  float4         buf             t3      1 
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   x           0     NONE     int   x   
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   xyzw        0   TARGET   float   xyzw
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_resource_buffer (float,float,float,float) t3
dcl_input_ps constant v0.x
dcl_output o0.xyzw
dcl_temps 3
ld_indexable(buffer)(float,float,float,float) r0.xyzw, v0.xxxx, t3.xyzw
ld_s_indexable(buffer)(float,float,float,float) r1.xyzw, r2.x, v0.xxxx, t3.xyzw
mad r0.xyzw, r0.xyzw, l(2.000000, 2.000000, 2.000000, 2.000000), r1.xyzw
check_access_fully_mapped r1.x, r2.x
utof r1.x, r1.x
add o0.xyzw, r0.xyzw, r1.xxxx
ret 
// Approximately 7 instruction slots used

