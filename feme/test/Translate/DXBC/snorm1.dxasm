// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK lines below are dxilconv's reference output for this shader,
// instruction for instruction.

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Resource Bindings:
//
// Name                                 Type  Format         Dim      HLSL Bind  Count
// ------------------------------ ---------- ------- ----------- -------------- ------
// samp1                             sampler      NA          NA             s5      1 
// text1                             texture  snorm4          2d             t3      1 
// text2                             texture  unorm3          2d             t7      1 
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xy          0     NONE   float   xy  
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Target                0   xyzw        0   TARGET   float   xyzw
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_sampler s5, mode_default
dcl_resource_texture2d (snorm,snorm,snorm,snorm) t3
dcl_resource_texture2d (unorm,unorm,unorm,unorm) t7
dcl_input_ps linear v0.xy
dcl_output o0.xyzw
dcl_temps 2
sample_indexable(texture2d)(snorm,snorm,snorm,snorm) r0.xyzw, v0.xyxx, t3.xyzw, s5
sample_indexable(texture2d)(unorm,unorm,unorm,unorm) r1.xyz, v0.xyxx, t7.xyzw, s5
add o0.xyzw, r0.xyzw, r1.zzyx
ret 
// Approximately 4 instruction slots used

// CHECK-LABEL: define void @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT: %0 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 0, i32 3, i1 false)
// CHECK-NEXT: %1 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 1, i32 7, i1 false)
// CHECK-NEXT: %2 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 3, i32 0, i32 5, i1 false)
// CHECK-NEXT: %3 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %4 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 1, i32 undef)
// CHECK-NEXT: %5 = call %dx.types.ResRet.f32 @dx.op.sample.f32(i32 60, %dx.types.Handle %0, %dx.types.Handle %2, float %3, float %4, float undef, float undef, i32 0, i32 0, i32 undef, float 0.000000e+00)
// CHECK-NEXT: %6 = extractvalue %dx.types.ResRet.f32 %5, 0
// CHECK-NEXT: %7 = extractvalue %dx.types.ResRet.f32 %5, 1
// CHECK-NEXT: %8 = extractvalue %dx.types.ResRet.f32 %5, 2
// CHECK-NEXT: %9 = extractvalue %dx.types.ResRet.f32 %5, 3
// CHECK-NEXT: %10 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %11 = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 0, i8 1, i32 undef)
// CHECK-NEXT: %12 = call %dx.types.ResRet.f32 @dx.op.sample.f32(i32 60, %dx.types.Handle %1, %dx.types.Handle %2, float %10, float %11, float undef, float undef, i32 0, i32 0, i32 undef, float 0.000000e+00)
// CHECK-NEXT: %13 = extractvalue %dx.types.ResRet.f32 %12, 0
// CHECK-NEXT: %14 = extractvalue %dx.types.ResRet.f32 %12, 1
// CHECK-NEXT: %15 = extractvalue %dx.types.ResRet.f32 %12, 2
// CHECK-NEXT: %16 = fadd fast float %6, %15
// CHECK-NEXT: %17 = fadd fast float %7, %15
// CHECK-NEXT: %18 = fadd fast float %8, %14
// CHECK-NEXT: %19 = fadd fast float %9, %13
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 0, float %16)
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 1, float %17)
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 2, float %18)
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 3, float %19)
