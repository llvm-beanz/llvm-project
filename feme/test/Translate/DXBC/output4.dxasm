// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK lines below are dxilconv's reference output for this shader,
// instruction for instruction.

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Note: shader requires additional functionality:
//       Minimum-precision data types
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xyzw        0     NONE   float   xyzw
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_Position              0   xyzw        0      POS   float   xyzw
// SV_CullDistance          0   x           1  CULLDST  min16f   x   
// SV_ClipDistance          0    yz         1  CLIPDST   float    yz 
// SV_CullDistance          1   xy          2  CULLDST  min16f   xy  
//
vs_5_0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_input v0.xyzw
dcl_output_siv o0.xyzw, position
dcl_output_siv o1.x {min16f}, cull_distance
dcl_output_siv o1.yz, clip_distance
dcl_output_siv o2.xy {min16f}, cull_distance
mov o0.xyzw, v0.xyzw
mov o1.x {min16f}, v0.x {def32 as min16f}
mov o1.yz, v0.xxwx
mov o2.xy {min16f}, v0.yzyy {def32 as min16f}
ret 
// Approximately 5 instruction slots used

