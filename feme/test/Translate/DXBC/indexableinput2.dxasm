// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK-LABEL: define void @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT: %[[SAMPLE:[0-9]+]] = call i32 @dx.op.sampleIndex.i32(i32 90)
// CHECK-NEXT: %[[AROW:[0-9]+]] = sub i32 %[[SAMPLE]], 0
// CHECK-NEXT: %[[A:[0-9]+]] = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 %[[AROW]], i8 0, i32 undef)
// CHECK-NEXT: %[[A2Y:[0-9]+]] = call float @dx.op.loadInput.f32(i32 4, i32 0, i32 2, i8 1, i32 undef)
// CHECK-NEXT: %[[ASUM:[0-9]+]] = fadd fast float %[[A]], %[[A2Y]]
// CHECK-NEXT: %[[INDEX:[0-9]+]] = call i32 @dx.op.loadInput.i32(i32 4, i32 3, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %[[ADJUSTED:[0-9]+]] = add i32 %[[INDEX]], 3
// CHECK-NEXT: %[[CROW:[0-9]+]] = sub i32 %[[ADJUSTED]], 3
// CHECK-NEXT: %[[C:[0-9]+]] = call float @dx.op.loadInput.f32(i32 4, i32 2, i32 %[[CROW]], i8 0, i32 undef)
// CHECK-NEXT: %[[RESULT:[0-9]+]] = fadd fast float %[[ASUM]], %[[C]]
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 0, float %[[RESULT]])
// CHECK-NEXT: ret void
//
// CHECK-DAG: ![[AINDEXES:[0-9]+]] = !{i32 0, i32 1, i32 2}
// CHECK-DAG: !{{[0-9]+}} = !{i32 0, !"A", i8 9, i8 0, ![[AINDEXES]], i8 2, i32 3, i8 2, i32 0, i8 0, null}
// CHECK-DAG: ![[CINDEXES:[0-9]+]] = !{i32 0, i32 1, i32 2, i32 3, i32 4, i32 5}
// CHECK-DAG: !{{[0-9]+}} = !{i32 2, !"C", i8 9, i8 0, ![[CINDEXES]], i8 2, i32 6, i8 2, i32 3, i8 0, null}
// CHECK-DAG: !{{[0-9]+}} = !{i32 3, !"D", i8 4, i8 0,
// CHECK-DAG: !{{[0-9]+}} = !{i32 4, !"SV_SampleIndex", i8 5, i8 12,

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   xy          0     NONE   float   x   
// B                        0     zw        0     NONE   float       
// A                        1   xy          1     NONE   float   x   
// A                        2   xy          2     NONE   float   xy  
// C                        0   xy          3     NONE   float   x   
// C                        1   xy          4     NONE   float   x   
// C                        2   xy          5     NONE   float   x   
// C                        3   xy          6     NONE   float   x   
// C                        4   xy          7     NONE   float   x   
// C                        5   xy          8     NONE   float   x   
// D                        0   x           9     NONE     int   x   
// SV_SampleIndex           0   x          10   SAMPLE    uint   x   
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_TARGET                0   x           0   TARGET   float   x   
//
// Pixel Shader runs at sample frequency
//
ps_5_0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xy
dcl_input_ps linear v1.xy
dcl_input_ps linear v2.xy
dcl_input_ps linear v3.x
dcl_input_ps linear v4.x
dcl_input_ps linear v5.x
dcl_input_ps linear v6.x
dcl_input_ps linear v7.x
dcl_input_ps linear v8.x
dcl_input_ps constant v9.x
dcl_input_ps_sgv constant v10.x, sampleIndex
dcl_output o0.x
dcl_temps 1
dcl_indexrange v0.xy 3
dcl_indexrange v3.x 6
mov r0.x, v10.x
add r0.x, v[r0.x + 0].x, v2.y
mov r0.y, v9.x
add o0.x, r0.x, v[r0.y + 3].x
ret 
// Approximately 5 instruction slots used
