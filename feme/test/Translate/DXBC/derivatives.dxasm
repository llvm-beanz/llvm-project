add r0.xyzw, r0.xyzw, r1.xyzw
deriv_rtx_fine r1.xyzw, v0.xyzw
add r0.xyzw, r0.xyzw, r1.xyzw
deriv_rty_fine r1.xyzw, v0.xyzw
add o0.xyzw, r0.xyzw, r1.xyzw
ret 
