    ieq r0.y, v1.z, l(31)
    mov r0.x, l(5.700000)
    breakc_nz r0.y
    mov r0.x, l(5.800000)
    break 
    default 
    mov r0.x, v0.y
    break 
  endswitch 
  break 
  case l(2)
  mov r0.x, v0.x
  break 
  default 
  mov r0.x, l(3.000000)
  break 
endswitch 
mov o0.x, r0.x
ret 
