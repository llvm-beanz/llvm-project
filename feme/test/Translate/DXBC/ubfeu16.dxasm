dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_constantbuffer CB0[1], immediateIndexed
dcl_output o0.x {min16u}
dcl_temps 1
ubfe r0.x {min16u}, l(27) {def32 as min16u}, l(5), cb0[0].x {min16u}
and r0.y {min16u}, cb0[0].x {min16u}, l(-4) {def32 as min16u}
xor r0.x {min16u}, r0.x {min16u}, r0.y {min16u}
iadd o0.x {min16u}, r0.x {min16u}, r0.y {min16u}
ret 
