// RUN: dxbc-as --emit=container %s -o %t.dxbc
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - \
// RUN:   | feme-translate --dxsa-to-llvmir --dxbc-container=%t.dxbc - \
// RUN:   | FileCheck %s
//
// CHECK lines below are dxilconv's reference output for this shader,
// instruction for instruction.

//
// Generated by Microsoft (R) HLSL Shader Compiler 10.1
//
//
// Resource Bindings:
//
// Name                                 Type  Format         Dim      ID      HLSL Bind  Count
// ------------------------------ ---------- ------- ----------- ------- -------------- ------
// SS                                sampler      NA          NA      S0             s2      3 
// tex                               texture  float4          1d      T0             t3      5 
//
//
//
// Input signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// A                        0   x           0     NONE     int   x   
// B                        0   x           1     NONE   float   x   
//
//
// Output signature:
//
// Name                 Index   Mask Register SysValue  Format   Used
// -------------------- ----- ------ -------- -------- ------- ------
// SV_TARGET                0   xyzw        0   TARGET   float   xyzw
//
ps_5_1
dcl_globalFlags refactoringAllowed
dcl_sampler S0[2:4], mode_default, space=0
dcl_resource_texture1d (float,float,float,float) T0[3:7], space=0
dcl_input_ps constant v0.x
dcl_input_ps linear v1.x
dcl_output o0.xyzw
dcl_temps 2
itof r0.x, v0.x
mov r0.y, v0.x
sample r1.xyzw, r0.xxxx, T0[r0.y + 3].xyzw { nonuniform }, S0[r0.y + 2] { nonuniform }
ftou r0.x, v1.x
add r0.z, v1.x, l(2.000000)
sample r0.xyzw, r0.zzzz, T0[r0.x + 3].xyzw { nonuniform }, S0[r0.y + 2]
add o0.xyzw, r0.xyzw, r1.xyzw
ret 
// Approximately 8 instruction slots used

// CHECK-LABEL: define void @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT: %0 = call i32 @dx.op.loadInput.i32(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %1 = sitofp i32 %0 to float
// CHECK-NEXT: %2 = call i32 @dx.op.loadInput.i32(i32 4, i32 0, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %3 = add i32 %2, 3
// CHECK-NEXT: %4 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 0, i32 %3, i1 true)
// CHECK-NEXT: %5 = add i32 %2, 2
// CHECK-NEXT: %6 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 3, i32 0, i32 %5, i1 true)
// CHECK-NEXT: %7 = call %dx.types.ResRet.f32 @dx.op.sample.f32(i32 60, %dx.types.Handle %4, %dx.types.Handle %6, float %1, float undef, float undef, float undef, i32 0, i32 undef, i32 undef, float 0.000000e+00)
// CHECK-NEXT: %8 = extractvalue %dx.types.ResRet.f32 %7, 0
// CHECK-NEXT: %9 = extractvalue %dx.types.ResRet.f32 %7, 1
// CHECK-NEXT: %10 = extractvalue %dx.types.ResRet.f32 %7, 2
// CHECK-NEXT: %11 = extractvalue %dx.types.ResRet.f32 %7, 3
// CHECK-NEXT: %12 = call float @dx.op.loadInput.f32(i32 4, i32 1, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %13 = fptoui float %12 to i32
// CHECK-NEXT: %14 = call float @dx.op.loadInput.f32(i32 4, i32 1, i32 0, i8 0, i32 undef)
// CHECK-NEXT: %15 = fadd fast float %14, 2.000000e+00
// CHECK-NEXT: %16 = add i32 %13, 3
// CHECK-NEXT: %17 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 0, i32 0, i32 %16, i1 true)
// CHECK-NEXT: %18 = add i32 %2, 2
// CHECK-NEXT: %19 = call %dx.types.Handle @dx.op.createHandle(i32 57, i8 3, i32 0, i32 %18, i1 false)
// CHECK-NEXT: %20 = call %dx.types.ResRet.f32 @dx.op.sample.f32(i32 60, %dx.types.Handle %17, %dx.types.Handle %19, float %15, float undef, float undef, float undef, i32 0, i32 undef, i32 undef, float 0.000000e+00)
// CHECK-NEXT: %21 = extractvalue %dx.types.ResRet.f32 %20, 0
// CHECK-NEXT: %22 = extractvalue %dx.types.ResRet.f32 %20, 1
// CHECK-NEXT: %23 = extractvalue %dx.types.ResRet.f32 %20, 2
// CHECK-NEXT: %24 = extractvalue %dx.types.ResRet.f32 %20, 3
// CHECK-NEXT: %25 = fadd fast float %21, %8
// CHECK-NEXT: %26 = fadd fast float %22, %9
// CHECK-NEXT: %27 = fadd fast float %23, %10
// CHECK-NEXT: %28 = fadd fast float %24, %11
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 0, float %25)
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 1, float %26)
// CHECK-NEXT: call void @dx.op.storeOutput.f32(i32 5, i32 0, i32 0, i8 2, float %27)
