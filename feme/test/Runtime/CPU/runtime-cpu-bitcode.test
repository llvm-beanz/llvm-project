; RUN: clang -c -emit-llvm -O2 -ffreestanding -fno-builtin \
; RUN:     %S/../../../runtime/CPU/FeMeRuntimeCPU.c -o %t.bc
; RUN: opt -passes=verify -disable-output %t.bc
; RUN: opt -S %t.bc -o - | FileCheck %s

; libFeMeRuntimeCPU's shader-side helper C source (see "Runtime Support
; Library" in feme/docs/FeMeCPUDesign.md) compiles cleanly and defines the
; canonical calls `feme::cpu::ResourceCalls` creates -- see
; feme/unittests/Runtime/CPU/RuntimeCPUTest.cpp for the gtests that
; JIT-execute these and check their actual bounds-checking/format-
; conversion behavior; this lit test only covers that the bitcode itself
; builds and exposes the expected external symbols.

; Each `asm`-labeled name below is quoted and prefixed with a literal
; `\01` (a `GlobalValue::dropLLVMManglingEscape` byte) on Mach-O targets,
; where Clang uses it to tell the backend to emit the label unprefixed
; rather than plain (see RuntimeCPUTest.cpp's `getRuntimeFunction`); allow
; either spelling here so this test passes on every target.
; CHECK-DAG: <4 x float> @{{"?}}{{(\\01)?}}feme.cpu.resource.load.typed.v4f32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.typed.v4f32{{"?}}(
; CHECK-DAG: i32 @{{"?}}{{(\\01)?}}feme.cpu.resource.load.raw.i32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.raw.i32{{"?}}(
; CHECK-DAG: float @{{"?}}{{(\\01)?}}feme.cpu.resource.load.raw.f32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.raw.f32{{"?}}(
; CHECK-DAG: <2 x float> @{{"?}}{{(\\01)?}}feme.cpu.resource.load.raw.v2f32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.raw.v2f32{{"?}}(
; CHECK-DAG: <3 x float> @{{"?}}{{(\\01)?}}feme.cpu.resource.load.raw.v3f32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.raw.v3f32{{"?}}(
; CHECK-DAG: <2 x i32> @{{"?}}{{(\\01)?}}feme.cpu.resource.load.raw.v2i32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.raw.v2i32{{"?}}(
; CHECK-DAG: <3 x i32> @{{"?}}{{(\\01)?}}feme.cpu.resource.load.raw.v3i32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.raw.v3i32{{"?}}(
; CHECK-DAG: <4 x i32> @{{"?}}{{(\\01)?}}feme.cpu.resource.load.raw.v4i32{{"?}}(
; CHECK-DAG: void @{{"?}}{{(\\01)?}}feme.cpu.resource.store.raw.v4i32{{"?}}(
