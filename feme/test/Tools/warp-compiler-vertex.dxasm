// REQUIRES: feme-warp-compiler
// RUN: dxbc-as %s -o %t.dxbc
// RUN: feme-warp-compiler-test %t.dxbc | FileCheck %s

vs_4_0
dcl_input v0.xyzw
dcl_output_siv o0.xyzw, position
mov o0.xyzw, v0.xyzw
ret

// CHECK: native stage=0 wave=4 artifact={{[1-9][0-9]*}}
// CHECK-NEXT: native stage=0 wave=4 artifact={{[1-9][0-9]*}}
// CHECK-NEXT: compiled and released twice
