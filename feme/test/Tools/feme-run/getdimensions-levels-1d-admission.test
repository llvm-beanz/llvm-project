# RUN: split-file %s %t
# RUN: not feme-run %t/writable.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/writable.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/writable.ll -o %t/writable.bc
# RUN: not feme --target=%feme_host_triple %t/writable.bc -o %t/writable.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/poison.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/poison.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/poison.ll -o %t/poison.bc
# RUN: not feme --target=%feme_host_triple %t/poison.bc -o %t/poison.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/array.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/array.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/array.ll -o %t/array.bc
# RUN: not feme --target=%feme_host_triple %t/array.bc -o %t/array.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/buffer.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/buffer.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/buffer.ll -o %t/buffer.bc
# RUN: not feme --target=%feme_host_triple %t/buffer.bc -o %t/buffer.o 2>&1 | FileCheck %s
# CHECK: unsupported raised operation: 'llvm.dx.resource.getdimensions.levels.x
# CHECK-SAME: requires heap-backed FP32/i32 1D/array or plain 2D mip-zero texture dimension queries
#--- writable.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 1, 0, 0, 1) @llvm.dx.resource.handlefromheap(i32 0)
  %d = call <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.Texture", float, 1, 0, 0, 1) %t, i32 0)
  call void @consume(<2 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 1, 0, 0, 1) @llvm.dx.resource.handlefromheap(i32)
declare <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.Texture", float, 1, 0, 0, 1), i32)
declare void @consume(<2 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- poison.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 1) @llvm.dx.resource.handlefromheap(i32 0)
  %d = call <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.Texture", float, 0, 0, 0, 1) %t, i32 poison)
  call void @consume(<2 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 1) @llvm.dx.resource.handlefromheap(i32)
declare <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.Texture", float, 0, 0, 0, 1), i32)
declare void @consume(<2 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- array.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 6) @llvm.dx.resource.handlefromheap(i32 0)
  %d = call <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.Texture", float, 0, 0, 0, 6) %t, i32 0)
  call void @consume(<2 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 6) @llvm.dx.resource.handlefromheap(i32)
declare <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.Texture", float, 0, 0, 0, 6), i32)
declare void @consume(<2 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- buffer.ll
define void @main() #0 {
  %t = call target("dx.TypedBuffer", float, 0, 0, 0) @llvm.dx.resource.handlefromheap(i32 0)
  %d = call <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.TypedBuffer", float, 0, 0, 0) %t, i32 0)
  call void @consume(<2 x i32> %d)
  ret void
}
declare target("dx.TypedBuffer", float, 0, 0, 0) @llvm.dx.resource.handlefromheap(i32)
declare <2 x i32> @llvm.dx.resource.getdimensions.levels.x(target("dx.TypedBuffer", float, 0, 0, 0), i32)
declare void @consume(<2 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
