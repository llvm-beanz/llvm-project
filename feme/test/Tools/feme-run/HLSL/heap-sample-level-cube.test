# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /Fo %t/shader.dxil %t/shader.hlsl
# RUN: feme-translate --import-dxil %t/shader.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=RAISE
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme-run --wave-size=8 --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme-run --reference --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/shader.dxil -o %t/shader.o
# RUN: feme-run --object --repeat=2 --heap=%t/heap.yaml %t/shader.o | FileCheck %s
# Two real mips, all six faces of both array elements, distinct components,
# negative/upper LOD, exact half-mip blends and sampler MinLod=MaxLod=1.
# Thirteen lanes, guards and repeats; native CPU execution, not owned D3D12.
# RAISE: call <4 x float> @llvm.dx.resource.samplelevel.v4f32.tdx.Texture_v4f32_0_0_1_5t
# RAISE-SAME: i32 {{(undef|poison|0)}})
# RAISE: call <4 x float> @llvm.dx.resource.samplelevel.v4f32.tdx.Texture_v4f32_0_0_1_9t
# RAISE-SAME: i32 {{(undef|poison|0)}})
# CHECK: heap[2]: 42 1065353216 1148862464 1157844992 1161940992 1112539136 1149468672 1157849088 1161945088 1120796672 1149886464 1157853184 1161949184 1082130432 1148911616 1157857280 1161953280 1113325568 1149493248 1157861376 1161957376 1121189888 1149911040 1157865472 1161961472 1065353216 1149026304 1157844992 1161981952 1112539136 1149550592 1157849088 1161986048 1120796672 1149968384 1157853184 1161990144 1082130432 1149075456 1157857280 1161994240 1113325568 1149575168 1157861376 1161998336 1121189888 1149992960 1157865472 1162002432 1065353216 1148862464 1157844992 1161940992 42
#--- shader.hlsl
static const float3 Directions[6] = {
  float3(1,0,0), float3(-1,0,0), float3(0,1,0),
  float3(0,-1,0), float3(0,0,1), float3(0,0,-1)
};
[RootSignature("RootFlags(CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED | SAMPLER_HEAP_DIRECTLY_INDEXED)")]
[numthreads(13, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
  TextureCube<float4> t = ResourceDescriptorHeap[0];
  TextureCubeArray<float4> a = ResourceDescriptorHeap[1];
  SamplerState s = SamplerDescriptorHeap[0];
  SamplerState limited = SamplerDescriptorHeap[1];
  RWByteAddressBuffer outBuffer = ResourceDescriptorHeap[2];
  float3 dir = Directions[tid.x % 6];
  float4 coord = float4(dir, (tid.x / 6) & 1);
  float lod = (tid.x % 3 == 0) ? -1.0 : (tid.x % 3 == 1) ? 0.5 : 2.0;
  float4 p = t.SampleLevel(s, dir, lod);
  float4 ap = a.SampleLevel(s, coord, lod);
  float4 c = t.SampleLevel(limited, dir, lod);
  float4 ca = a.SampleLevel(limited, coord, lod);
  outBuffer.Store(4 + tid.x * 16, asuint(p.r));
  outBuffer.Store(8 + tid.x * 16, asuint(ap.g));
  outBuffer.Store(12 + tid.x * 16, asuint(c.b));
  outBuffer.Store(16 + tid.x * 16, asuint(ca.a));
}
