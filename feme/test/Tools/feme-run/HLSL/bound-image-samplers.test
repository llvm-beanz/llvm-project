# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T cs_6_0 /E main /Fo %t/shader.dxil %t/shader.hlsl
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/bound.yaml %t/shader.dxil | FileCheck %s --check-prefix=JIT
# RUN: feme-run --reference --repeat=2 --heap=%t/bound.yaml %t/shader.dxil | FileCheck %s --check-prefix=JIT
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/shader.dxil -o %t/shader.o
# RUN: feme-run --object --repeat=2 --heap=%t/physical.yaml %t/shader.o | FileCheck %s --check-prefix=AOT
# JIT: binding[uav:0:0][0]: 42 1073741824 1069547520 1073741824 1069547520 42
# AOT: heap[0]: 42 1073741824 1069547520 1073741824 1069547520 42
# Native DXIL plus CPU execution, not owned D3D12 samplers. A bound texture and
# divergent sampler array share the same register number in separate classes.
# Nearest/linear filtering distinguish the samplers; legacy unqualified image
# input remains valid. Guarded output also covers the versioned AOT artifact.

#--- shader.hlsl
Texture2D<float> Texture : register(t3, space7);
SamplerState Samplers[2] : register(s3, space7);
RWByteAddressBuffer Out : register(u0);
[numthreads(4, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
  uint index = NonUniformResourceIndex(tid.x & 1);
  float value = Texture.SampleLevel(Samplers[index], float2(0.25, 0.5), 0);
  Out.Store(4 + tid.x * 4, asuint(value));
}

#--- bound.yaml
bindings:
  - space: 0
    register: 0
    register-class: uav
    entries:
      - index: 0
        size: 24
        data: [42, 0, 0, 0, 0, 42]
image-bindings:
  - space: 7
    register: 3
    entries:
      - index: 0
        dimension: 2d
        extent: [4, 1]
        format: r32_float
        data: [1065353216, 1073741824, 1086324736, 1090519040]
sampler-bindings:
  - space: 7
    register: 3
    entries:
      - index: 0
        min-filter: nearest
        mag-filter: nearest
      - index: 1
        min-filter: linear
        mag-filter: linear

#--- physical.yaml
resource-heap:
  - index: 0
    size: 24
    data: [42, 0, 0, 0, 0, 42]
images:
  - index: 0
    dimension: 2d
    extent: [4, 1]
    format: r32_float
    data: [1065353216, 1073741824, 1086324736, 1090519040]
samplers:
  - index: 0
    min-filter: nearest
    mag-filter: nearest
  - index: 1
    min-filter: linear
    mag-filter: linear
