# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /Fo %t/shader.dxil %t/shader.hlsl
# RUN: feme-translate --import-dxil %t/shader.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=RAISE
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme-run --wave-size=8 --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme-run --reference --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/shader.dxil -o %t/shader.o
# RUN: feme-run --object --repeat=2 --heap=%t/heap.yaml %t/shader.o | FileCheck %s
# All six faces, two cubes and three real mips, with scalar texels/results.
# Face-local tangent gradients on both screen axes select mips 0/1/2.
# Direction magnitudes 1/2, exact-bit shader half-mip floors 0.5/1.5 and
# sampler clamps at mip 1; thirteen lanes, guards and repeat 2, not owned D3D12.
# RAISE: call {{(float|<1 x float>)}} @llvm.dx.resource.samplegrad.clamp.
# RAISE-SAME: i32 {{(poison|undef|0)}}, float
# RAISE: call {{(float|<1 x float>)}} @llvm.dx.resource.samplegrad.clamp.
# RAISE-SAME: i32 {{(poison|undef|0)}}, float
# RAISE: call {{(float|<1 x float>)}} @llvm.dx.resource.samplegrad.
# RAISE-SAME: i32 {{(poison|undef|0)}})
# CHECK: heap[2]: 42 1065353216 1065353216 1120534528 1120534528 1120665600 1120665600 1120665600 1120665600 1128988672 1128988672 1120796672 1120796672 1113063424 1113063424 1120927744 1120927744 1125842944 1125842944 1121058816 1121058816 1086324736 1086324736 1121189888 1121189888 1120534528 1121845248 1120534528 1121845248 1128923136 1129578496 1120665600 1121976320 1112801280 1115422720 1120796672 1122107392 1125777408 1126432768 1120927744 1122238464 1084227584 1097859072 1121058816 1122369536 1121189888 1122500608 1121189888 1122500608 1128857600 1128857600 1120534528 1120534528 42
#--- shader.hlsl
static const float3 Directions[6] = {
  float3(1,0,0), float3(-1,0,0), float3(0,1,0),
  float3(0,-1,0), float3(0,0,1), float3(0,0,-1)
};
static const float3 GradU[6] = {
  float3(0,0,-1), float3(0,0,1), float3(1,0,0),
  float3(1,0,0), float3(1,0,0), float3(-1,0,0)
};
static const float3 GradV[6] = {
  float3(0,-1,0), float3(0,-1,0), float3(0,0,1),
  float3(0,0,-1), float3(0,-1,0), float3(0,-1,0)
};
[RootSignature("RootFlags(CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED | SAMPLER_HEAP_DIRECTLY_INDEXED)")]
[numthreads(13, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
  TextureCube<float> t = ResourceDescriptorHeap[0];
  TextureCubeArray<float> a = ResourceDescriptorHeap[1];
  SamplerState s = SamplerDescriptorHeap[0];
  SamplerState limited = SamplerDescriptorHeap[1];
  RWByteAddressBuffer outBuffer = ResourceDescriptorHeap[2];
  uint face = tid.x % 6;
  uint mode = tid.x % 5;
  float scale = (tid.x & 1) ? 2.0 : 1.0;
  float3 dir = Directions[face] * scale;
  float4 coord = float4(dir, (tid.x / 6) & 1);
  // GradU/GradV increase face-local U/V. Equal direction/gradient scaling
  // preserves the projected footprint despite changing the major-axis size.
  float3 dx = GradU[face] * scale * ((mode == 1) ? 0.0 : (mode == 2) ? 2.0 : 0.5);
  float3 dy = GradV[face] * scale * ((mode == 1) ? -1.0 : 0.0);
  float minLod = (mode == 3) ? 0.5 : (mode == 4) ? 1.5 : 0.0;
  float p = t.SampleGrad(s, dir, dx, dy, minLod);
  float ap = a.SampleGrad(s, coord, dx, dy, minLod);
  float c = t.SampleGrad(limited, dir, dx, dy);
  float ca = a.SampleGrad(limited, coord, dx, dy);
  outBuffer.Store(4 + tid.x * 16, asuint(p));
  outBuffer.Store(8 + tid.x * 16, asuint(ap));
  outBuffer.Store(12 + tid.x * 16, asuint(c));
  outBuffer.Store(16 + tid.x * 16, asuint(ca));
}
