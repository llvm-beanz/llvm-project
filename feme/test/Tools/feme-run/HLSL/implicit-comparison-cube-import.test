# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T ps_6_0 /E main /Fo %t/plain.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T ps_6_0 /E main /D CLAMP /Fo %t/clamp.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T ps_6_0 /E main /D ARRAY /Fo %t/array.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T ps_6_0 /E main /D ARRAY /D CLAMP /Fo %t/array-clamp.dxil %t/shader.hlsl
# RUN: feme-translate --import-dxil %t/plain.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefixes=CUBE,PLAIN
# RUN: feme-translate --import-dxil %t/clamp.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefixes=CUBE,CLAMP
# RUN: feme-translate --import-dxil %t/array.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefixes=ARRAY,PLAIN
# RUN: feme-translate --import-dxil %t/array-clamp.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefixes=ARRAY,CLAMP
# Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
# See https://llvm.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# Native import/raising only; bound/static descriptors remain unsupported.
# CUBE: call target("dx.Texture", <4 x float>, 0, 0, 1, 5)
# ARRAY: call target("dx.Texture", <4 x float>, 0, 0, 1, 9)
# PLAIN: call float @llvm.dx.resource.samplecmp.f32
# PLAIN-SAME: float 5.000000e-01, i32 poison)
# PLAIN-NOT: call %dx.types.ResRet.f32 @dx.op.sampleCmp
# CLAMP: call float @llvm.dx.resource.samplecmp.clamp.f32
# CLAMP-SAME: float 5.000000e-01, i32 poison, float
# CLAMP-NOT: call %dx.types.ResRet.f32 @dx.op.sampleCmp
#--- shader.hlsl
#ifdef ARRAY
TextureCubeArray<float> Input : register(t0);
#define COORD uv
#else
TextureCube<float> Input : register(t0);
#define COORD uv.xyz
#endif
SamplerComparisonState S : register(s0);
float main(float4 uv : TEXCOORD0) : SV_Target {
#ifdef CLAMP
  return Input.SampleCmp(S, COORD, 0.5, uv.x);
#else
  return Input.SampleCmp(S, COORD, 0.5);
#endif
}
