# RGB-DAG: {{(heap\[2\]|binding\[srv:0:1\]\[0\])}}: [[U]]{{$}}
# RGB-DAG: {{(heap\[4\]|binding\[srv:0:2\]\[0\])}}: [[F]]{{$}}
# RGB-DAG: {{(heap\[1\]|binding\[uav:0:0\]\[0\])}}: [[WS]]{{$}}
# RGB-DAG: {{(heap\[3\]|binding\[uav:0:1\]\[0\])}}: [[WU]]{{$}}
# RGB-DAG: {{(heap\[5\]|binding\[uav:0:2\]\[0\])}}: [[WF]]{{$}}
# RGB-NEXT: {{(heap\[6\]|binding\[uav:0:3\]\[0\])}}: [[OUT]]{{$}}
# RGB-NOT: {{(heap|binding)\[}}
#--- shader.hlsl
#ifndef HEAP
Buffer<int4> signedInput : register(t0);
Buffer<uint4> unsignedInput : register(t1);
Buffer<float4> floatInput : register(t2);
RWBuffer<int4> signedUAV : register(u0);
RWBuffer<uint4> unsignedUAV : register(u1);
RWBuffer<float4> floatUAV : register(u2);
RWByteAddressBuffer output : register(u3);
#else
[RootSignature("RootFlags(CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED)")]
#endif
[numthreads(5, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
#ifdef HEAP
  Buffer<int4> signedInput = ResourceDescriptorHeap[0];
  Buffer<uint4> unsignedInput = ResourceDescriptorHeap[2];
  Buffer<float4> floatInput = ResourceDescriptorHeap[4];
  RWBuffer<int4> signedUAV = ResourceDescriptorHeap[1];
  RWBuffer<uint4> unsignedUAV = ResourceDescriptorHeap[3];
  RWBuffer<float4> floatUAV = ResourceDescriptorHeap[5];
  RWByteAddressBuffer output = ResourceDescriptorHeap[6];
#endif
  uint i = tid.x;
  uint index = i + 1;
  uint base = 4 + i * 96;
  output.Store4(base, asuint(signedInput[index]));
  output.Store4(base + 16, unsignedInput[index]);
  output.Store4(base + 32, asuint(floatInput[index]));
  output.Store4(base + 48, asuint(signedUAV[index]));
  output.Store4(base + 64, unsignedUAV[index]);
  if (i != 2)
    output.Store4(base + 80, asuint(floatUAV[index]));
  if (i == 0) {
    output.Store4(484, asuint(signedInput[0xffffffffu]));
    output.Store4(500, unsignedInput[0xffffffffu]);
    output.Store4(516, asuint(floatInput[0xffffffffu]));
    output.Store4(532, asuint(signedUAV[0xffffffffu]));
    output.Store4(548, unsignedUAV[0xffffffffu]);
    output.Store4(564, asuint(floatUAV[0xffffffffu]));
  }
}
