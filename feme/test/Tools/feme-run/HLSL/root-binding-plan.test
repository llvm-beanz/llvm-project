# RUN: %dxil_dxc /nologo /WX /T cs_6_0 /E main /D LEGACY_ROOT=1 /force_rootsig_ver rootsig_1_0 /Fo %t.10.dxil %S/../Inputs/root-binding-plan.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_0 /E main /D LEGACY_ROOT=0 /force_rootsig_ver rootsig_1_1 /Fo %t.11.dxil %S/../Inputs/root-binding-plan.hlsl
# RUN: feme-run --inspect-root-signature %t.10.dxil | FileCheck %s --check-prefixes=V10,FLAGS0,COMMON
# RUN: feme-run --inspect-root-signature %t.11.dxil | FileCheck %s --check-prefixes=V11,FLAGS11,COMMON
# RUN: %dxil_dxc /dumpbin /extractrootsignature /Fo %t.root %t.11.dxil
# RUN: feme-run --inspect-root-signature %t.root | FileCheck %s --check-prefixes=V11,FLAGS11,COMMON
# RUN: not feme-run --inspect-root-signature --heap=does-not-exist %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS
# RUN: not feme-run --inspect-root-signature --reference %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS
# RUN: not feme-run --inspect-root-signature --object %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS
# RUN: not feme-run --inspect-root-signature --repeat=0 %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS
# RUN: not feme-run --inspect-root-signature --wave-size=4 %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS
# RUN: not feme-run --inspect-root-signature --groups=1,1,1 %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS
# RUN: not feme-run --inspect-root-signature --entry-point=main %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS
# RUN: not feme-run --inspect-root-signature -O2 %t.root 2>&1 | FileCheck %s --check-prefix=OPTIONS

