# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /Fo %t/float.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /D INTEGER /Fo %t/integer.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /D SIGNED /Fo %t/signed.dxil %t/shader.hlsl
# RUN: feme-translate --import-dxil %t/float.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=FLOAT
# RUN: feme-translate --import-dxil %t/integer.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=INTEGER
# RUN: feme-translate --import-dxil %t/signed.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=INTEGER
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/float.dxil -o %t/float.o
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/integer.dxil -o %t/integer.o
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/signed.dxil -o %t/signed.o
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/float.yaml %t/float.dxil | FileCheck %s --check-prefix=FLOAT-OUT
# RUN: feme-run --wave-size=8 --repeat=2 --heap=%t/float.yaml %t/float.dxil | FileCheck %s --check-prefix=FLOAT-OUT
# RUN: feme-run --reference --repeat=2 --heap=%t/float.yaml %t/float.dxil | FileCheck %s --check-prefix=FLOAT-OUT
# RUN: feme-run --object --repeat=2 --heap=%t/float.yaml %t/float.o | FileCheck %s --check-prefix=FLOAT-OUT
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/uint.yaml %t/integer.dxil | FileCheck %s --check-prefix=INT-OUT
# RUN: feme-run --wave-size=8 --repeat=2 --heap=%t/uint.yaml %t/integer.dxil | FileCheck %s --check-prefix=INT-OUT
# RUN: feme-run --reference --repeat=2 --heap=%t/uint.yaml %t/integer.dxil | FileCheck %s --check-prefix=INT-OUT
# RUN: feme-run --object --repeat=2 --heap=%t/uint.yaml %t/integer.o | FileCheck %s --check-prefix=INT-OUT
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/sint.yaml %t/signed.dxil | FileCheck %s --check-prefix=INT-OUT
# RUN: feme-run --wave-size=8 --repeat=2 --heap=%t/sint.yaml %t/signed.dxil | FileCheck %s --check-prefix=INT-OUT
# RUN: feme-run --reference --repeat=2 --heap=%t/sint.yaml %t/signed.dxil | FileCheck %s --check-prefix=INT-OUT
# RUN: feme-run --object --repeat=2 --heap=%t/sint.yaml %t/signed.o | FileCheck %s --check-prefix=INT-OUT
# Native import plus CPU execution, not owned D3D12 execution.
# FLOAT: call <4 x float> @llvm.dx.resource.load.ms
# FLOAT-SAME: <2 x i32> <i32 1, i32 -1>)
# FLOAT: call <4 x float> @llvm.dx.resource.load.ms
# FLOAT-SAME: <2 x i32> zeroinitializer)
# FLOAT: call <4 x float> @llvm.dx.resource.load.ms
# FLOAT-SAME: <2 x i32> zeroinitializer)
# FLOAT-NOT: call %dx.types.ResRet.f32 @dx.op.textureLoad
# INTEGER: call <4 x i32> @llvm.dx.resource.load.ms
# INTEGER-SAME: <2 x i32> <i32 1, i32 -1>)
# INTEGER: call <4 x i32> @llvm.dx.resource.load.ms
# INTEGER-SAME: <2 x i32> zeroinitializer)
# INTEGER: call <4 x i32> @llvm.dx.resource.load.ms
# INTEGER-SAME: <2 x i32> zeroinitializer)
# INTEGER-NOT: call %dx.types.ResRet.i32 @dx.op.textureLoad
# FLOAT-OUT: heap[2]: 42 0 0 0 1102577664 1149894656 1065353216 1104674816 1121452032 1148928000 1106771968 1149960192 0 1108082688 1122500608 0 0 0 0 0 0 0 42
# INT-OUT: heap[2]: 42 0 0 0 16777237 16778318 2147483649 16777241 16777322 2147484653 16777245 16778326 0 16777249 16777330 0 0 0 0 0 0 0 42
#--- shader.hlsl
#ifdef SIGNED
#define TEXEL int4
#elif defined(INTEGER)
#define TEXEL uint4
#else
#define TEXEL float4
#endif
[RootSignature("RootFlags(CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED)")]
[numthreads(7, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
  Texture2DMS<TEXEL, 4> t = ResourceDescriptorHeap[0];
  Texture2DMSArray<TEXEL, 4> a = ResourceDescriptorHeap[1];
  RWByteAddressBuffer outBuffer = ResourceDescriptorHeap[2];
  int sampleIndex = int(tid.x) - 1;
  TEXEL p = t.Load(int2(0, 1), sampleIndex, int2(1, -1));
  TEXEL q = a.Load(int3(0, 1, tid.x & 1), sampleIndex);
  TEXEL bounds = a.Load(int3(0, 0, int(tid.x % 4) - 1), sampleIndex);
  outBuffer.Store(4 + tid.x * 12, asuint(p.b));
  outBuffer.Store(8 + tid.x * 12, asuint(q.a));
  outBuffer.Store(12 + tid.x * 12, asuint(bounds.r));
}
