# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /Fo %t/shader.dxil %t/shader.hlsl
# RUN: feme-translate --import-dxil %t/shader.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=RAISE
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme-run --reference --repeat=2 --heap=%t/heap.yaml %t/shader.dxil | FileCheck %s
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/shader.dxil -o %t/shader.o
# RUN: feme-run --object --repeat=2 --heap=%t/heap.yaml %t/shader.o | FileCheck %s
# Native SDK import plus normal/reference/AOT execution, not owned D3D12.
# Multi-mip selection is covered by compiled-stage tests; YAML has one mip.
# RAISE: call <4 x float> @llvm.dx.resource.load.level
# RAISE-SAME: <3 x i32> <i32 1, i32 -1, i32 1>)
# RAISE: call <4 x float> @llvm.dx.resource.load.level
# RAISE-SAME: <3 x i32> <i32 -1, i32 1, i32 -1>)
# RAISE-NOT: call %dx.types.ResRet.f32 @dx.op.textureLoad
# CHECK: heap[1]: 42 17 0 20 0 21 0 24 0 0 10 0 0 0 14 0 0 0 0 0 0 42
#--- shader.hlsl
[RootSignature("RootFlags(CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED)")]
[numthreads(5, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
  Texture3D<float4> t = ResourceDescriptorHeap[0];
  RWByteAddressBuffer outBuffer = ResourceDescriptorHeap[1];
  int x = int(tid.x) - 1;
  float4 p = t.Load(int4(x, 1, 0, 0), int3(1, -1, 1));
  float4 n = t.Load(int4(x, 0, 1, 0), int3(-1, 1, -1));
  float4 invalid = t.Load(int4(0, 0, 0, (tid.x & 1) ? -1 : 1));
  outBuffer.Store(4 + tid.x * 16, (uint)p.r);
  outBuffer.Store(8 + tid.x * 16, (uint)n.g);
  outBuffer.Store(12 + tid.x * 16, (uint)p.a);
  outBuffer.Store(16 + tid.x * 16, (uint)invalid.r);
}
#--- heap.yaml
resource-heap:
  - index: 1
    size: 88
    data: [42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42]
images:
  - index: 0
    dimension: 3d
    extent: [2, 2, 2]
    format: r32g32b32a32_float
    data: [1065353216, 1073741824, 1077936128, 1082130432, 1084227584, 1086324736, 1088421888, 1090519040, 1091567616, 1092616192, 1093664768, 1094713344, 1095761920, 1096810496, 1097859072, 1098907648, 1099431936, 1099956224, 1100480512, 1101004800, 1101529088, 1102053376, 1102577664, 1103101952, 1103626240, 1104150528, 1104674816, 1105199104, 1105723392, 1106247680, 1106771968, 1107296256]
