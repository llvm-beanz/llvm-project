# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /Fo %t/ordinary.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /D COMPARE /D COMPARE_FILTER /Fo %t/comparison.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /D COMPARE_FILTER /Fo %t/ordinary-comparison.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /D COMPARE /Fo %t/comparison-ordinary.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /D COMPARE /D MAX_FILTER /Fo %t/comparison-maximum.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /D COMPARE /force_rootsig_ver rootsig_1_0 /Fo %t/comparison-ordinary-v10.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /D MAX_FILTER /Fo %t/ordinary-maximum.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_2 /E main /D MIN_FILTER /Fo %t/ordinary-minimum.dxil %t/shader.hlsl
# RUN: feme-run --inspect-root-signature %t/comparison.dxil | FileCheck %s --check-prefix=LAYOUT
# RUN: feme-translate --import-dxil %t/comparison.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=CMP-IR
# RUN: not feme-run --root-signature-constants %t/ordinary-comparison.dxil 2>&1 | FileCheck %s --check-prefix=DEFAULT
# RUN: not feme-run --root-signature-constants --reference %t/ordinary-comparison.dxil 2>&1 | FileCheck %s --check-prefix=DEFAULT
# RUN: not feme --root-signature-constants --target=%feme_host_triple %t/ordinary-comparison.dxil -o %t/rejected.o 2>&1 | FileCheck %s --check-prefix=DEFAULT
# RUN: not feme-run --root-signature-constants %t/comparison-ordinary.dxil 2>&1 | FileCheck %s --check-prefix=COMPARISON
# RUN: not feme-run --root-signature-constants --reference %t/comparison-ordinary.dxil 2>&1 | FileCheck %s --check-prefix=COMPARISON
# RUN: not feme --root-signature-constants --target=%feme_host_triple %t/comparison-ordinary.dxil -o %t/rejected.o 2>&1 | FileCheck %s --check-prefix=COMPARISON
# RUN: not feme-run --root-signature-constants %t/comparison-ordinary-v10.dxil 2>&1 | FileCheck %s --check-prefix=COMPARISON
# RUN: not feme-run --root-signature-constants --reference %t/comparison-ordinary-v10.dxil 2>&1 | FileCheck %s --check-prefix=COMPARISON
# RUN: not feme --root-signature-constants --target=%feme_host_triple %t/comparison-ordinary-v10.dxil -o %t/rejected.o 2>&1 | FileCheck %s --check-prefix=COMPARISON
# RUN: not feme-run --root-signature-constants %t/comparison-maximum.dxil 2>&1 | FileCheck %s --check-prefix=MAXIMUM
# RUN: not feme-run --root-signature-constants --reference %t/comparison-maximum.dxil 2>&1 | FileCheck %s --check-prefix=MAXIMUM
# RUN: not feme --root-signature-constants --target=%feme_host_triple %t/comparison-maximum.dxil -o %t/rejected.o 2>&1 | FileCheck %s --check-prefix=MAXIMUM
# RUN: not feme-run --root-signature-constants %t/comparison.dxil 2>&1 | FileCheck %s --check-prefix=STATIC
# RUN: not feme-run --root-signature-constants --reference %t/comparison.dxil 2>&1 | FileCheck %s --check-prefix=STATIC
# RUN: not feme --root-signature-constants --target=%feme_host_triple %t/comparison.dxil -o %t/rejected.o 2>&1 | FileCheck %s --check-prefix=STATIC
# RUN: not feme-run --root-signature-constants %t/ordinary.dxil 2>&1 | FileCheck %s --check-prefix=STATIC
# RUN: not feme-run --root-signature-constants --reference %t/ordinary.dxil 2>&1 | FileCheck %s --check-prefix=STATIC
# RUN: not feme --root-signature-constants --target=%feme_host_triple %t/ordinary.dxil -o %t/rejected.o 2>&1 | FileCheck %s --check-prefix=STATIC
# RUN: feme-run %t/ordinary-comparison.dxil
# RUN: feme-run --reference %t/ordinary-comparison.dxil
# RUN: feme --target=%feme_host_triple %t/ordinary-comparison.dxil -o %t/default.o
#
# DXC accepts mismatched states without /Vd. Legacy sampler handle raising
# now exposes their declared mode to real shader preflight. Valid comparison
# linkage now rejects missing static materialization explicitly, rather than
# treating a static sampler as a caller-provided descriptor. Default mode
# ignores the root signature and accepts normalized image/sampler bindings.
# This does not test materialization or execution of static sampler descriptors.
# LAYOUT: static-sampler[0]: space=7 register=3 visibility=0 filter=128
# DEFAULT: static sampler mismatch: sampler space=7 register=3 in 'main' declares mode=0 but filter=128 requires mode=1
# COMPARISON: static sampler mismatch: sampler space=7 register=3 in 'main' declares mode=1 but filter=0 requires mode=0
# MAXIMUM: static sampler mismatch: sampler space=7 register=3 in 'main' declares mode=1 but filter=384 requires mode=0
# CMP-IR: call float @llvm.dx.resource.samplecmplevelzero
# CMP-IR-SAME: float 5.000000e-01
# STATIC: static sampler materialization is unsupported: space=7 register=3
# STATIC-NOT: static sampler mismatch

#--- shader.hlsl
cbuffer Constants : register(b3, space7) { uint A; };
Texture2D<float> Input : register(t3, space7);
RWByteAddressBuffer Output : register(u3, space7);
#if defined(COMPARE)
SamplerComparisonState S : register(s3, space7);
#define SAMPLE Input.SampleCmpLevelZero(S, float2(0, 0), 0.5)
#else
SamplerState S : register(s3, space7);
#define SAMPLE Input.SampleLevel(S, float2(0, 0), 0)
#endif
#if defined(COMPARE_FILTER)
#define FILTER "FILTER_COMPARISON_MIN_MAG_MIP_POINT"
#elif defined(MAX_FILTER)
#define FILTER "FILTER_MAXIMUM_MIN_MAG_MIP_POINT"
#elif defined(MIN_FILTER)
#define FILTER "FILTER_MINIMUM_MIN_MAG_MIP_POINT"
#else
#define FILTER "FILTER_MIN_MAG_MIP_POINT"
#endif
[RootSignature("RootConstants(num32BitConstants=1,b3,space=7),"
               "DescriptorTable(SRV(t3,space=7)),UAV(u3,space=7),"
               "StaticSampler(s3,space=7,filter=" FILTER ")")]
[numthreads(1, 1, 1)]
void main() { Output.Store(0, asuint(SAMPLE + A)); }
