# REQUIRES: system-dxc-dxil
# RUN: split-file %s %t
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /Fo %t/sint.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /D UNSIGNED /Fo %t/uint.dxil %t/shader.hlsl
# RUN: feme-translate --import-dxil %t/sint.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=RAISE
# RUN: feme-translate --import-dxil %t/uint.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=RAISE
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/sint.yaml %t/sint.dxil | FileCheck %s
# RUN: feme-run --reference --repeat=2 --heap=%t/sint.yaml %t/sint.dxil | FileCheck %s
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/sint.dxil -o %t/sint.o
# RUN: feme-run --object --repeat=2 --heap=%t/sint.yaml %t/sint.o | FileCheck %s
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/uint.yaml %t/uint.dxil | FileCheck %s
# RUN: feme-run --reference --repeat=2 --heap=%t/uint.yaml %t/uint.dxil | FileCheck %s
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/uint.dxil -o %t/uint.o
# RUN: feme-run --object --repeat=2 --heap=%t/uint.yaml %t/uint.o | FileCheck %s
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /D MIPS /Fo %t/sint-mips.dxil %t/shader.hlsl
# RUN: %dxil_dxc /nologo /WX /T cs_6_6 /E main /D MIPS /D UNSIGNED /Fo %t/uint-mips.dxil %t/shader.hlsl
# RUN: feme-translate --import-dxil %t/sint-mips.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=RAISE
# RUN: feme-translate --import-dxil %t/uint-mips.dxil | feme-opt --llvm -passes=feme-dxil-raise-ops,verify -S | FileCheck %s --check-prefix=RAISE
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/sint-mips.yaml %t/sint-mips.dxil | FileCheck %s --check-prefix=MIPS
# RUN: feme-run --wave-size=8 --repeat=2 --heap=%t/sint-mips.yaml %t/sint-mips.dxil | FileCheck %s --check-prefix=MIPS
# RUN: feme-run --reference --repeat=2 --heap=%t/sint-mips.yaml %t/sint-mips.dxil | FileCheck %s --check-prefix=MIPS
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/sint-mips.dxil -o %t/sint-mips.o
# RUN: feme-run --object --repeat=2 --heap=%t/sint-mips.yaml %t/sint-mips.o | FileCheck %s --check-prefix=MIPS
# RUN: feme-run --wave-size=4 --repeat=2 --heap=%t/uint-mips.yaml %t/uint-mips.dxil | FileCheck %s --check-prefix=MIPS
# RUN: feme-run --wave-size=8 --repeat=2 --heap=%t/uint-mips.yaml %t/uint-mips.dxil | FileCheck %s --check-prefix=MIPS
# RUN: feme-run --reference --repeat=2 --heap=%t/uint-mips.yaml %t/uint-mips.dxil | FileCheck %s --check-prefix=MIPS
# RUN: feme --wave-size=4 --target=%feme_host_triple %t/uint-mips.dxil -o %t/uint-mips.o
# RUN: feme-run --object --repeat=2 --heap=%t/uint-mips.yaml %t/uint-mips.o | FileCheck %s --check-prefix=MIPS
# Native import plus CPU execution, not owned D3D12. MIPS distinguishes
# three rectangular levels and depth/XYZ bounds, preserving exact bits.
# RAISE: call <4 x i32> @llvm.dx.resource.load.level
# RAISE-SAME: <3 x i32> <i32 1, i32 -1, i32 1>)
# RAISE: call <4 x i32> @llvm.dx.resource.load.level
# RAISE-SAME: <3 x i32> <i32 -1, i32 1, i32 -1>)
# RAISE: call <4 x i32> @llvm.dx.resource.load.level
# RAISE-SAME: <3 x i32> zeroinitializer)
# RAISE-NOT: call %dx.types.ResRet.i32 @dx.op.textureLoad
# CHECK: heap[1]: 42 2147483664 0 2147483667 0 2147483668 0 2147483671 0 0 2147483657 0 0 0 2147483661 0 0 0 0 0 0 42
# MIPS: heap[1]: 42 0 0 0 0 2147483708 2147483649 2147483711 0 16777221 16777218 4294967291 0 16777225 16777226 4294967287 0 0 0 0 0 42
#--- shader.hlsl
#ifdef UNSIGNED
#define TEXEL uint4
#else
#define TEXEL int4
#endif
[RootSignature("RootFlags(CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED)")]
[numthreads(5, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
  Texture3D<TEXEL> t = ResourceDescriptorHeap[0];
  RWByteAddressBuffer outBuffer = ResourceDescriptorHeap[1];
  int x = int(tid.x) - 1;
  int mip = 0;
  int py = 1;
  int pz = 0;
  int nx = x;
  int ny = 0;
  int badX = 0;
  int badY = 0;
  int badZ = 0;
  int invalidMip = (tid.x & 1) ? -1 : 1;
#ifdef MIPS
  mip = int(tid.x) - 1;
  x = (mip == 0) ? 2 : (mip == 1) ? 0 : -1;
  py = (mip == 0) ? 2 : 1;
  pz = (mip == 0) ? 0 : -1;
  nx = 1;
  ny = -1;
  badX = (mip == 2) ? 1 : 0;
  badY = (mip == 1) ? 1 : 0;
  badZ = (mip == 0) ? 2 : 0;
  invalidMip = mip;
#endif
  TEXEL p = t.Load(int4(x, py, pz, mip), int3(1, -1, 1));
  TEXEL n = t.Load(int4(nx, ny, 1, mip), int3(-1, 1, -1));
  TEXEL invalid = t.Load(int4(badX, badY, badZ, invalidMip));
  outBuffer.Store(4 + tid.x * 16, asuint(p.r));
  outBuffer.Store(8 + tid.x * 16, asuint(n.g));
  outBuffer.Store(12 + tid.x * 16, asuint(p.a));
  outBuffer.Store(16 + tid.x * 16, asuint(invalid.r));
}
