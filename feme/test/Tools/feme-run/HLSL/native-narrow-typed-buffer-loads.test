#--- shader.hlsl
#ifdef TWO
typedef int2 IntElement;
typedef uint2 UIntElement;
typedef float2 FloatElement;
#define WRITE Store2
#define STEP 8
#else
typedef int IntElement;
typedef uint UIntElement;
typedef float FloatElement;
#define WRITE Store
#define STEP 4
#endif
#ifndef HEAP
Buffer<IntElement> signedInput : register(t0);
RWBuffer<IntElement> signedUAV : register(u0);
Buffer<UIntElement> unsignedInput : register(t1);
RWBuffer<UIntElement> unsignedUAV : register(u1);
Buffer<FloatElement> floatInput : register(t2);
RWBuffer<FloatElement> floatUAV : register(u2);
RWByteAddressBuffer output : register(u3);
#else
[RootSignature("RootFlags(CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED)")]
#endif
[numthreads(5, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
#ifdef HEAP
  Buffer<IntElement> signedInput = ResourceDescriptorHeap[0];
  RWBuffer<IntElement> signedUAV = ResourceDescriptorHeap[1];
  Buffer<UIntElement> unsignedInput = ResourceDescriptorHeap[2];
  RWBuffer<UIntElement> unsignedUAV = ResourceDescriptorHeap[3];
  Buffer<FloatElement> floatInput = ResourceDescriptorHeap[4];
  RWBuffer<FloatElement> floatUAV = ResourceDescriptorHeap[5];
  RWByteAddressBuffer output = ResourceDescriptorHeap[6];
#endif
  uint i = tid.x;
  uint index = i + 1;
  uint base = 4 + i * 6 * STEP;
  output.WRITE(base, asuint(signedInput[index]));
  if (i != 1)
    output.WRITE(base + STEP, asuint(signedUAV[index]));
  output.WRITE(base + 2 * STEP, unsignedInput[index]);
  output.WRITE(base + 3 * STEP, unsignedUAV[index]);
  output.WRITE(base + 4 * STEP, asuint(floatInput[index]));
  output.WRITE(base + 5 * STEP, asuint(floatUAV[index]));
  if (i == 0) {
    uint invalidBase = 4 + 5 * 6 * STEP;
    output.WRITE(invalidBase, asuint(signedInput[0xffffffffu]));
    output.WRITE(invalidBase + STEP, asuint(signedUAV[0xffffffffu]));
    output.WRITE(invalidBase + 2 * STEP, unsignedInput[0xffffffffu]);
    output.WRITE(invalidBase + 3 * STEP, unsignedUAV[0xffffffffu]);
    output.WRITE(invalidBase + 4 * STEP, asuint(floatInput[0xffffffffu]));
    output.WRITE(invalidBase + 5 * STEP, asuint(floatUAV[0xffffffffu]));
  }
}
#--- scalar.yaml
resource-heap:
  - index: 0
    size: 16
    kind: typed-buffer
    format: r32_sint
    data: [42, 2147483649, 4294967295, 2147483653]
