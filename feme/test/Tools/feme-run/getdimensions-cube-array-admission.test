# See https://llvm.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# RUN: split-file %s %t
# RUN: not feme-run %t/writable.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/writable.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/writable.ll -o %t/writable.bc
# RUN: not feme --target=%feme_host_triple %t/writable.bc -o %t/writable.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/poison.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/poison.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/poison.ll -o %t/poison.bc
# RUN: not feme --target=%feme_host_triple %t/poison.bc -o %t/poison.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/undef.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/undef.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/undef.ll -o %t/undef.bc
# RUN: not feme --target=%feme_host_triple %t/undef.bc -o %t/undef.o 2>&1 | FileCheck %s
# CHECK: requires heap-backed FP32/i32 1D/array or plain 2D mip-zero texture dimension queries
# CHECK-SAME: sampled cube-array dimensions
#--- writable.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 1, 0, 0, 9) @llvm.dx.resource.handlefromheap(i32 0)
  %d = call <4 x i32> @llvm.dx.resource.getdimensions.levels.xyz(target("dx.Texture", float, 1, 0, 0, 9) %t, i32 0)
  call void @consume(<4 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 1, 0, 0, 9) @llvm.dx.resource.handlefromheap(i32)
declare <4 x i32> @llvm.dx.resource.getdimensions.levels.xyz(target("dx.Texture", float, 1, 0, 0, 9), i32)
declare void @consume(<4 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- poison.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 9) @llvm.dx.resource.handlefromheap(i32 0)
  %d = call <4 x i32> @llvm.dx.resource.getdimensions.levels.xyz(target("dx.Texture", float, 0, 0, 0, 9) %t, i32 poison)
  call void @consume(<4 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 9) @llvm.dx.resource.handlefromheap(i32)
declare <4 x i32> @llvm.dx.resource.getdimensions.levels.xyz(target("dx.Texture", float, 0, 0, 0, 9), i32)
declare void @consume(<4 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- undef.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 9) @llvm.dx.resource.handlefromheap(i32 0)
  %d = call <4 x i32> @llvm.dx.resource.getdimensions.levels.xyz(target("dx.Texture", float, 0, 0, 0, 9) %t, i32 undef)
  call void @consume(<4 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 9) @llvm.dx.resource.handlefromheap(i32)
declare <4 x i32> @llvm.dx.resource.getdimensions.levels.xyz(target("dx.Texture", float, 0, 0, 0, 9), i32)
declare void @consume(<4 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
