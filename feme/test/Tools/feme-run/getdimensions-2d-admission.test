# RUN: split-file %s %t
# RUN: not feme-run %t/volume.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/volume.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/volume.ll -o %t/volume.bc
# RUN: not feme --target=%feme_host_triple %t/volume.bc -o %t/volume.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/nonheap.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/nonheap.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/nonheap.ll -o %t/nonheap.bc
# RUN: not feme --target=%feme_host_triple %t/nonheap.bc -o %t/nonheap.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/half.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/half.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/half.ll -o %t/half.bc
# RUN: not feme --target=%feme_host_triple %t/half.bc -o %t/half.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/writable-levels.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/writable-levels.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/writable-levels.ll -o %t/writable-levels.bc
# RUN: not feme --target=%feme_host_triple %t/writable-levels.bc -o %t/writable-levels.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/array-levels.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/array-levels.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/array-levels.ll -o %t/array-levels.bc
# RUN: not feme --target=%feme_host_triple %t/array-levels.bc -o %t/array-levels.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/poison-mip.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/poison-mip.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/poison-mip.ll -o %t/poison-mip.bc
# RUN: not feme --target=%feme_host_triple %t/poison-mip.bc -o %t/poison-mip.o 2>&1 | FileCheck %s
# RUN: not feme-run %t/writable-array-levels.ll 2>&1 | FileCheck %s
# RUN: not feme-run --reference %t/writable-array-levels.ll 2>&1 | FileCheck %s
# RUN: llvm-as %t/writable-array-levels.ll -o %t/writable-array-levels.bc
# RUN: not feme --target=%feme_host_triple %t/writable-array-levels.bc -o %t/writable-array-levels.o 2>&1 | FileCheck %s
# CHECK: requires heap-backed FP32/i32 1D/array or plain 2D mip-zero texture dimension queries
#--- volume.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 4) @llvm.dx.resource.handlefromheap.a(i32 0)
  %d = call <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.a(target("dx.Texture", float, 0, 0, 0, 4) %t, i32 0)
  call void @consume(<3 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 4) @llvm.dx.resource.handlefromheap.a(i32)
declare <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.a(target("dx.Texture", float, 0, 0, 0, 4), i32)
declare void @consume(<3 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- writable-levels.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 1, 0, 0, 2) @llvm.dx.resource.handlefromheap.u(i32 0)
  %d = call <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.u(target("dx.Texture", float, 1, 0, 0, 2) %t, i32 0)
  call void @consume(<3 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 1, 0, 0, 2) @llvm.dx.resource.handlefromheap.u(i32)
declare <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.u(target("dx.Texture", float, 1, 0, 0, 2), i32)
declare void @consume(<3 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- writable-array-levels.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 1, 0, 0, 6) @llvm.dx.resource.handlefromheap.u(i32 0)
  %d = call <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.u(target("dx.Texture", float, 1, 0, 0, 6) %t, i32 0)
  call void @consume(<3 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 1, 0, 0, 6) @llvm.dx.resource.handlefromheap.u(i32)
declare <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.u(target("dx.Texture", float, 1, 0, 0, 6), i32)
declare void @consume(<3 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- array-levels.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 7) @llvm.dx.resource.handlefromheap.a(i32 0)
  %d = call <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.a(target("dx.Texture", float, 0, 0, 0, 7) %t, i32 0)
  call void @consume(<3 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 7) @llvm.dx.resource.handlefromheap.a(i32)
declare <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.a(target("dx.Texture", float, 0, 0, 0, 7), i32)
declare void @consume(<3 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- poison-mip.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 2) @llvm.dx.resource.handlefromheap.s(i32 0)
  %d = call <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.s(target("dx.Texture", float, 0, 0, 0, 2) %t, i32 poison)
  call void @consume(<3 x i32> %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 2) @llvm.dx.resource.handlefromheap.s(i32)
declare <3 x i32> @llvm.dx.resource.getdimensions.levels.xy.s(target("dx.Texture", float, 0, 0, 0, 2), i32)
declare void @consume(<3 x i32>)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- nonheap.ll
define void @main() #0 {
  %t = call target("dx.Texture", float, 0, 0, 0, 2) @other_handle()
  %d = call i32 @llvm.dx.resource.getdimensions.x.s(target("dx.Texture", float, 0, 0, 0, 2) %t)
  call void @consume(i32 %d)
  ret void
}
declare target("dx.Texture", float, 0, 0, 0, 2) @other_handle()
declare i32 @llvm.dx.resource.getdimensions.x.s(target("dx.Texture", float, 0, 0, 0, 2))
declare void @consume(i32)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
#--- half.ll
define void @main() #0 {
  %t = call target("dx.Texture", half, 0, 0, 0, 2) @llvm.dx.resource.handlefromheap.h(i32 0)
  %d = call i32 @llvm.dx.resource.getdimensions.x.h(target("dx.Texture", half, 0, 0, 0, 2) %t)
  call void @consume(i32 %d)
  ret void
}
declare target("dx.Texture", half, 0, 0, 0, 2) @llvm.dx.resource.handlefromheap.h(i32)
declare i32 @llvm.dx.resource.getdimensions.x.h(target("dx.Texture", half, 0, 0, 0, 2))
declare void @consume(i32)
attributes #0 = { "hlsl.shader"="compute" "hlsl.numthreads"="5,1,1" }
