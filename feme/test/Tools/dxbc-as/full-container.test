;; Demonstrates assembling a complete legacy DXBC container (with real
;; ISGN/OSGN signature bytes, not the synthesized names the DXBC->DXIL
;; translation falls back to for a bare .dxasm fixture -- see
;; feme/docs/Design.md's "Building complete legacy DXBC containers for
;; testing") from three pieces of upstream LLVM tooling: yaml2obj builds the
;; container skeleton (with a structural `LegacySignature` for `ISGN`/`OSGN`,
;; see llvm/test/ObjectYAML/DXContainer/LegacySignatureParts.yaml), dxbc-as
;; assembles the bytecode part, and llvm-objcopy merges them. split-file
;; keeps the container YAML and the .dxasm it pairs with in one
;; self-contained file.

; RUN: split-file %s %t
; RUN: yaml2obj %t/container.yaml -o %t/skeleton.dxbc
; RUN: dxbc-as --emit=binary %t/shader.dxasm -o %t/shex.bin
; RUN: llvm-objcopy --add-section=SHEX=%t/shex.bin %t/skeleton.dxbc %t/full.dxbc
; RUN: obj2yaml %t/full.dxbc | FileCheck %s

; CHECK:      Parts:
; CHECK-NEXT:   - Name:            ISGN
; CHECK-NEXT:     Size:            36
; CHECK-NEXT:     LegacySignature:
; CHECK-NEXT:       Parameters:
; CHECK-NEXT:         - Name:            A
; CHECK-NEXT:           Index:           0
; CHECK-NEXT:           SystemValue:     Undefined
; CHECK-NEXT:           CompType:        Float32
; CHECK-NEXT:           Register:        0
; CHECK-NEXT:           Mask:            3
; CHECK-NEXT:           ExclusiveMask:   0
; CHECK-NEXT:   - Name:            OSGN
; CHECK-NEXT:     Size:            44
; CHECK-NEXT:     LegacySignature:
; CHECK-NEXT:       Parameters:
; CHECK-NEXT:         - Name:            SV_TARGET
; CHECK-NEXT:           Index:           0
; CHECK-NEXT:           SystemValue:     Target
; CHECK-NEXT:           CompType:        Float32
; CHECK-NEXT:           Register:        0
; CHECK-NEXT:           Mask:            15
; CHECK-NEXT:           ExclusiveMask:   0
; CHECK-NEXT:   - Name:            SHEX
; CHECK-NEXT:     Size:            12

;--- container.yaml
--- !dxcontainer
Header:
  Hash:            [ 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
                     0x0, 0x0, 0x0, 0x0, 0x0, 0x0 ]
  Version:
    Major:           1
    Minor:           0
  PartCount:       2
Parts:
  - Name:            ISGN
    Size:            36
    LegacySignature:
      Parameters:
        - Name:            A
          Index:           0
          SystemValue:     Undefined
          CompType:        Float32
          Register:        0
          Mask:            3
          ExclusiveMask:   0
  - Name:            OSGN
    Size:            44
    LegacySignature:
      Parameters:
        - Name:            SV_TARGET
          Index:           0
          SystemValue:     Target
          CompType:        Float32
          Register:        0
          Mask:            15
          ExclusiveMask:   0
...

;--- shader.dxasm
.shader_model pixel 5 0
ret
