; RUN: not dxbc-as %s 2>&1 | FileCheck %s

; dxbc-as must report a clean diagnostic for an unrecognized mnemonic, not
; crash, matching the "must not crash on untrusted input" principle in
; feme/docs/Design.md's Diagnostics section.

frobnicate r0.xyzw, r1.xyzw

; CHECK: error: {{.*}}unknown mnemonic 'frobnicate'
