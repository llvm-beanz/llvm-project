<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal vk.xml fixture for vk-gen-entrypoints-split-features.test.

     Reproduces the structure newer Vulkan-Headers releases use: each
     `VK_VERSION_1_x` feature requires no commands directly and instead
     `depends` on a chain of `VK_{BASE,COMPUTE,GRAPHICS}_VERSION_1_x`
     sub-features that do. It also covers alias resolution (`vkAliasCmd`)
     and a `<require depends="...">` block, which vk_gen_entrypoints.py must
     skip since it's conditioned on an optional extension, not the core
     version itself. It also declares `VK_KHR_dynamic_rendering`,
     `VK_EXT_extended_dynamic_state`, `VK_KHR_maintenance5`,
     `VK_KHR_line_rasterization`, `VK_KHR_dynamic_rendering_local_read`,
     `VK_KHR_map_memory2`, `VK_EXT_mesh_shader`, and
     `VK_KHR_push_descriptor`, the eight extensions `SUPPORTED_EXTENSIONS`
     lists, whose commands must be read out of `<extensions>` rather than
     out of any core feature. -->
<registry>
  <commands>
    <command>
      <proto><type>void</type><name>vkGlobalCmd</name></proto>
      <param><type>uint32_t</type><name>x</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkInstanceCmd</name></proto>
      <param><type>VkInstance</type><name>instance</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkDeviceCmd</name></proto>
      <param><type>VkDevice</type><name>device</name></param>
    </command>
    <command name="vkAliasCmd" alias="vkDeviceCmd"/>
    <command>
      <proto><type>void</type><name>vkCmdBeginRenderingKHR</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkCmdEndRenderingKHR</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkExtCmd</name></proto>
      <param><type>VkInstance</type><name>instance</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkCmdSetCullModeEXT</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkGetRenderingAreaGranularityKHR</name></proto>
      <param><type>VkDevice</type><name>device</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkCmdSetLineStippleKHR</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkCmdSetRenderingAttachmentLocationsKHR</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkCmdSetRenderingInputAttachmentIndicesKHR</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkMapMemory2KHR</name></proto>
      <param><type>VkDevice</type><name>device</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkUnmapMemory2KHR</name></proto>
      <param><type>VkDevice</type><name>device</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkCmdDrawMeshTasksEXT</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkCmdPushDescriptorSetKHR</name></proto>
      <param><type>VkCommandBuffer</type><name>commandBuffer</name></param>
    </command>
  </commands>
  <feature api="vulkan" name="VK_BASE_VERSION_1_0" number="1.0">
    <require>
      <command name="vkGlobalCmd"/>
      <command name="vkInstanceCmd"/>
    </require>
  </feature>
  <feature api="vulkan" name="VK_COMPUTE_VERSION_1_0" number="1.0"
            depends="VK_BASE_VERSION_1_0">
    <require>
      <command name="vkDeviceCmd"/>
    </require>
  </feature>
  <feature api="vulkan" name="VK_GRAPHICS_VERSION_1_0" number="1.0"
            depends="VK_COMPUTE_VERSION_1_0">
    <require>
      <command name="vkAliasCmd"/>
    </require>
    <require depends="VK_fake_extension">
      <command name="vkExtCmd"/>
    </require>
  </feature>
  <feature api="vulkan" name="VK_VERSION_1_0" number="1.0"
            depends="VK_GRAPHICS_VERSION_1_0">
  </feature>
  <feature api="vulkan" name="VK_VERSION_1_1" number="1.1"
            depends="VK_VERSION_1_0">
  </feature>
  <extensions>
    <extension name="VK_KHR_dynamic_rendering" number="45" type="device"
               supported="vulkan">
      <require>
        <command name="vkCmdBeginRenderingKHR"/>
        <command name="vkCmdEndRenderingKHR"/>
      </require>
    </extension>
    <extension name="VK_fake_extension" number="46" type="device"
               supported="vulkan">
      <require>
        <command name="vkExtCmd"/>
      </require>
    </extension>
    <extension name="VK_EXT_extended_dynamic_state" number="47" type="device"
               supported="vulkan">
      <require>
        <command name="vkCmdSetCullModeEXT"/>
      </require>
    </extension>
    <extension name="VK_KHR_maintenance5" number="470" type="device"
               supported="vulkan">
      <require>
        <command name="vkGetRenderingAreaGranularityKHR"/>
      </require>
    </extension>
    <extension name="VK_KHR_line_rasterization" number="535" type="device"
               supported="vulkan">
      <require>
        <command name="vkCmdSetLineStippleKHR"/>
      </require>
    </extension>
    <extension name="VK_KHR_dynamic_rendering_local_read" number="232"
               type="device" supported="vulkan">
      <require>
        <command name="vkCmdSetRenderingAttachmentLocationsKHR"/>
        <command name="vkCmdSetRenderingInputAttachmentIndicesKHR"/>
      </require>
    </extension>
    <extension name="VK_KHR_map_memory2" number="890" type="device"
               supported="vulkan">
      <require>
        <command name="vkMapMemory2KHR"/>
        <command name="vkUnmapMemory2KHR"/>
      </require>
    </extension>
    <extension name="VK_EXT_mesh_shader" number="250" type="device"
               supported="vulkan">
      <require>
        <command name="vkCmdDrawMeshTasksEXT"/>
      </require>
    </extension>
    <extension name="VK_KHR_push_descriptor" number="81" type="device"
               supported="vulkan">
      <require>
        <command name="vkCmdPushDescriptorSetKHR"/>
      </require>
    </extension>
  </extensions>
</registry>
