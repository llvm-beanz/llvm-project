<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal vk.xml fixture for vk-gen-entrypoints-split-features.test.

     Reproduces the structure newer Vulkan-Headers releases use: each
     `VK_VERSION_1_x` feature requires no commands directly and instead
     `depends` on a chain of `VK_{BASE,COMPUTE,GRAPHICS}_VERSION_1_x`
     sub-features that do. It also covers alias resolution (`vkAliasCmd`)
     and a `<require depends="...">` block, which vk_gen_entrypoints.py must
     skip since it's conditioned on an optional extension, not the core
     version itself. -->
<registry>
  <commands>
    <command>
      <proto><type>void</type><name>vkGlobalCmd</name></proto>
      <param><type>uint32_t</type><name>x</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkInstanceCmd</name></proto>
      <param><type>VkInstance</type><name>instance</name></param>
    </command>
    <command>
      <proto><type>void</type><name>vkDeviceCmd</name></proto>
      <param><type>VkDevice</type><name>device</name></param>
    </command>
    <command name="vkAliasCmd" alias="vkDeviceCmd"/>
    <command>
      <proto><type>void</type><name>vkExtCmd</name></proto>
      <param><type>VkInstance</type><name>instance</name></param>
    </command>
  </commands>
  <feature api="vulkan" name="VK_BASE_VERSION_1_0" number="1.0">
    <require>
      <command name="vkGlobalCmd"/>
      <command name="vkInstanceCmd"/>
    </require>
  </feature>
  <feature api="vulkan" name="VK_COMPUTE_VERSION_1_0" number="1.0"
            depends="VK_BASE_VERSION_1_0">
    <require>
      <command name="vkDeviceCmd"/>
    </require>
  </feature>
  <feature api="vulkan" name="VK_GRAPHICS_VERSION_1_0" number="1.0"
            depends="VK_COMPUTE_VERSION_1_0">
    <require>
      <command name="vkAliasCmd"/>
    </require>
    <require depends="VK_fake_extension">
      <command name="vkExtCmd"/>
    </require>
  </feature>
  <feature api="vulkan" name="VK_VERSION_1_0" number="1.0"
            depends="VK_GRAPHICS_VERSION_1_0">
  </feature>
  <feature api="vulkan" name="VK_VERSION_1_1" number="1.1"
            depends="VK_VERSION_1_0">
  </feature>
</registry>
