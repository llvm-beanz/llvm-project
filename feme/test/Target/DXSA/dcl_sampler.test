// RUN: feme-translate --import-dxsa-hex %s | FileCheck %s
// RUN: feme-translate --import-dxsa-hex %s | feme-opt --verify-roundtrip

// CHECK:      module {

// CHECK-NEXT:   dxsa.dcl_sampler <id = 0, mode = default>
0x0300005a, 0x00106000, 0x00000000

// CHECK-NEXT:   dxsa.dcl_sampler <id = 1, mode = comparison>
0x0300085a, 0x00106000, 0x00000001

// CHECK-NEXT:   dxsa.dcl_sampler <id = 2, mode = mono>
0x0300105a, 0x00106000, 0x00000002

// CHECK-NEXT:   dxsa.dcl_sampler <id = 0, mode = default, lbound = 0, ubound = 3, space = 1>
0x0600005a, 0x00306000, 0x00000000, 0x00000000, 0x00000003, 0x00000001

// CHECK-NEXT: }
