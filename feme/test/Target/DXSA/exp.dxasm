// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK:      dxsa.module {

// CHECK-NEXT:   dxsa.exp r<0>, r<1>
exp r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.exp r<0>, -r<1>
exp r0.xyzw, -r1.xyzw

// CHECK-NEXT:   dxsa.exp r<0>, |r<1>|
exp r0.xyzw, |r1.xyzw|

// CHECK-NEXT:   dxsa.exp r<0>, -|r<1>|
exp r0.xyzw, -|r1.xyzw|

// CHECK-NEXT:   dxsa.exp r<0, <x>>, r<1, <y, z, w, y>>
exp r0.x, r1.yzwy

// CHECK-NEXT:   dxsa.exp precise <x, y> r<0>, r<1>
exp precise(xy) r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.exp_sat r<0>, r<1>
exp_sat r0.xyzw, r1.xyzw
// CHECK-NEXT: }
