// RUN: feme-translate --import-dxsa-hex %s | FileCheck %s
// RUN: feme-translate --import-dxsa-hex %s | feme-opt --verify-roundtrip

// CHECK: dxsa.ld r<0>, r<0>, t<3, vector>

0x8900002d, 0x800000c2, 0x00155543, 0x001000f2,
0x00000000, 0x00100e46, 0x00000000, 0x00107e46,
0x00000003

// CHECK: dxsa.ld r<2>, r<1, <x, y, w, w>>, t<3, vector>, <u = -5, v = 7, w = 0>

0x8a00002d, 0x8000f601, 0x800000c2, 0x00155543,
0x001000f2, 0x00000002, 0x00100f46, 0x00000001,
0x00107e46, 0x00000003

// CHECK: dxsa.ld_s r<2>, r<1, <x, y, w, w>>, t<3, vector>, r<3, <x>>, <u = -5, v = 7, w = 0>

0x8c0000df, 0x8000f601, 0x800000c2, 0x00155543,
0x001000f2, 0x00000002, 0x00100012, 0x00000003,
0x00100f46, 0x00000001, 0x00107e46, 0x00000003

// CHECK: dxsa.ld_s r<1>, r<1>, t<3, vector>, r<4, <x>>

0x8b0000df, 0x800000c2, 0x00155543, 0x001000f2,
0x00000001, 0x00100012, 0x00000004, 0x00100e46,
0x00000001, 0x00107e46, 0x00000003
