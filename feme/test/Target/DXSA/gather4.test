// RUN: feme-translate --import-dxsa-hex %s | FileCheck %s
// RUN: feme-translate --import-dxsa-hex %s | feme-opt --verify-roundtrip

// CHECK: dxsa.gather4 r<0>, v<0, <x, y, x, x>>, t<0, vector>, s<0, vector, <x>>

0x8b00006d, 0x800000c2, 0x00155543, 0x001000f2,
0x00000000, 0x00101046, 0x00000000, 0x00107e46,
0x00000000, 0x0010600a, 0x00000000

// CHECK: dxsa.gather4 r<1>, v<0, <x, y, x, x>>, t<0, vector>, s<0, vector, <y>>, <u = -5, v = 7, w = 0>

0x8c00006d, 0x8000f601, 0x800000c2, 0x00155543,
0x001000f2, 0x00000001, 0x00101046, 0x00000000,
0x00107e46, 0x00000000, 0x0010601a, 0x00000000

// CHECK: dxsa.gather4_s r<1>, v<0, <x, y, x, x>>, t<0, vector>, s<0, vector, <w>>, r<2, <x>>, <u = -3, v = 2, w = 0>

0x8e0000db, 0x80005a01, 0x800000c2, 0x00155543,
0x001000f2, 0x00000001, 0x00100012, 0x00000002,
0x00101046, 0x00000000, 0x00107e46, 0x00000000,
0x0010603a, 0x00000000
