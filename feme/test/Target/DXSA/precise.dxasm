// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// The precise modifier is a per-output-component mask; it carries the
// `{x, y, z, w}` subset that must stay non-refactorable, and combines with
// the saturate variant (`add_sat`) independently.

// CHECK:      dxsa.module {
// CHECK-NEXT:   dxsa.add r<0>, r<1>, r<2>
// CHECK-NEXT:   dxsa.add precise <x, y, z, w> r<0>, r<1>, r<2>
// CHECK-NEXT:   dxsa.add precise <x, y> r<0>, r<1>, r<2>
// CHECK-NEXT:   dxsa.add_sat precise <x> r<0>, r<1>, r<2>

add r0.xyzw, r1.xyzw, r2.xyzw
add precise(xyzw) r0.xyzw, r1.xyzw, r2.xyzw
add precise(xy) r0.xyzw, r1.xyzw, r2.xyzw
add_sat precise(x) r0.xyzw, r1.xyzw, r2.xyzw

// A sampling instruction carries the mask too.
// CHECK-NEXT:   dxsa.sample precise <x, y, z, w> r<0>, v<0, <x, y, x, x>>, t<3, vector>, s<5>
sample precise(xyzw) resource_dim(texture2d) resource_return_type(float, float, float, float) r0.xyzw, v0.xyxx, t3.xyzw, s5

// CHECK-NEXT:   dxsa.gather4 precise <x, y> r<0>, v<0, <x, y, x, x>>, t<3, vector>, s<5, vector, <y>>
gather4 precise(xy) resource_dim(texture2d) resource_return_type(float, float, float, float) r0.xyzw, v0.xyxx, t3.xyzw, s5.y
// CHECK-NEXT: }
