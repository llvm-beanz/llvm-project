// RUN: feme-translate --import-dxsa-hex %s | FileCheck %s
// RUN: feme-translate --import-dxsa-hex %s | feme-opt --verify-roundtrip

// CHECK:      dxsa.module {

// CHECK-NEXT:   dxsa.dp3 r<0>, r<1>, r<2>
0x07000010, 0x001000f2, 0x00000000, 0x00100e46, 0x00000001, 0x00100e46, 0x00000002

// CHECK-NEXT:   dxsa.dp3_sat r<0>, r<1>, r<2>
0x07002010, 0x001000f2, 0x00000000, 0x00100e46, 0x00000001, 0x00100e46, 0x00000002

// CHECK-NEXT:   dxsa.dp3 r<0>, r<1>, l(0x3F800000, 0x40000000, 0x40400000, 0x40800000)
0x0a000010, 0x001000f2, 0x00000000, 0x00100e46, 0x00000001, 0x00004002, 0x3f800000, 0x40000000, 0x40400000, 0x40800000

// CHECK-NEXT:   dxsa.dp3_sat r<0>, r<1>, l(0x3F800000, 0x40000000, 0x40400000, 0x40800000)
0x0a002010, 0x001000f2, 0x00000000, 0x00100e46, 0x00000001, 0x00004002, 0x3f800000, 0x40000000, 0x40400000, 0x40800000

// CHECK-NEXT:   dxsa.dp3 r<0>, -r<1>, |r<2>|
0x09000010, 0x001000f2, 0x00000000, 0x80100e46, 0x00000041, 0x00000001, 0x80100e46, 0x00000081, 0x00000002

// CHECK-NEXT:   dxsa.dp3_sat r<0>, -r<1>, |r<2>|
0x09002010, 0x001000f2, 0x00000000, 0x80100e46, 0x00000041, 0x00000001, 0x80100e46, 0x00000081, 0x00000002

// CHECK-NEXT:   dxsa.dp3 r<0, <x>>, r<1, <y, z, w, y>>, r<2, <x, x, x, x>>
0x07000010, 0x00100012, 0x00000000, 0x00100796, 0x00000001, 0x00100006, 0x00000002

// CHECK-NEXT:   dxsa.dp3_sat r<0, <x>>, r<1, <y, z, w, y>>, r<2, <x, x, x, x>>
0x07002010, 0x00100012, 0x00000000, 0x00100796, 0x00000001, 0x00100006, 0x00000002

// CHECK-NEXT: }
