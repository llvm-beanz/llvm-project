// CHECK-NEXT:   dxsa.deriv_rty_fine precise <x> r<0, <x>>, v<1, <y, z, w, y>>
deriv_rty_fine precise(x) r0.x, v1.yzwy

// CHECK-NEXT:   dxsa.deriv_rty_fine_sat r<0>, v<1>
deriv_rty_fine_sat r0.xyzw, v1.xyzw

// CHECK-NEXT:   dxsa.deriv_rty_fine_sat r<0>, -v<1>
deriv_rty_fine_sat r0.xyzw, -v1.xyzw

// CHECK-NEXT:   dxsa.deriv_rty_fine_sat r<0>, |v<1>|
