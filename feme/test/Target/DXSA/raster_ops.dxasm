// CHECK-NEXT:   dxsa.deriv_rty_fine r<0>, -v<1>
deriv_rty_fine r0.xyzw, -v1.xyzw

// CHECK-NEXT:   dxsa.deriv_rty_fine r<0>, |v<1>|
deriv_rty_fine r0.xyzw, |v1.xyzw|

// CHECK-NEXT:   dxsa.deriv_rty_fine r<0, <x>>, v<1, <y, z, w, y>>
