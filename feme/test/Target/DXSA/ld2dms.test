// RUN: feme-translate --import-dxsa-hex %s | FileCheck %s
// RUN: feme-translate --import-dxsa-hex %s | feme-opt --verify-roundtrip

// CHECK: dxsa.ld2dms r<0, <x, y, z>>, r<0>, t<3, vector>, l(0x0)

0x8b00002e, 0x80000102, 0x00155543, 0x00100072,
0x00000000, 0x00100e46, 0x00000000, 0x00107e46,
0x00000003, 0x00004001, 0x00000000

// CHECK: dxsa.ld2dms r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>

0x8b00002e, 0x80000102, 0x00155543, 0x00100072,
0x00000002, 0x00100f46, 0x00000001, 0x00107e46,
0x00000003, 0x0010102a, 0x00000000

// CHECK: dxsa.ld2dms r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, <u = -5, v = 7, w = 0>

0x8c00002e, 0x8000f601, 0x80000102, 0x00155543,
0x00100072, 0x00000002, 0x00100f46, 0x00000001,
0x00107e46, 0x00000003, 0x0010102a, 0x00000000

// CHECK: dxsa.ld2dms_s r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, r<3, <x>>, <u = -5, v = 7, w = 0>

0x8e0000e0, 0x8000f601, 0x80000102, 0x00155543,
0x00100072, 0x00000002, 0x00100012, 0x00000003,
0x00100f46, 0x00000001, 0x00107e46, 0x00000003,
0x0010102a, 0x00000000

// CHECK: dxsa.ld2dms_s r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, r<3, <x>>

0x8d0000e0, 0x80000102, 0x00155543, 0x00100072,
0x00000002, 0x00100012, 0x00000003, 0x00100f46,
0x00000001, 0x00107e46, 0x00000003, 0x0010102a,
0x00000000

// CHECK: dxsa.ld2dms r<1, <x, y, z>>, r<1>, t<3, vector>, l(0xD)

0x8b00002e, 0x80000102, 0x00155543, 0x00100072,
0x00000001, 0x00100e46, 0x00000001, 0x00107e46,
0x00000003, 0x00004001, 0x0000000d
