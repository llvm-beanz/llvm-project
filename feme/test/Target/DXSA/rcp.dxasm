// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK:      dxsa.module {

// CHECK-NEXT:   dxsa.rcp r<0>, r<1>
rcp r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.rcp r<0>, -r<1>
rcp r0.xyzw, -r1.xyzw

// CHECK-NEXT:   dxsa.rcp r<0>, |r<1>|
rcp r0.xyzw, |r1.xyzw|

// CHECK-NEXT:   dxsa.rcp r<0>, -|r<1>|
rcp r0.xyzw, -|r1.xyzw|

// CHECK-NEXT:   dxsa.rcp r<0, <x>>, r<1, <y, z, w, y>>
rcp r0.x, r1.yzwy

// CHECK-NEXT:   dxsa.rcp precise <x, y> r<0>, r<1>
rcp precise(xy) r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.rcp_sat r<0>, r<1>
rcp_sat r0.xyzw, r1.xyzw
// CHECK-NEXT: }
