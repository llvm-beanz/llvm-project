// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK: dxsa.sample_b r<0>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y>>

sample_b resource_dim(texture2d) resource_return_type(float, float, float, float) r0.xyzw, v0.xyxx, t3.xyzw, s5, v0.y
// CHECK: dxsa.sample_b_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y>>, <l(0x3F000000), null>, <u = -4, v = 1, w = 0>

sample_b_cl_s aoffimmi(-4, 1, 0) resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, null, v0.xyxx, t3.xyzw, s5, v0.y, l(0x3F000000)
