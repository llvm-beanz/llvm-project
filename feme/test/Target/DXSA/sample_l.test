// RUN: feme-translate --import-dxsa-hex %s | FileCheck %s
// RUN: feme-translate --import-dxsa-hex %s | feme-opt --verify-roundtrip

// CHECK: dxsa.sample_l r<0>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y>>

0x8d000048, 0x800000c2, 0x00155543, 0x001000f2,
0x00000000, 0x00101046, 0x00000000, 0x00107e46,
0x00000003, 0x00106000, 0x00000005, 0x0010101a,
0x00000000

// CHECK: dxsa.sample_l r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y>>, <u = -5, v = 7, w = 0>

0x8e000048, 0x8000f601, 0x800000c2, 0x00155543,
0x001000f2, 0x00000001, 0x00101046, 0x00000000,
0x00107e46, 0x00000003, 0x00106000, 0x00000005,
0x0010101a, 0x00000000

// CHECK: dxsa.sample_l_cl_s r<1>, v<0>, t<5, vector>, s<5>, v<0, <y>>, r<2, <x>>

0x8f0000e4, 0x80000282, 0x00155543, 0x001000f2,
0x00000001, 0x00100012, 0x00000002, 0x00101e46,
0x00000000, 0x00107e46, 0x00000005, 0x00106000,
0x00000005, 0x0010101a, 0x00000000

// CHECK: dxsa.sample_l_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y>>, r<2, <x>>, <u = -3, v = 2, w = 0>

