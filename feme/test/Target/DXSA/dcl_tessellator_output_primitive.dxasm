// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK:      dxsa.module {
// CHECK-NEXT:   dxsa.dcl_tessellator_output_primitive output_point
// CHECK-NEXT:   dxsa.dcl_tessellator_output_primitive output_line
// CHECK-NEXT:   dxsa.dcl_tessellator_output_primitive output_triangle_cw
// CHECK-NEXT:   dxsa.dcl_tessellator_output_primitive output_triangle_ccw

dcl_tessellator_output_primitive output_point
dcl_tessellator_output_primitive output_line
dcl_tessellator_output_primitive output_triangle_cw
dcl_tessellator_output_primitive output_triangle_ccw
// CHECK-NEXT: }
