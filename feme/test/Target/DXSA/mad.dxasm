// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK:      dxsa.module {

// CHECK-NEXT:   dxsa.mad r<0>, r<1>, r<2>, r<3>
mad r0.xyzw, r1.xyzw, r2.xyzw, r3.xyzw

// CHECK-NEXT:   dxsa.mad_sat r<0>, r<1>, r<2>, r<3>
mad_sat r0.xyzw, r1.xyzw, r2.xyzw, r3.xyzw

// CHECK-NEXT:   dxsa.mad precise <x, y, z, w> r<0>, r<1>, r<2>, r<3>
mad precise(xyzw) r0.xyzw, r1.xyzw, r2.xyzw, r3.xyzw

// CHECK-NEXT:   dxsa.mad_sat precise <x, y> r<0>, r<1>, r<2>, r<3>
mad_sat precise(xy) r0.xyzw, r1.xyzw, r2.xyzw, r3.xyzw

// CHECK-NEXT:   dxsa.mad r<0>, r<1>, r<2>, l(0x3F800000, 0x40000000, 0x40400000, 0x40800000)
mad r0.xyzw, r1.xyzw, r2.xyzw, l(0x3F800000, 0x40000000, 0x40400000, 0x40800000)

// CHECK-NEXT:   dxsa.mad r<0>, -r<1>, |r<2>|, r<3>
mad r0.xyzw, -r1.xyzw, |r2.xyzw|, r3.xyzw

// CHECK-NEXT:   dxsa.mad_sat r<0>, -r<1>, |r<2>|, r<3>
mad_sat r0.xyzw, -r1.xyzw, |r2.xyzw|, r3.xyzw

// CHECK-NEXT:   dxsa.mad r<0, <x>>, r<1, <y, z, w, y>>, r<2, <x, x, x, x>>, r<3>
mad r0.x, r1.yzwy, r2.xxxx, r3.xyzw
// CHECK-NEXT: }
