// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK:      dxsa.module {

// CHECK-NEXT:   dxsa.log r<0>, r<1>
log r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.log r<0>, -r<1>
log r0.xyzw, -r1.xyzw

// CHECK-NEXT:   dxsa.log r<0>, |r<1>|
log r0.xyzw, |r1.xyzw|

// CHECK-NEXT:   dxsa.log r<0>, -|r<1>|
log r0.xyzw, -|r1.xyzw|

// CHECK-NEXT:   dxsa.log r<0, <x>>, r<1, <y, z, w, y>>
log r0.x, r1.yzwy

// CHECK-NEXT:   dxsa.log precise <x, y> r<0>, r<1>
log precise(xy) r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.log_sat r<0>, r<1>
log_sat r0.xyzw, r1.xyzw
// CHECK-NEXT: }
