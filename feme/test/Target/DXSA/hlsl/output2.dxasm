// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0>
// CHECK:         dxsa.dcl_input_ps  linear v<1>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_output o<5>
// CHECK:         dxsa.dcl_output oDepthGE
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.add r<0>, v<0>, v<1>
// CHECK:         dxsa.mov oDepthGE, r<0, <x>>
// CHECK:         dxsa.mov o<0>, r<0>
// CHECK:         dxsa.mov o<5>, r<0>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xyzw
dcl_input_ps linear v1.xyzw
dcl_output o0.xyzw
dcl_output o5.xyzw
dcl_output oDepthGE
dcl_temps 1
add r0.xyzw, v0.xyzw, v1.xyzw
mov oDepthGE, r0.x
mov o0.xyzw, r0.xyzw
mov o5.xyzw, r0.xyzw
ret
