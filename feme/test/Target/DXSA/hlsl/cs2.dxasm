// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 1>, <immediateIndexed>
// CHECK:         dxsa.dcl_uav_raw <id = 0>
// CHECK:         dxsa.dcl_input vThreadIDInGroupFlattened<none>
// CHECK:         dxsa.dcl_input vThreadGroupID<<y>>
// CHECK:         dxsa.dcl_input vThreadIDInGroup<<z>>
// CHECK:         dxsa.dcl_input vThreadID<<x>>
// CHECK:         dxsa.dcl_temps 3
// CHECK:         dxsa.dcl_tgsm_structured g<0>, 16, 384
// CHECK:         dxsa.dcl_thread_group <x = 16, y = 8, z = 3>
// CHECK:         dxsa.ishl r<0, <x>>, vThreadID<<x>>, l(0x7)
// CHECK:         dxsa.ishl r<0, <y>>, vThreadGroupID<<y>>, l(0xA)
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <x>>, vThreadIDInGroup<<z>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <x>>, vThreadIDInGroupFlattened<vector, <x>>
// CHECK:         dxsa.ld_raw r<0, <y>>, r<0, <x>>, u<0, vector, <x, x, x, x>>
// CHECK:         dxsa.add r<1, min16f, <x>>, r<0, <y>>, l(0x40000000)
// CHECK:         dxsa.store_structured g<0, vector, <x>>, vThreadIDInGroupFlattened<vector, <x>>, l(0x4), r<1, min16f, <x>>
// CHECK:         dxsa.store_structured g<0, vector, <x>>, vThreadIDInGroupFlattened<vector, <x>>, l(0x8), r<0, <y>>
// CHECK:         dxsa.ftoi r<2, min16i, <x>>, r<0, <y>>
// CHECK:         dxsa.store_structured g<0, vector, <x>>, vThreadIDInGroupFlattened<vector, <x>>, l(0xC), r<2, min16i, <x>>
// CHECK:         dxsa.sync <uav_global|tgsm|threads>
// CHECK:         dxsa.iadd r<0, <z>>, vThreadIDInGroupFlattened<vector, <x>>, cb<[0, 0], vector, <x>>
// CHECK:         dxsa.ld_structured r<0, <w>>, r<0, <z>>, l(0x8), g<0, vector, <x, x, x, x>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <w>>, r<0, <y>>
// CHECK:         dxsa.ld_structured r<2, min16i, <x>>, r<0, <z>>, l(0xC), g<0, vector, <x, x, x, x>>
// CHECK:         dxsa.itof r<0, <w>>, r<2, min16i, <x>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <w>>, r<0, <y>>
// CHECK:         dxsa.sync <tgsm|threads>
// CHECK:         dxsa.sync <uav_global>
// CHECK:         dxsa.ld_structured r<1, min16f, <x>>, r<0, <z>>, l(0x4), g<0, vector, <x, x, x, x>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <y>>, r<1, min16f, <x>>
// CHECK:         dxsa.store_raw u<0, vector, <x>>, r<0, <x>>, r<0, <y>>
// CHECK:         dxsa.ret

.shader_model compute 5 0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_constantbuffer cb0[1].xyzw
dcl_uav_raw u0
dcl_input vThreadIDInGroupFlattened
dcl_input vThreadGroupID.y
dcl_input vThreadIDInGroup.z
dcl_input vThreadID.x
dcl_temps 3
dcl_tgsm_structured g0, 16, 384
dcl_thread_group 16, 8, 3
ishl r0.x, vThreadID.x, l(0x00000007)
ishl r0.y, vThreadGroupID.y, l(0x0000000A)
iadd r0.x, r0.y, r0.x
iadd r0.x, r0.x, vThreadIDInGroup.z
iadd r0.x, r0.x, vThreadIDInGroupFlattened.x
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.y, r0.x, u0.xxxx
add r1.x{min16f}, r0.y, l(0x40000000)
store_structured g0.x, vThreadIDInGroupFlattened.x, l(0x00000004), r1.x{min16f}
store_structured g0.x, vThreadIDInGroupFlattened.x, l(0x00000008), r0.y
ftoi r2.x{min16i}, r0.y
store_structured g0.x, vThreadIDInGroupFlattened.x, l(0x0000000C), r2.x{min16i}
sync threads | tgsm | uav_global
iadd r0.z, vThreadIDInGroupFlattened.x, cb0[0].x
ld_structured r0.w, r0.z, l(0x00000008), g0.xxxx
add r0.y, r0.w, r0.y
ld_structured r2.x{min16i}, r0.z, l(0x0000000C), g0.xxxx
itof r0.w, r2.x{min16i}
add r0.y, r0.w, r0.y
sync threads | tgsm
sync uav_global
ld_structured r1.x{min16f}, r0.z, l(0x00000004), g0.xxxx
add r0.y, r0.y, r1.x{min16f}
store_raw u0.x, r0.x, r0.y
ret
