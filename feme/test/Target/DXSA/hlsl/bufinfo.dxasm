// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_resource_structured <id = 0, struct_byte_stride = 52>
// CHECK:         dxsa.dcl_resource_raw <id = 1>
// CHECK:         dxsa.dcl_resource <id = 2>, <dim =  buffer>, <x =  unorm, y =  unorm, z =  unorm, w =  unorm>
// CHECK:         dxsa.dcl_uav_structured <id = 1, struct_byte_stride = 52>
// CHECK:         dxsa.dcl_uav_raw <id = 2>
// CHECK:         dxsa.dcl_uav_typed <id = 3, dim =  buffer>, <x =  sint, y =  sint, z =  sint, w =  sint>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.bufinfo r<0, <x>>, t<0, vector>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <x>>, l(0x34)
// CHECK:         dxsa.bufinfo r<0, <y>>, u<1, vector, <y, x, z, w>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <x>>, r<0, <y>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <x>>, l(0x34)
// CHECK:         dxsa.bufinfo r<0, <y>>, t<1, vector, <y, x, z, w>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.bufinfo r<0, <y>>, u<2, vector, <y, x, z, w>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.bufinfo r<0, <y>>, t<2, vector, <y, x, z, w>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.bufinfo r<0, <y>>, u<3, vector, <y, x, z, w>>
// CHECK:         dxsa.iadd o<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_resource_structured t0, 52
dcl_resource_raw t1
dcl_resource_buffer (unorm, unorm, unorm, unorm) t2
dcl_uav_structured u1, 52
dcl_uav_raw u2
dcl_uav_typed_buffer (sint, sint, sint, sint) u3
dcl_output o0.x
dcl_temps 1
bufinfo resource_dim(structured_buffer, 52) resource_return_type(mixed, mixed, mixed, mixed) r0.x, t0.xyzw
iadd r0.x, r0.x, l(0x00000034)
bufinfo resource_dim(structured_buffer, 52) resource_return_type(mixed, mixed, mixed, mixed) r0.y, u1.yxzw
iadd r0.x, r0.x, r0.y
iadd r0.x, r0.x, l(0x00000034)
bufinfo resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.y, t1.yxzw
iadd r0.x, r0.y, r0.x
bufinfo resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.y, u2.yxzw
iadd r0.x, r0.y, r0.x
bufinfo resource_dim(buffer) resource_return_type(unorm, unorm, unorm, unorm) r0.y, t2.yxzw
iadd r0.x, r0.y, r0.x
bufinfo resource_dim(buffer) resource_return_type(sint, sint, sint, sint) r0.y, u3.yxzw
iadd o0.x, r0.y, r0.x
ret
