// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0>
// CHECK:         dxsa.dcl_input_ps_sgv v<1, <x>>, <sampleIndex>
// CHECK:         dxsa.dcl_input_ps_sgv v<1, <y>>, <isFrontFace>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_output o<5>
// CHECK:         dxsa.dcl_output oDepth
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.utof r<0, <x>>, v<1, <x>>
// CHECK:         dxsa.add r<0>, r<0, <x, x, x, x>>, v<0>
// CHECK:         dxsa.and r<1, <x>>, v<1, <y>>, l(0x3F800000)
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.mov oDepth, r<0, <x>>
// CHECK:         dxsa.mov o<0>, r<0>
// CHECK:         dxsa.mov o<5>, r<0>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xyzw
dcl_input_ps_sgv constant v1.x, sampleIndex
dcl_input_ps_sgv constant v1.y, isFrontFace
dcl_output o0.xyzw
dcl_output o5.xyzw
dcl_output oDepth
dcl_temps 2
utof r0.x, v1.x
add r0.xyzw, r0.xxxx, v0.xyzw
and r1.x, v1.y, l(0x3F800000)
add r0.xyzw, r0.xyzw, r1.xxxx
mov oDepth, r0.x
mov o0.xyzw, r0.xyzw
mov o5.xyzw, r0.xyzw
ret
