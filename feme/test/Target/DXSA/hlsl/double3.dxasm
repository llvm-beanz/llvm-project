// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableDoublePrecisionFloatOps>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <z, w>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x, y>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.mov r<0>, v<0>
// CHECK:         dxsa.deq r<1, <x>>, r<0, <z, w, z, w>>, r<0, <x, y, x, y>>
// CHECK:         dxsa.mov r<1, <z, w>>, v<1, <x, x, x, y>>
// CHECK:         dxsa.dne r<1, <y>>, r<0, <x, y, x, y>>, r<1, <z, w, z, w>>
// CHECK:         dxsa.and r<1, <x>>, r<1, <y>>, r<1, <x>>
// CHECK:         dxsa.dlt r<1, <y>>, r<0, <z, w, z, w>>, r<1, <z, w, z, w>>
// CHECK:         dxsa.dmul r<0, <z, w>>, r<0, <z, w, z, w>>, r<1, <z, w, z, w>>
// CHECK:         dxsa.dadd r<0, <z, w>>, r<0, <z, w, z, w>>, r<0, <x, y, x, y>>
// CHECK:         dxsa.dlt r<0, <x>>, r<0, <x, y, x, y>>, r<0, <z, w, z, w>>
// CHECK:         dxsa.and r<0, <y>>, r<1, <y>>, r<1, <x>>
// CHECK:         dxsa.and o<0, <x>>, r<0, <x>>, r<0, <y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | enableDoublePrecisionFloatOps
dcl_input_ps constant v0.xy
dcl_input_ps constant v0.zw
dcl_input_ps constant v1.xy
dcl_output o0.x
dcl_temps 2
mov r0.xyzw, v0.xyzw
deq r1.x, r0.zwzw, r0.xyxy
mov r1.zw, v1.xxxy
dne r1.y, r0.xyxy, r1.zwzw
and r1.x, r1.y, r1.x
dlt r1.y, r0.zwzw, r1.zwzw
dmul r0.zw, r0.zwzw, r1.zwzw
dadd r0.zw, r0.zwzw, r0.xyxy
dlt r0.x, r0.xyxy, r0.zwzw
and r0.y, r1.y, r1.x
and o0.x, r0.x, r0.y
ret
