// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x, y>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.if_nz v<1, <y>>
// CHECK:         dxsa.mov o<0, <x>>, v<0, <y>>
// CHECK:         dxsa.ret
// CHECK:         dxsa.endif
// CHECK:         dxsa.switch v<1, <x>>
// CHECK:         dxsa.case l(0x1)
// CHECK:         dxsa.call label<0>
// CHECK:         dxsa.break
// CHECK:         dxsa.case l(0x2)
// CHECK:         dxsa.call label<1>
// CHECK:         dxsa.break
// CHECK:         dxsa.default
// CHECK:         dxsa.call label<2>
// CHECK:         dxsa.break
// CHECK:         dxsa.endswitch
// CHECK:         dxsa.mov o<0, <x>>, r<0, <x>>
// CHECK:         dxsa.retc_nz r<0, <z>>
// CHECK:         dxsa.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxsa.ret
// CHECK:         dxsa.label label<0>
// CHECK:         dxsa.if_nz v<1, <y>>
// CHECK:         dxsa.mov r<0, <x>>, v<0, <y>>
// CHECK:         dxsa.mov r<0, <z>>, l(0xFFFFFFFF)
// CHECK:         dxsa.ret
// CHECK:         dxsa.endif
// CHECK:         dxsa.mov r<0, <y, z>>, l(0x0, 0x40A00000, 0x0, 0x0)
// CHECK:         dxsa.ret
// CHECK:         dxsa.label label<1>
// CHECK:         dxsa.mov r<0, <y>>, v<0, <x>>
// CHECK:         dxsa.mov r<0, <z>>, l(0x0)
// CHECK:         dxsa.ret
// CHECK:         dxsa.label label<2>
// CHECK:         dxsa.mov r<0, <y, z>>, l(0x0, 0x40400000, 0x0, 0x0)
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xy
dcl_input_ps constant v1.xy
dcl_output o0.x
dcl_temps 1
if_nz v1.y
mov o0.x, v0.y
ret
endif
switch v1.x
case l(0x00000001)
call label0
break
case l(0x00000002)
call label1
break
default
call label2
break
endswitch
mov o0.x, r0.x
retc_nz r0.z
mov o0.x, r0.y
ret
label label0
if_nz v1.y
mov r0.x, v0.y
mov r0.z, l(0xFFFFFFFF)
ret
endif
mov r0.yz, l(0x00000000, 0x40A00000, 0x00000000, 0x00000000)
ret
label label1
mov r0.y, v0.x
mov r0.z, l(0x00000000)
ret
label label2
mov r0.yz, l(0x00000000, 0x40400000, 0x00000000, 0x00000000)
ret
