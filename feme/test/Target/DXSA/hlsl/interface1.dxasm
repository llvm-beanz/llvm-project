// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 1>, <immediateIndexed>
// CHECK:         dxsa.instruction "dcl_function_body"
// CHECK:         dxsa.instruction "dcl_function_body"
// CHECK:         dxsa.instruction "dcl_function_table"
// CHECK:         dxsa.instruction "dcl_function_table"
// CHECK:         dxsa.instruction "dcl_interface"
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.mov r<0, <x>>, cb<[0, 0], vector, <x>>
// CHECK:         %0 = dxsa.operand  {num_components = 0 : i32, type = 0 : i32}
// CHECK:         dxsa.instruction "fcall" %0
// CHECK:         dxsa.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxsa.ret
// CHECK:         dxsa.label fb<0>
// CHECK:         dxsa.mov r<0, <z, w>>, thisPtr<r<0, <x>>, vector, <z, z, z, w>>
// CHECK:         dxsa.sample r<0, <z>>, l(0x3E000000, 0x3F600000, 0x0, 0x0), t<r<0, <z>>, vector, <y, z, x, w>>, s<r<0, <w>>>
// CHECK:         dxsa.mov r<0, <w>>, thisPtr<r<0, <x>>, vector, <y>>
// CHECK:         dxsa.mov r<1, <x>>, thisPtr<r<0, <x>>, vector, <x>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <z>>, cb<[r<1, <x>>, r<0, <w>>], vector, <x>>
// CHECK:         dxsa.ret
// CHECK:         dxsa.label fb<1>
// CHECK:         dxsa.mov r<0, <z, w>>, thisPtr<r<0, <x>>, vector, <z, z, z, w>>
// CHECK:         dxsa.sample r<0, <z>>, l(0x3E800000, 0x3F400000, 0x0, 0x0), t<r<0, <z>>, vector, <y, z, x, w>>, s<r<0, <w>>>
// CHECK:         dxsa.mov r<0, <w>>, thisPtr<r<0, <x>>, vector, <y>>
// CHECK:         dxsa.mov r<0, <x>>, thisPtr<r<0, <x>>, vector, <x>>
// CHECK:         dxsa.mul r<0, <y>>, r<0, <z>>, cb<[r<0, <x>>, r<0, <w>>], vector, <x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_constantbuffer cb0[1].xyzw
dcl_function_body 0
dcl_function_body 1
dcl_function_table 0, 1, 0
dcl_function_table 1, 1, 1
dcl_interface 0, 1, 0x00FD0002, 0, 1
dcl_output o0.x
dcl_temps 2
mov r0.x, cb0[0].x
fcall r{comp0}, 0x04213000, 0, 0x0010000A, 0
mov o0.x, r0.y
ret
label fb0
mov r0.zw, thisPtr[r0.x].zzzw
sample resource_dim(texture2d) resource_return_type(float, float, float, float) r0.z, l(0x3E000000, 0x3F600000, 0x00000000, 0x00000000), t[r0.z].yzxw, s[r0.w]
mov r0.w, thisPtr[r0.x].y
mov r1.x, thisPtr[r0.x].x
add r0.y, r0.z, cb[r1.x][r0.w].x
ret
label fb1
mov r0.zw, thisPtr[r0.x].zzzw
sample resource_dim(texture2d) resource_return_type(float, float, float, float) r0.z, l(0x3E800000, 0x3F400000, 0x00000000, 0x00000000), t[r0.z].yzxw, s[r0.w]
mov r0.w, thisPtr[r0.x].y
mov r0.x, thisPtr[r0.x].x
mul r0.y, r0.z, cb[r0.x][r0.w].x
ret
