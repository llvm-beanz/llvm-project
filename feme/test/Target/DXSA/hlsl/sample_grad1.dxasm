// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_sampler <id = 5, mode =  default>
// CHECK:         dxsa.dcl_resource <id = 3>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 3
// CHECK:         dxsa.sample_d r<0>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>
// CHECK:         dxsa.sample_d r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <u = -5, v = 7, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.sample_d_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <l(0x3F000000), null>, <u = -4, v = 1, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.sample_d_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <l(0x0), r<2, <x>>>, <u = -3, v = 2, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.check_access_fully_mapped r<1, <x>>, r<2, <x>>
// CHECK:         dxsa.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.sample_d_cl_s r<1>, v<0, <x, y, x, x>>, t<3, vector>, s<5>, v<0, <y, y, y, y>>, v<0, <y, x, y, y>>, <v<0, <x>>, r<2, <x>>>, <u = -3, v = 2, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.check_access_fully_mapped r<1, <x>>, r<2, <x>>
// CHECK:         dxsa.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxsa.add o<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_sampler s5
dcl_resource_texture2d (float, float, float, float) t3
dcl_input_ps linear v0.xy
dcl_output o0.xyzw
dcl_temps 3
sample_d resource_dim(texture2d) resource_return_type(float, float, float, float) r0.xyzw, v0.xyxx, t3.xyzw, s5, v0.yyyy, v0.yxyy
sample_d aoffimmi(-5, 7, 0) resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, v0.xyxx, t3.xyzw, s5, v0.yyyy, v0.yxyy
add r0.xyzw, r0.xyzw, r1.xyzw
sample_d_cl_s aoffimmi(-4, 1, 0) resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, null, v0.xyxx, t3.xyzw, s5, v0.yyyy, v0.yxyy, l(0x3F000000)
add r0.xyzw, r0.xyzw, r1.xyzw
sample_d_cl_s aoffimmi(-3, 2, 0) resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, r2.x, v0.xyxx, t3.xyzw, s5, v0.yyyy, v0.yxyy, l(0x00000000)
add r0.xyzw, r0.xyzw, r1.xyzw
check_access_fully_mapped r1.x, r2.x
utof r1.x, r1.x
add r0.xyzw, r0.xyzw, r1.xxxx
sample_d_cl_s aoffimmi(-3, 2, 0) resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, r2.x, v0.xyxx, t3.xyzw, s5, v0.yyyy, v0.yxyy, v0.x
add r0.xyzw, r0.xyzw, r1.xyzw
check_access_fully_mapped r1.x, r2.x
utof r1.x, r1.x
add o0.xyzw, r0.xyzw, r1.xxxx
ret
