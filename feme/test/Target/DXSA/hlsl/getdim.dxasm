// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_resource <id = 0>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_resource <id = 1>, <dim =  texture2darray>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_resource <id = 2>, <dim =  texturecubearray>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_resource <id = 3>, <dim = texture2dmsarray, sample_count = 0>, <x = float, y = float, z = float, w = float>
// CHECK:         dxsa.dcl_uav_typed <id = 1, dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <w>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.ftou r<0, <x>>, v<0, <w>>
// CHECK:         dxsa.resinfo_uint r<0, <y, z, w>>, r<0, <x>>, t<0, vector, <z, x, y, w>>
// CHECK:         dxsa.iadd r<0, <y>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.iadd r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxsa.iadd r<0, <y>>, r<0, <w>>, r<0, <y>>
// CHECK:         dxsa.resinfo_uint r<1, <x, y>>, l(0x0), t<0, vector>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <x>>, r<1, <x>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <y>>, r<0, <z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <w>>, r<0, <z>>
// CHECK:         dxsa.utof r<0, <y, z>>, r<0, <y, y, z, y>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxsa.resinfo_uint r<1>, r<0, <x>>, t<1, vector>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <x>>, r<1, <x>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <y>>, r<0, <z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <z>>, r<0, <z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <w>>, r<0, <z>>
// CHECK:         dxsa.utof r<0, <z>>, r<0, <z>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxsa.resinfo_uint r<1>, r<0, <x>>, t<2, vector>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <x>>, r<1, <x>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <y>>, r<0, <z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <z>>, r<0, <z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <w>>, r<0, <z>>
// CHECK:         dxsa.utof r<0, <z>>, r<0, <z>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxsa.resinfo_uint r<1, <x, y, z>>, l(0x0), t<3, vector>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <x>>, r<1, <x>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <y>>, r<0, <z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <z>>, r<0, <z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<1, <w>>, r<0, <z>>
// CHECK:         dxsa.sampleinfo_uint r<0, <w>>, t<3, vector, <x>>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <w>>, r<0, <z>>
// CHECK:         dxsa.utof r<0, <z>>, r<0, <z>>
// CHECK:         dxsa.add r<0, <y>>, r<0, <z>>, r<0, <y>>
// CHECK:         dxsa.resinfo_uint r<1, <x, y>>, l(0x0), u<1, vector>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <x>>, r<1, <x>>
// CHECK:         dxsa.iadd r<0, <x>>, r<1, <y>>, r<0, <x>>
// CHECK:         dxsa.iadd r<0, <x>>, r<1, <z>>, r<0, <x>>
// CHECK:         dxsa.iadd r<0, <x>>, r<1, <w>>, r<0, <x>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <w>>, r<0, <x>>
// CHECK:         dxsa.utof r<0, <x>>, r<0, <x>>
// CHECK:         dxsa.add o<0>, r<0, <x, x, x, x>>, r<0, <y, y, y, y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_resource_texture2d (float, float, float, float) t0
dcl_resource_texture2darray (float, float, float, float) t1
dcl_resource_texturecubearray (float, float, float, float) t2
dcl_resource_texture2dmsarray (float, float, float, float) t3
dcl_uav_typed_texture2d (float, float, float, float) u1
dcl_input_ps linear v0.w
dcl_output o0.xyzw
dcl_temps 2
ftou r0.x, v0.w
resinfo_uint resource_dim(texture2d) resource_return_type(float, float, float, float) r0.yzw, r0.x, t0.zxyw
iadd r0.y, r0.y, r0.x
iadd r0.y, r0.z, r0.y
iadd r0.y, r0.w, r0.y
resinfo_uint resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xy, l(0x00000000), t0.xyzw
iadd r0.z, r0.x, r1.x
iadd r0.z, r1.y, r0.z
iadd r0.z, r0.w, r0.z
utof r0.yz, r0.yyzy
add r0.y, r0.z, r0.y
resinfo_uint resource_dim(texture2darray) resource_return_type(float, float, float, float) r1.xyzw, r0.x, t1.xyzw
iadd r0.z, r0.x, r1.x
iadd r0.z, r1.y, r0.z
iadd r0.z, r1.z, r0.z
iadd r0.z, r1.w, r0.z
utof r0.z, r0.z
add r0.y, r0.z, r0.y
resinfo_uint resource_dim(texturecubearray) resource_return_type(float, float, float, float) r1.xyzw, r0.x, t2.xyzw
iadd r0.z, r0.x, r1.x
iadd r0.z, r1.y, r0.z
iadd r0.z, r1.z, r0.z
iadd r0.z, r1.w, r0.z
utof r0.z, r0.z
add r0.y, r0.z, r0.y
resinfo_uint resource_dim(texture2dmsarray) resource_return_type(float, float, float, float) r1.xyz, l(0x00000000), t3.xyzw
iadd r0.z, r0.x, r1.x
iadd r0.z, r1.y, r0.z
iadd r0.z, r1.z, r0.z
iadd r0.z, r1.w, r0.z
sampleinfo_uint r0.w, t3.x
iadd r0.z, r0.w, r0.z
utof r0.z, r0.z
add r0.y, r0.z, r0.y
resinfo_uint resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xy, l(0x00000000), u1.xyzw
iadd r0.x, r0.x, r1.x
iadd r0.x, r1.y, r0.x
iadd r0.x, r1.z, r0.x
iadd r0.x, r1.w, r0.x
iadd r0.x, r0.w, r0.x
utof r0.x, r0.x
add o0.xyzw, r0.xxxx, r0.yyyy
ret
