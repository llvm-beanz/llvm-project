// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 3>, <immediateIndexed>
// CHECK:         dxsa.dcl_sampler <id = 5, mode =  default>
// CHECK:         dxsa.dcl_resource <id = 3>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxsa.dcl_output o<0, <x, y>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.sample r<0, <x, y>>, v<0, <x, y, x, x>>, t<3, vector>, s<5>
// CHECK:         dxsa.add o<0, <x, y>>, r<0, <x, y, x, x>>, cb<[0, 2], vector, <x, y, x, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_constantbuffer cb0[3].xyzw
dcl_sampler s5
dcl_resource_texture2d (float, float, float, float) t3
dcl_input_ps linear v0.xy
dcl_output o0.xy
dcl_temps 1
sample resource_dim(texture2d) resource_return_type(float, float, float, float) r0.xy, v0.xyxx, t3.xyzw, s5
add o0.xy, r0.xyxx, cb0[2].xyxx
ret
