// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableDoublePrecisionFloatOps|enableDoubleExtensions>
// CHECK:         dxsa.dcl_input_ps  constant v<0>
// CHECK:         dxsa.dcl_input_ps  constant v<1>
// CHECK:         dxsa.dcl_input_ps  constant v<2>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 3
// CHECK:         dxsa.mov r<0>, v<1>
// CHECK:         dxsa.mov r<1>, v<2>
// CHECK:         dxsa.mov r<2>, v<0>
// CHECK:         dxsa.dfma r<0>, r<2>, r<0>, r<1>
// CHECK:         dxsa.dadd_sat r<0>, r<2>, r<0>
// CHECK:         dxsa.mov o<0>, r<0, <x, w, x, w>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | enableDoublePrecisionFloatOps | enableDoubleExtensions
dcl_input_ps constant v0.xyzw
dcl_input_ps constant v1.xyzw
dcl_input_ps constant v2.xyzw
dcl_output o0.xyzw
dcl_temps 3
mov r0.xyzw, v1.xyzw
mov r1.xyzw, v2.xyzw
mov r2.xyzw, v0.xyzw
dfma r0.xyzw, r2.xyzw, r0.xyzw, r1.xyzw
dadd_sat r0.xyzw, r2.xyzw, r0.xyzw
mov o0.xyzw, r0.xwxw
ret
