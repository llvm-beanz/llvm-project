// RUN: feme-translate --import-dxsa-hex %s | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py


// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxsa.dcl_input_ps  constant v<0, min16i, <x>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.iadd r<0, min16i, <x>>, v<0, min16i, <x>>, l(0x2)
// CHECK:         dxsa.ieq r<1, <x>>, r<0, min16i, <x>>, l(0x7)
// CHECK:         %[[INDEX_0:.*]] = dxsa.index.imm {imm = 1 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxsa.operand %[[INDEX_0]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxsa.instruction "if" %[[OPERAND_0]]
// CHECK:         dxsa.mov o<0, <x>>, l(0x4)
// CHECK:         dxsa.ret
// CHECK:         dxsa.else
// CHECK:         dxsa.mov o<0, <x>>, l(0x1)
// CHECK:         dxsa.ret
// CHECK:         dxsa.endif
// CHECK:         dxsa.ret

