// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input v<0, <x>>
// CHECK:         dxsa.dcl_output o<2>
// CHECK:         dxsa.dcl_output_siv o<7>, <position>
// CHECK:         dxsa.mov o<2>, v<0, <x, x, x, x>>
// CHECK:         dxsa.mov o<7>, v<0, <x, x, x, x>>
// CHECK:         dxsa.ret

.shader_model vertex 5 0
dcl_globalFlags refactoringAllowed
dcl_input v0.x
dcl_output o2.xyzw
dcl_output_siv o7.xyzw, position
mov o2.xyzw, v0.xxxx
mov o7.xyzw, v0.xxxx
ret
