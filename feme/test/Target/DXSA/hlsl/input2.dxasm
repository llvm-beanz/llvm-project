// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxsa.dcl_input_ps  linear v<0>
// CHECK:         dxsa.dcl_input_ps  constant v<1>
// CHECK:         dxsa.dcl_input_ps  constant v<2>
// CHECK:         dxsa.dcl_input_ps  linear v<3, min16f>
// CHECK:         dxsa.dcl_input_ps_siv  linear v<4, <x>>, <clipDistance>
// CHECK:         dxsa.dcl_input_ps_siv  linear v<4, <y>>, <cullDistance>
// CHECK:         dxsa.dcl_input_ps  constant v<5, <x>>
// CHECK:         dxsa.dcl_input_ps_sgv v<5, <y>>, <primitiveID>
// CHECK:         dxsa.dcl_input_ps_siv  constant v<5, <z>>, <renderTargetArrayIndex>
// CHECK:         dxsa.dcl_input_ps_siv  constant v<5, <w>>, <viewportArrayIndex>
// CHECK:         dxsa.dcl_input_ps_siv  linearNoPerspective v<6>, <position>
// CHECK:         dxsa.dcl_input_ps_sgv v<7, <x>>, <sampleIndex>
// CHECK:         dxsa.dcl_input_ps_sgv v<7, <y>>, <isFrontFace>
// CHECK:         dxsa.dcl_input vInnerCoverage
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.itof r<0>, v<1>
// CHECK:         dxsa.add r<0>, r<0>, v<0>
// CHECK:         dxsa.utof r<1>, v<2>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.add r<0>, r<0>, v<3, min16f>
// CHECK:         dxsa.add r<0>, r<0>, v<4, <x, x, x, x>>
// CHECK:         dxsa.add r<0>, r<0>, v<4, <y, y, y, y>>
// CHECK:         dxsa.utof r<1, <x>>, vInnerCoverage<vector, <x>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.utof r<1, <x>>, v<5, <x>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.utof r<1, <x>>, v<5, <y>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.utof r<1, <x>>, v<5, <z>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.utof r<1, <x>>, v<5, <w>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.add r<0>, r<0>, v<6>
// CHECK:         dxsa.utof r<1, <x>>, v<7, <x>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.and r<1, <x>>, v<7, <y>>, l(0x3F800000)
// CHECK:         dxsa.add o<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_input_ps linear v0.xyzw
dcl_input_ps constant v1.xyzw
dcl_input_ps constant v2.xyzw
dcl_input_ps linear v3.xyzw{min16f}
dcl_input_ps_siv linear v4.x, clipDistance
dcl_input_ps_siv linear v4.y, cullDistance
dcl_input_ps constant v5.x
dcl_input_ps_sgv constant v5.y, primitiveID
dcl_input_ps_siv constant v5.z, renderTargetArrayIndex
dcl_input_ps_siv constant v5.w, viewportArrayIndex
dcl_input_ps_siv linearNoPerspective v6.xyzw, position
dcl_input_ps_sgv constant v7.x, sampleIndex
dcl_input_ps_sgv constant v7.y, isFrontFace
dcl_input vInnerCoverage
dcl_output o0.xyzw
dcl_temps 2
itof r0.xyzw, v1.xyzw
add r0.xyzw, r0.xyzw, v0.xyzw
utof r1.xyzw, v2.xyzw
add r0.xyzw, r0.xyzw, r1.xyzw
add r0.xyzw, r0.xyzw, v3.xyzw{min16f}
add r0.xyzw, r0.xyzw, v4.xxxx
add r0.xyzw, r0.xyzw, v4.yyyy
utof r1.x, vInnerCoverage.x
add r0.xyzw, r0.xyzw, r1.xxxx
utof r1.x, v5.x
add r0.xyzw, r0.xyzw, r1.xxxx
utof r1.x, v5.y
add r0.xyzw, r0.xyzw, r1.xxxx
utof r1.x, v5.z
add r0.xyzw, r0.xyzw, r1.xxxx
utof r1.x, v5.w
add r0.xyzw, r0.xyzw, r1.xxxx
add r0.xyzw, r0.xyzw, v6.xyzw
utof r1.x, v7.x
add r0.xyzw, r0.xyzw, r1.xxxx
and r1.x, v7.y, l(0x3F800000)
add o0.xyzw, r0.xyzw, r1.xxxx
ret
