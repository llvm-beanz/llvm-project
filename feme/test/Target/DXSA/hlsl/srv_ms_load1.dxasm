// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.unknown <tokens = [0x04002058, 0x00107000, 0x00000003, 0x00005555]>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <z>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x, y>>
// CHECK:         dxsa.dcl_output o<0, <x, y, z>>
// CHECK:         dxsa.dcl_temps 4
// CHECK:         dxsa.mov r<0, <x, y>>, v<1, <x, y, x, x>>
// CHECK:         dxsa.mov r<0, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.ld2dms r<0, <x, y, z>>, r<0>, t<3, vector>, l(0x0)
// CHECK:         dxsa.mov r<1, <x, y>>, v<0, <x, y, x, x>>
// CHECK:         dxsa.mov r<1, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.ld2dms r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>
// CHECK:         dxsa.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxsa.ld2dms r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, <u = -5, v = 7, w = 0>
// CHECK:         dxsa.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxsa.ld2dms_s r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, r<3, <x>>, <u = -5, v = 7, w = 0>
// CHECK:         dxsa.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxsa.check_access_fully_mapped r<0, <w>>, r<3, <x>>
// CHECK:         dxsa.utof r<0, <w>>, r<0, <w>>
// CHECK:         dxsa.add r<0, <x, y, z>>, r<0, <w, w, w, w>>, r<0, <x, y, z, x>>
// CHECK:         dxsa.ld2dms_s r<2, <x, y, z>>, r<1, <x, y, w, w>>, t<3, vector>, v<0, <z>>, r<3, <x>>
// CHECK:         dxsa.ld2dms r<1, <x, y, z>>, r<1>, t<3, vector>, l(0xD)
// CHECK:         dxsa.add r<0, <x, y, z>>, r<0, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxsa.check_access_fully_mapped r<0, <w>>, r<3, <x>>
// CHECK:         dxsa.utof r<0, <w>>, r<0, <w>>
// CHECK:         dxsa.add r<0, <x, y, z>>, r<0, <w, w, w, w>>, r<0, <x, y, z, x>>
// CHECK:         dxsa.add o<0, <x, y, z>>, r<1, <x, y, z, x>>, r<0, <x, y, z, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_resource_texture2dms (float, float, float, float) t3
dcl_input_ps constant v0.xy
dcl_input_ps constant v0.z
dcl_input_ps constant v1.xy
dcl_output o0.xyz
dcl_temps 4
mov r0.xy, v1.xyxx
mov r0.zw, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
ld2dms resource_dim(texture2dms) resource_return_type(float, float, float, float) r0.xyz, r0.xyzw, t3.xyzw, l(0x00000000)
mov r1.xy, v0.xyxx
mov r1.zw, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
ld2dms resource_dim(texture2dms) resource_return_type(float, float, float, float) r2.xyz, r1.xyww, t3.xyzw, v0.z
add r0.xyz, r0.xyzx, r2.xyzx
ld2dms aoffimmi(-5, 7, 0) resource_dim(texture2dms) resource_return_type(float, float, float, float) r2.xyz, r1.xyww, t3.xyzw, v0.z
add r0.xyz, r0.xyzx, r2.xyzx
ld2dms_s aoffimmi(-5, 7, 0) resource_dim(texture2dms) resource_return_type(float, float, float, float) r2.xyz, r3.x, r1.xyww, t3.xyzw, v0.z
add r0.xyz, r0.xyzx, r2.xyzx
check_access_fully_mapped r0.w, r3.x
utof r0.w, r0.w
add r0.xyz, r0.wwww, r0.xyzx
ld2dms_s resource_dim(texture2dms) resource_return_type(float, float, float, float) r2.xyz, r3.x, r1.xyww, t3.xyzw, v0.z
ld2dms resource_dim(texture2dms) resource_return_type(float, float, float, float) r1.xyz, r1.xyzw, t3.xyzw, l(0x0000000D)
add r0.xyz, r0.xyzx, r2.xyzx
check_access_fully_mapped r0.w, r3.x
utof r0.w, r0.w
add r0.xyz, r0.wwww, r0.xyzx
add o0.xyz, r1.xyzx, r0.xyzx
ret
