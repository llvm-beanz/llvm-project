// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_sampler <id = 0, mode =  default>
// CHECK:         dxsa.dcl_resource <id = 0>, <dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_resource <id = 1>, <dim =  texture2darray>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_resource <id = 2>, <dim =  texturecubearray>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_input_ps  linear v<0>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 3
// CHECK:         dxsa.gather4 r<0>, v<0, <x, y, x, x>>, t<0, vector>, s<0, vector, <x>>
// CHECK:         dxsa.gather4 r<1>, v<0, <x, y, x, x>>, t<0, vector>, s<0, vector, <y>>, <u = -5, v = 7, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.gather4_s r<1>, v<0, <x, y, x, x>>, t<0, vector>, s<0, vector, <w>>, r<2, <x>>, <u = -3, v = 2, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.check_access_fully_mapped r<1, <x>>, r<2, <x>>
// CHECK:         dxsa.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.gather4_s r<1>, v<0, <x, y, z, x>>, t<1, vector>, s<0, vector, <z>>, r<2, <x>>, <u = -3, v = 2, w = 0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.check_access_fully_mapped r<1, <x>>, r<2, <x>>
// CHECK:         dxsa.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxsa.add r<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.gather4_s r<1>, v<0>, t<2, vector>, s<0, vector, <z>>, r<2, <x>>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.check_access_fully_mapped r<1, <x>>, r<2, <x>>
// CHECK:         dxsa.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxsa.add o<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_sampler s0
dcl_resource_texture2d (float, float, float, float) t0
dcl_resource_texture2darray (float, float, float, float) t1
dcl_resource_texturecubearray (float, float, float, float) t2
dcl_input_ps linear v0.xyzw
dcl_output o0.xyzw
dcl_temps 3
gather4 resource_dim(texture2d) resource_return_type(float, float, float, float) r0.xyzw, v0.xyxx, t0.xyzw, s0.x
gather4 aoffimmi(-5, 7, 0) resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, v0.xyxx, t0.xyzw, s0.y
add r0.xyzw, r0.xyzw, r1.xyzw
gather4_s aoffimmi(-3, 2, 0) resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, r2.x, v0.xyxx, t0.xyzw, s0.w
add r0.xyzw, r0.xyzw, r1.xyzw
check_access_fully_mapped r1.x, r2.x
utof r1.x, r1.x
add r0.xyzw, r0.xyzw, r1.xxxx
gather4_s aoffimmi(-3, 2, 0) resource_dim(texture2darray) resource_return_type(float, float, float, float) r1.xyzw, r2.x, v0.xyzx, t1.xyzw, s0.z
add r0.xyzw, r0.xyzw, r1.xyzw
check_access_fully_mapped r1.x, r2.x
utof r1.x, r1.x
add r0.xyzw, r0.xyzw, r1.xxxx
gather4_s resource_dim(texturecubearray) resource_return_type(float, float, float, float) r1.xyzw, r2.x, v0.xyzw, t2.xyzw, s0.z
add r0.xyzw, r0.xyzw, r1.xyzw
check_access_fully_mapped r1.x, r2.x
utof r1.x, r1.x
add o0.xyzw, r0.xyzw, r1.xxxx
ret
