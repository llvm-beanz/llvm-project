// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_uav_typed <id = 3, dim =  texture2d>, <x =  float, y =  float, z =  float, w =  float>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <z, w>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.ld_uav_typed r<0>, v<0, <z, w, w, w>>, u<3, vector>
// CHECK:         dxsa.ld_uav_typed r<1>, v<0, <x, y, y, y>>, u<3, vector>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.ld_uav_typed_s null, v<0, <x, y, y, y>>, u<3, vector>, r<1, <x>>
// CHECK:         dxsa.check_access_fully_mapped r<1, <x>>, r<1, <x>>
// CHECK:         dxsa.utof r<1, <x>>, r<1, <x>>
// CHECK:         dxsa.mad r<0>, r<1, <x, x, x, x>>, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r<0>
// CHECK:         %[[INDEX_2:.*]] = dxsa.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_2:.*]] = dxsa.operand %[[INDEX_2]] {mask = 240 : i32, num_components = 4 : i32, type = 30 : i32}
// CHECK:         %[[INDEX_3:.*]] = dxsa.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_3:.*]] = dxsa.operand %[[INDEX_3]] {num_components = 4 : i32, swizzle = dense<[2, 3, 3, 3]> : vector<4xi32>, type = 1 : i32}
// CHECK:         %[[INDEX_4:.*]] = dxsa.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxsa.operand %[[INDEX_4]] {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 3]> : vector<4xi32>, type = 0 : i32}
// CHECK:         dxsa.instruction "store_uav_typed" %[[OPERAND_2]], %[[OPERAND_3]], %[[OPERAND_4]]
// CHECK:         dxsa.mov o<0>, r<0>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_uav_typed_texture2d (float, float, float, float) u3
dcl_input_ps constant v0.xy
dcl_input_ps constant v0.zw
dcl_output o0.xyzw
dcl_temps 2
ld_uav_typed resource_dim(texture2d) resource_return_type(float, float, float, float) r0.xyzw, v0.zwww, u3.xyzw
ld_uav_typed resource_dim(texture2d) resource_return_type(float, float, float, float) r1.xyzw, v0.xyyy, u3.xyzw
add r0.xyzw, r0.xyzw, r1.xyzw
ld_uav_typed_s resource_dim(texture2d) resource_return_type(float, float, float, float) null, r1.x, v0.xyyy, u3.xyzw
check_access_fully_mapped r1.x, r1.x
utof r1.x, r1.x
mad r0.xyzw, r1.xxxx, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r0.xyzw
store_uav_typed u3.xyzw, v0.zwww, r0.xyzw
mov o0.xyzw, r0.xyzw
ret
