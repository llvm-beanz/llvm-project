// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_sampler <id = 5, mode =  default>
// CHECK:         dxsa.dcl_resource <id = 3>, <dim =  texture2d>, <x =  snorm, y =  snorm, z =  snorm, w =  snorm>
// CHECK:         dxsa.dcl_resource <id = 7>, <dim =  texture2d>, <x =  unorm, y =  unorm, z =  unorm, w =  unorm>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.sample r<0>, v<0, <x, y, x, x>>, t<3, vector>, s<5>
// CHECK:         dxsa.sample r<1, <x, y, z>>, v<0, <x, y, x, x>>, t<7, vector>, s<5>
// CHECK:         dxsa.add o<0>, r<0>, r<1, <z, z, y, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_sampler s5
dcl_resource_texture2d (snorm, snorm, snorm, snorm) t3
dcl_resource_texture2d (unorm, unorm, unorm, unorm) t7
dcl_input_ps linear v0.xy
dcl_output o0.xyzw
dcl_temps 2
sample resource_dim(texture2d) resource_return_type(snorm, snorm, snorm, snorm) r0.xyzw, v0.xyxx, t3.xyzw, s5
sample resource_dim(texture2d) resource_return_type(unorm, unorm, unorm, unorm) r1.xyz, v0.xyxx, t7.xyzw, s5
add o0.xyzw, r0.xyzw, r1.zzyx
ret
