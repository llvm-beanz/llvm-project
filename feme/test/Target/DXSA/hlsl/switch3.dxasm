// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x, y, z>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.switch v<1, <x>>
// CHECK:         dxsa.case l(0x1)
// CHECK:         dxsa.switch v<1, <y>>
// CHECK:         dxsa.case l(0x14)
// CHECK:         dxsa.ieq r<0, <y>>, v<1, <z>>, l(0x1E)
// CHECK:         dxsa.if_nz r<0, <y>>
// CHECK:         dxsa.mov r<0, <x>>, l(0x40B00000)
// CHECK:         dxsa.break
// CHECK:         dxsa.endif
// CHECK:         dxsa.ieq r<0, <y>>, v<1, <z>>, l(0x1F)
// CHECK:         dxsa.mov r<0, <x>>, l(0x40B66666)
// CHECK:         dxsa.breakc_nz r<0, <y>>
// CHECK:         dxsa.mov r<0, <x>>, l(0x40B9999A)
// CHECK:         dxsa.break
// CHECK:         dxsa.default
// CHECK:         dxsa.mov r<0, <x>>, v<0, <y>>
// CHECK:         dxsa.break
// CHECK:         dxsa.endswitch
// CHECK:         dxsa.break
// CHECK:         dxsa.case l(0x2)
// CHECK:         dxsa.mov r<0, <x>>, v<0, <x>>
// CHECK:         dxsa.break
// CHECK:         dxsa.default
// CHECK:         dxsa.mov r<0, <x>>, l(0x40400000)
// CHECK:         dxsa.break
// CHECK:         dxsa.endswitch
// CHECK:         dxsa.mov o<0, <x>>, r<0, <x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xy
dcl_input_ps constant v1.xyz
dcl_output o0.x
dcl_temps 1
switch v1.x
case l(0x00000001)
switch v1.y
case l(0x00000014)
ieq r0.y, v1.z, l(0x0000001E)
if_nz r0.y
mov r0.x, l(0x40B00000)
break
endif
ieq r0.y, v1.z, l(0x0000001F)
mov r0.x, l(0x40B66666)
breakc_nz r0.y
mov r0.x, l(0x40B9999A)
break
default
mov r0.x, v0.y
break
endswitch
break
case l(0x00000002)
mov r0.x, v0.x
break
default
mov r0.x, l(0x40400000)
break
endswitch
mov o0.x, r0.x
ret
