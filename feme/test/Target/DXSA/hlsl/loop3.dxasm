// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x, y, z>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 3
// CHECK:         dxsa.mov r<0, <x>>, l(0x10)
// CHECK:         dxsa.mov r<1, <x>>, v<1, <z>>
// CHECK:         dxsa.mov r<1, <y>>, l(0x0)
// CHECK:         dxsa.mov r<0, <z>>, l(0x0)
// CHECK:         dxsa.loop
// CHECK:         dxsa.ige r<0, <w>>, r<0, <z>>, v<1, <x>>
// CHECK:         dxsa.breakc_nz r<0, <w>>
// CHECK:         dxsa.ieq r<0, <w>>, r<1, <x>>, l(0x9)
// CHECK:         dxsa.if_nz r<0, <w>>
// CHECK:         dxsa.break
// CHECK:         dxsa.endif
// CHECK:         dxsa.mov r<1, <z, w>>, r<1, <x, x, x, y>>
// CHECK:         dxsa.mov r<0, <w>>, l(0x0)
// CHECK:         dxsa.loop
// CHECK:         dxsa.ige r<2, <x>>, r<0, <w>>, v<1, <y>>
// CHECK:         dxsa.breakc_nz r<2, <x>>
// CHECK:         dxsa.ieq r<2, <x>>, r<1, <z>>, l(0x10)
// CHECK:         dxsa.if_nz r<2, <x>>
// CHECK:         dxsa.mov r<0, <y>>, r<1, <w>>
// CHECK:         dxsa.mov r<1, <z, w>>, r<0, <x, x, x, y>>
// CHECK:         dxsa.break
// CHECK:         dxsa.endif
// CHECK:         dxsa.add r<1, <w>>, r<1, <w>>, v<0, <x>>
// CHECK:         dxsa.iadd r<0, <w>>, r<0, <w>>, l(0x1)
// CHECK:         dxsa.endloop
// CHECK:         dxsa.mov r<1, <x, y>>, r<1, <z, w, z, z>>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <z>>, l(0x1)
// CHECK:         dxsa.endloop
// CHECK:         dxsa.mov o<0, <x>>, r<1, <y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.x
dcl_input_ps constant v1.xyz
dcl_output o0.x
dcl_temps 3
mov r0.x, l(0x00000010)
mov r1.x, v1.z
mov r1.y, l(0x00000000)
mov r0.z, l(0x00000000)
loop
ige r0.w, r0.z, v1.x
breakc_nz r0.w
ieq r0.w, r1.x, l(0x00000009)
if_nz r0.w
break
endif
mov r1.zw, r1.xxxy
mov r0.w, l(0x00000000)
loop
ige r2.x, r0.w, v1.y
breakc_nz r2.x
ieq r2.x, r1.z, l(0x00000010)
if_nz r2.x
mov r0.y, r1.w
mov r1.zw, r0.xxxy
break
endif
add r1.w, r1.w, v0.x
iadd r0.w, r0.w, l(0x00000001)
endloop
mov r1.xy, r1.zwzz
iadd r0.z, r0.z, l(0x00000001)
endloop
mov o0.x, r1.y
ret
