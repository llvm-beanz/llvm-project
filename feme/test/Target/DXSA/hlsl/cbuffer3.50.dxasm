// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 16>, <dynamicIndexed>
// CHECK:         dxsa.dcl_constant_buffer <id = 1, size = 8>, <dynamicIndexed>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.mov r<0, <x>>, v<0, <x>>
// CHECK:         dxsa.mov r<0, <x>>, cb<[1, r<0, <x>>], vector, <z>>
// CHECK:         dxsa.mov o<0>, cb<[0, r<0, <x>>], vector, <w, y, y, y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_constantbuffer_dynamicIndexed cb0[16].xyzw
dcl_constantbuffer_dynamicIndexed cb1[8].xyzw
dcl_input_ps constant v0.x
dcl_output o0.xyzw
dcl_temps 1
mov r0.x, v0.x
mov r0.x, cb1[r0.x].z
mov o0.xyzw, cb0[r0.x].wyyy
ret
