// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 16, lbound = 17, ubound = 80, space = 0>, <dynamicIndexed>
// CHECK:         dxsa.dcl_constant_buffer <id = 1, size = 16, lbound = 77, ubound = 108, space = 3>, <dynamicIndexed>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x, y, z>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.iadd r<0, <x>>, v<0, <z>>, l(0xC)
// CHECK:         dxsa.mov r<0, <y, z>>, v<0, <y, y, x, y>>
// CHECK:         dxsa.mov r<0, <y>>, cb<[0, 17 + r<0, <z>>, r<0, <y>>], vector, <z>>
// CHECK:         dxsa.mov o<0>, cb<[1, 77 + r<0, <y>>, r<0, <x>>], vector, <w, y, y, y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 1
dcl_globalFlags refactoringAllowed
dcl_constantbuffer_dynamicIndexed cb0[17][80].xyzw, 16, 0
dcl_constantbuffer_dynamicIndexed cb1[77][108].xyzw, 16, 3
dcl_input_ps constant v0.xyz
dcl_output o0.xyzw
dcl_temps 1
iadd r0.x, v0.z, l(0x0000000C)
mov r0.yz, v0.yyxy
mov r0.y, cb0[17 + r0.z][r0.y].z
mov o0.xyzw, cb1[77 + r0.y][r0.x].wyyy
ret
