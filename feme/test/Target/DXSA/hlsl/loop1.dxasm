// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.mov r<0, <x, y>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.loop
// CHECK:         dxsa.ige r<0, <z>>, r<0, <y>>, v<1, <x>>
// CHECK:         dxsa.breakc_nz r<0, <z>>
// CHECK:         dxsa.add r<0, <x>>, r<0, <x>>, v<0, <x>>
// CHECK:         dxsa.iadd r<0, <y>>, r<0, <y>>, l(0x1)
// CHECK:         dxsa.endloop
// CHECK:         dxsa.mov o<0, <x>>, r<0, <x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.x
dcl_input_ps constant v1.x
dcl_output o0.x
dcl_temps 1
mov r0.xy, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
loop
ige r0.z, r0.y, v1.x
breakc_nz r0.z
add r0.x, r0.x, v0.x
iadd r0.y, r0.y, l(0x00000001)
endloop
mov o0.x, r0.x
ret
