// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|skipOptimization|enableMinimumPrecision>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.mov r<0, min16f, <x>>, l(0x3F000000)
// CHECK:         dxsa.rcp r<0, min16f, <x>>, r<0, min16f, <x>>
// CHECK:         dxsa.mov o<0, <x>>, r<0, min16f, <x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | skipOptimization | enableMinimumPrecision
dcl_output o0.x
dcl_temps 1
mov r0.x{min16f}, l(0x3F000000)
rcp r0.x{min16f}, r0.x{min16f}
mov o0.x, r0.x{min16f}
ret
