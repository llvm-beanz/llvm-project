// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxsa.dcl_input_ps  linear v<0>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_output o<5>
// CHECK:         dxsa.dcl_output oDepthLE
// CHECK:         dxsa.dcl_output oStencilRef<min16u>
// CHECK:         dxsa.mov oDepthLE, v<0, <x>>
// CHECK:         dxsa.ftou oStencilRef<min16u>, v<0, <x>>
// CHECK:         dxsa.mov o<0>, v<0>
// CHECK:         dxsa.mov o<5>, v<0>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_input_ps linear v0.xyzw
dcl_output o0.xyzw
dcl_output o5.xyzw
dcl_output oDepthLE
dcl_output oStencilRef{min16u}
mov oDepthLE, v0.x
ftou oStencilRef{min16u}, v0.x
mov o0.xyzw, v0.xyzw
mov o5.xyzw, v0.xyzw
ret
