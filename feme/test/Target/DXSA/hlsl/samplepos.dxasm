// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_resource <id = 0>, <dim = texture2dms, sample_count = 0>, <x = float, y = float, z = float, w = float>
// CHECK:         dxsa.dcl_resource <id = 1>, <dim = texture2dmsarray, sample_count = 0>, <x = float, y = float, z = float, w = float>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <y, z, w>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_output o<1>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.ftoi r<0, <x, y, z>>, v<0, <z, w, y, z>>
// CHECK:         dxsa.samplepos r<0, <x, w>>, t<0, vector, <x, x, x, y>>, r<0, <x>>
// CHECK:         dxsa.samplepos r<1, <x, y>>, t<1, vector, <x, y, x, x>>, r<0, <y>>
// CHECK:         dxsa.samplepos r<0, <y, z>>, rasterizer<vector, <x, x, y, x>>, r<0, <z>>
// CHECK:         dxsa.add r<0, <x, w>>, r<0, <x, x, x, w>>, r<1, <x, x, x, y>>
// CHECK:         dxsa.samplepos r<1, <x, y>>, rasterizer<vector, <x, y, x, x>>, l(0x3)
// CHECK:         dxsa.add r<0, <x, w>>, r<0, <x, x, x, w>>, r<1, <x, x, x, y>>
// CHECK:         dxsa.add r<0, <x, y>>, r<0, <y, z, y, y>>, r<0, <x, w, x, x>>
// CHECK:         dxsa.mov o<0, <x, y>>, r<0, <x, y, x, x>>
// CHECK:         dxsa.add o<1, <x, y>>, r<0, <x, y, x, x>>, l(0x40A00000, 0x40A00000, 0x0, 0x0)
// CHECK:         dxsa.mov o<0, <z, w>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.mov o<1, <z, w>>, l(0x0, 0x0, 0x40A00000, 0x40A00000)
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_resource_texture2dms (float, float, float, float) t0
dcl_resource_texture2dmsarray (float, float, float, float) t1
dcl_input_ps linear v0.yzw
dcl_output o0.xyzw
dcl_output o1.xyzw
dcl_temps 2
ftoi r0.xyz, v0.zwyz
samplepos r0.xw, t0.xxxy, r0.x, 0
samplepos r1.xy, t1.xyxx, r0.y, 0
samplepos r0.yz, rasterizer.xxyx, r0.z
add r0.xw, r0.xxxw, r1.xxxy
samplepos r1.xy, rasterizer.xyxx, l(0x00000003)
add r0.xw, r0.xxxw, r1.xxxy
add r0.xy, r0.yzyy, r0.xwxx
mov o0.xy, r0.xyxx
add o1.xy, r0.xyxx, l(0x40A00000, 0x40A00000, 0x00000000, 0x00000000)
mov o0.zw, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
mov o1.zw, l(0x00000000, 0x00000000, 0x40A00000, 0x40A00000)
ret
