// CHECK:         %[[OPERAND_13:.*]] = dxsa.operand %[[INDEX_13]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxsa.instruction "check_access_fully_mapped" %[[OPERAND_12]], %[[OPERAND_13]]
// CHECK:         dxsa.and r<0, <x>>, r<0, <y>>, r<0, <x>>
