// CHECK:         %[[OPERAND_14:.*]] = dxsa.operand %[[INDEX_14]] {mask = 32 : i32, num_components = 4 : i32, type = 0 : i32}
// CHECK:         %[[INDEX_15:.*]] = dxsa.index.imm {imm = 4 : i32}
// CHECK:         %[[OPERAND_15:.*]] = dxsa.operand %[[INDEX_15]] {num_components = 4 : i32, one = 0 : i32, type = 0 : i32}
// CHECK:         dxsa.instruction "check_access_fully_mapped" %[[OPERAND_14]], %[[OPERAND_15]]
// CHECK:         dxsa.and r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.utof r<0, <x>>, r<0, <x>>
// CHECK:         dxsa.add r<1>, r<1>, r<3>
// CHECK:         dxsa.add o<0>, r<0, <x, x, x, x>>, r<1>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_sampler_comparison s0
dcl_resource_texture2d (float, float, float, float) t0
dcl_resource_texture2darray (float, float, float, float) t1
dcl_input_ps linear v0.xyzw
dcl_input_ps linear v1.xyzw
dcl_output o0.xyzw
dcl_temps 6
ftoi r0.xyzw, v1.xyzw
gather4_po_c resource_dim(texture2d) resource_return_type(float, float, float, float) r1.x, v0.xyxx, r0.xyxx, t0.xyzw, s0.x, v0.y
gather4_po_c resource_dim(texture2d) resource_return_type(float, float, float, float) r1.y, v0.xyxx, r0.zwzz, t0.xyzw, s0.x, v0.y
ftoi r2.xyzw, v0.xyzw
gather4_po_c resource_dim(texture2d) resource_return_type(float, float, float, float) r1.z, v0.xyxx, r2.xyxx, t0.xyzw, s0.x, v0.y
gather4_po_c resource_dim(texture2d) resource_return_type(float, float, float, float) r1.w, v0.xyxx, r2.zwzz, t0.xyzw, s0.x, v0.y
gather4_po_c_s resource_dim(texture2d) resource_return_type(float, float, float, float) r3.x, r4.x, v0.xyxx, r0.xyxx, t0.xyzw, s0.w, v0.y
check_access_fully_mapped r4.x, r4.x
gather4_po_c_s resource_dim(texture2d) resource_return_type(float, float, float, float) r3.y, r5.x, v0.xyxx, r0.zwzz, t0.xyzw, s0.w, v0.y
check_access_fully_mapped r4.y, r5.x
and r4.x, r4.y, r4.x
gather4_po_c_s resource_dim(texture2d) resource_return_type(float, float, float, float) r3.z, r5.x, v0.xyxx, r2.xyxx, t0.xyzw, s0.w, v0.y
check_access_fully_mapped r4.y, r5.x
and r4.x, r4.y, r4.x
gather4_po_c_s resource_dim(texture2d) resource_return_type(float, float, float, float) r3.w, r5.x, v0.xyxx, r2.zwzz, t0.xyzw, s0.w, v0.y
check_access_fully_mapped r4.y, r5.x
and r4.x, r4.y, r4.x
utof r4.x, r4.x
add r1.xyzw, r1.xyzw, r3.xyzw
add r1.xyzw, r4.xxxx, r1.xyzw
gather4_po_c_s resource_dim(texture2darray) resource_return_type(float, float, float, float) r3.x, r0.x, v0.xyzx, r0.xyxx, t1.xyzw, s0.z, v0.y
gather4_po_c_s resource_dim(texture2darray) resource_return_type(float, float, float, float) r3.y, r4.x, v0.xyzx, r0.zwzz, t1.xyzw, s0.z, v0.y
check_access_fully_mapped r0.x, r0.x
check_access_fully_mapped r0.y, r4.x
and r0.x, r0.y, r0.x
gather4_po_c_s resource_dim(texture2darray) resource_return_type(float, float, float, float) r3.z, r2.x, v0.xyzx, r2.xyxx, t1.xyzw, s0.z, v0.y
gather4_po_c_s resource_dim(texture2darray) resource_return_type(float, float, float, float) r3.w, r4.x, v0.xyzx, r2.zwzz, t1.xyzw, s0.z, v0.y
check_access_fully_mapped r0.y, r2.x
and r0.x, r0.y, r0.x
check_access_fully_mapped r0.y, r4.x
and r0.x, r0.y, r0.x
utof r0.x, r0.x
add r1.xyzw, r1.xyzw, r3.xyzw
add o0.xyzw, r0.xxxx, r1.xyzw
ret
