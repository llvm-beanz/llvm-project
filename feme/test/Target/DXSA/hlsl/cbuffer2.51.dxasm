// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 1, lbound = 0, ubound = 0, space = 0>, <immediateIndexed>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.mov o<0>, cb<[0, 0, 0], vector, <w, y, y, y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 1
dcl_globalFlags refactoringAllowed
dcl_constantbuffer cb0[0][0].xyzw, 1, 0
dcl_output o0.xyzw
mov o0.xyzw, cb0[0][0].wyyy
ret
