// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_immediate_constant_buffer [1.000000e+00, 0.000000e+00, 0.000000e+00, 0.000000e+00, 0.000000e+00, 1.000000e+00, 0.000000e+00, 0.000000e+00, 0.000000e+00, 0.000000e+00, 1.000000e+00, 0.000000e+00, 0.000000e+00, 0.000000e+00, 0.000000e+00, 1.000000e+00]
// CHECK:         dxsa.dcl_input_ps  linear v<0>
// CHECK:         dxsa.dcl_input_ps  linear v<1>
// CHECK:         dxsa.dcl_input_ps  linear v<2>
// CHECK:         dxsa.dcl_input_ps  linear v<3>
// CHECK:         dxsa.dcl_input_ps  constant v<4, <x, y>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.mov r<0, <x, y>>, v<4, <y, x, y, y>>
// CHECK:         dxsa.dp4 r<1, <x>>, v<0>, icb<r<0, <y>>, vector>
// CHECK:         dxsa.dp4 r<1, <y>>, v<1>, icb<r<0, <y>>, vector>
// CHECK:         dxsa.dp4 r<1, <z>>, v<2>, icb<r<0, <y>>, vector>
// CHECK:         dxsa.dp4 r<1, <w>>, v<3>, icb<r<0, <y>>, vector>
// CHECK:         dxsa.dp4 o<0, <x>>, r<1>, icb<r<0, <x>>, vector>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_immediateConstantBuffer {0x3F800000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x3F800000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x3F800000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x3F800000}
dcl_input_ps linear v0.xyzw
dcl_input_ps linear v1.xyzw
dcl_input_ps linear v2.xyzw
dcl_input_ps linear v3.xyzw
dcl_input_ps constant v4.xy
dcl_output o0.x
dcl_temps 2
mov r0.xy, v4.yxyy
dp4 r1.x, v0.xyzw, icb[r0.y].xyzw
dp4 r1.y, v1.xyzw, icb[r0.y].xyzw
dp4 r1.z, v2.xyzw, icb[r0.y].xyzw
dp4 r1.w, v3.xyzw, icb[r0.y].xyzw
dp4 o0.x, r1.xyzw, icb[r0.x].xyzw
ret
