// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x, y>>
// CHECK:         dxsa.dcl_input_ps  linear v<1, <x, y>>
// CHECK:         dxsa.dcl_input_ps  linear v<2, <x, y>>
// CHECK:         dxsa.dcl_input_ps  linear v<3, <x>>
// CHECK:         dxsa.dcl_input_ps  linear v<4, <x>>
// CHECK:         dxsa.dcl_input_ps  linear v<5, <x>>
// CHECK:         dxsa.dcl_input_ps  linear v<6, <x>>
// CHECK:         dxsa.dcl_input_ps  linear v<7, <x>>
// CHECK:         dxsa.dcl_input_ps  linear v<8, <x>>
// CHECK:         dxsa.dcl_input_ps  constant v<9, <x>>
// CHECK:         dxsa.dcl_input_ps_sgv v<10, <x>>, <sampleIndex>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.dcl_index_range v<0, <x, y>>, 3
// CHECK:         dxsa.dcl_index_range v<3, <x>>, 6
// CHECK:         dxsa.mov r<0, <x>>, v<10, <x>>
// CHECK:         dxsa.add r<0, <x>>, v<r<0, <x>>, <x>>, v<2, <y>>
// CHECK:         dxsa.mov r<0, <y>>, v<9, <x>>
// CHECK:         dxsa.add o<0, <x>>, r<0, <x>>, v<3 + r<0, <y>>, <x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xy
dcl_input_ps linear v1.xy
dcl_input_ps linear v2.xy
dcl_input_ps linear v3.x
dcl_input_ps linear v4.x
dcl_input_ps linear v5.x
dcl_input_ps linear v6.x
dcl_input_ps linear v7.x
dcl_input_ps linear v8.x
dcl_input_ps constant v9.x
dcl_input_ps_sgv constant v10.x, sampleIndex
dcl_output o0.x
dcl_temps 1
dcl_indexrange v0.xy, 3
dcl_indexrange v3.x, 6
mov r0.x, v10.x
add r0.x, v[r0.x].x, v2.y
mov r0.y, v9.x
add o0.x, r0.x, v[3 + r0.y].x
ret
