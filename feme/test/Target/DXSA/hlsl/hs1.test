// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.mov r<0, <x>>, vPrim
// CHECK:         dxsa.mov o<1, <x>>, vicp<[r<0, <x>>, 0], <y>>
// CHECK:         dxsa.ret
// CHECK:         dxsa.hs_fork_phase
