// CHECK:         dxsa.instruction "if" %[[OPERAND_0]]
// CHECK:         dxsa.mov o<0, <x>>, v<0, <x>>
// CHECK:         dxsa.ret
// CHECK:         dxsa.endif
// CHECK:         dxsa.mov o<0, <x>>, v<0, <y>>
// CHECK:         dxsa.ret

