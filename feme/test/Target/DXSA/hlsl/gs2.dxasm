// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 1>, <immediateIndexed>
// CHECK:         dxsa.dcl_input v<[1, 0]>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.dcl_input_primitive  point
// CHECK:         dxsa.dcl_stream 0
// CHECK:         dxsa.dcl_output_topology  pointlist
// CHECK:         dxsa.dcl_output_siv o<0>, <position>
// CHECK:         dxsa.dcl_output o<1, <x, y>>
// CHECK:         dxsa.dcl_stream 1
// CHECK:         dxsa.dcl_output_topology  pointlist
// CHECK:         dxsa.dcl_output o<0, <x, y, z>>
// CHECK:         dxsa.dcl_output o<1>
// CHECK:         dxsa.dcl_output o<2>
// CHECK:         dxsa.dcl_output o<3>
// CHECK:         dxsa.dcl_output o<4, <x, y, z>>
// CHECK:         dxsa.dcl_stream 2
// CHECK:         dxsa.dcl_output_topology  pointlist
// CHECK:         dxsa.dcl_output_siv o<0>, <position>
// CHECK:         dxsa.dcl_output o<1, <x, y>>
// CHECK:         dxsa.dcl_max_output_vertex_count 12
// CHECK:         dxsa.ftou r<0, <x, y, z>>, v<[0, 0], <x, y, z, x>>
// CHECK:         dxsa.mul r<1>, l(0x42300000, 0x42300000, 0x42300000, 0x42300000), v<[0, 0]>
// CHECK:         %[[INDEX_0:.*]] = dxsa.index.imm {imm = 0 : i32}
// CHECK:         %[[INDEX_1:.*]] = dxsa.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_0:.*]] = dxsa.operand %[[INDEX_0]], %[[INDEX_1]] {num_components = 4 : i32, one = 0 : i32, type = 8 : i32}
// CHECK:         dxsa.instruction "if" %[[OPERAND_0]]
// CHECK:         dxsa.mov o<0>, v<[0, 0]>
// CHECK:         dxsa.mov o<1, <x, y>>, v<[0, 0], <x, y, x, x>>
// CHECK:         dxsa.emit_stream 0
// CHECK:         dxsa.cut_stream 0
// CHECK:         dxsa.mov r<0, <w>>, r<0, <x>>
// CHECK:         dxsa.else
// CHECK:         dxsa.ftou r<0, <w>>, v<[0, 0], <w>>
// CHECK:         dxsa.mov o<0, <x>>, r<0, <w>>
// CHECK:         dxsa.mov o<0, <y, z>>, r<0, <y, y, z, y>>
// CHECK:         dxsa.mov o<1>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.mov o<2>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.mov o<3>, r<1>
// CHECK:         dxsa.mov o<4, <x, y, z>>, r<0, <x, y, z, x>>
// CHECK:         dxsa.emit_stream 1
// CHECK:         dxsa.cut_stream 1
// CHECK:         dxsa.endif
// CHECK:         dxsa.mov o<0, <x>>, r<0, <w>>
// CHECK:         dxsa.mov o<0, <y, z>>, r<0, <y, y, z, y>>
// CHECK:         dxsa.mov o<1>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.mov o<2>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.mov o<3>, r<1>
// CHECK:         dxsa.mov o<4, <x, y, z>>, r<0, <x, y, z, x>>
// CHECK:         dxsa.emit_stream 1
// CHECK:         dxsa.cut_stream 1
// CHECK:         dxsa.mov o<0>, v<[0, 0]>
// CHECK:         dxsa.mov o<1, <x, y>>, v<[0, 0], <x, y, x, x>>
// CHECK:         dxsa.emit_stream 2
// CHECK:         dxsa.cut_stream 2
// CHECK:         dxsa.ret

.shader_model geometry 5 0
dcl_globalFlags refactoringAllowed
dcl_constantbuffer cb0[1].xyzw
dcl_input v1[0].xyzw
dcl_temps 2
dcl_inputprimitive point
dcl_stream m0
dcl_outputtopology pointlist
dcl_output_siv o0.xyzw, position
dcl_output o1.xy
dcl_stream m1
dcl_outputtopology pointlist
dcl_output o0.xyz
dcl_output o1.xyzw
dcl_output o2.xyzw
dcl_output o3.xyzw
dcl_output o4.xyz
dcl_stream m2
dcl_outputtopology pointlist
dcl_output_siv o0.xyzw, position
dcl_output o1.xy
dcl_maxout 12
ftou r0.xyz, v0[0].xyzx
mul r1.xyzw, l(0x42300000, 0x42300000, 0x42300000, 0x42300000), v0[0].xyzw
if_nz cb0[0].x
mov o0.xyzw, v0[0].xyzw
mov o1.xy, v0[0].xyxx
emit_stream m0
cut_stream m0
mov r0.w, r0.x
else
ftou r0.w, v0[0].w
mov o0.x, r0.w
mov o0.yz, r0.yyzy
mov o1.xyzw, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
mov o2.xyzw, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
mov o3.xyzw, r1.xyzw
mov o4.xyz, r0.xyzx
emit_stream m1
cut_stream m1
endif
mov o0.x, r0.w
mov o0.yz, r0.yyzy
mov o1.xyzw, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
mov o2.xyzw, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
mov o3.xyzw, r1.xyzw
mov o4.xyz, r0.xyzx
emit_stream m1
cut_stream m1
mov o0.xyzw, v0[0].xyzw
mov o1.xy, v0[0].xyxx
emit_stream m2
cut_stream m2
ret
