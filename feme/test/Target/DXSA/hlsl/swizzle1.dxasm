// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x, y, z>>
// CHECK:         dxsa.dcl_input_ps  linear v<1, <x, z, w>>
// CHECK:         dxsa.dcl_input_ps  linear v<2, <x, y>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.add r<0>, v<0, <x, x, z, y>>, v<1, <z, w, w, x>>
// CHECK:         dxsa.add r<0>, r<0>, v<2, <x, y, y, x>>
// CHECK:         dxsa.add o<0>, r<0>, l(0x0, 0x3F800000, 0x40000000, 0x40400000)
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xyz
dcl_input_ps linear v1.xzw
dcl_input_ps linear v2.xy
dcl_output o0.xyzw
dcl_temps 1
add r0.xyzw, v0.xxzy, v1.zwwx
add r0.xyzw, r0.xyzw, v2.xyyx
add o0.xyzw, r0.xyzw, l(0x00000000, 0x3F800000, 0x40000000, 0x40400000)
ret
