// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableDoublePrecisionFloatOps>
// CHECK:         dxsa.dcl_constant_buffer <id = 0, size = 5>, <dynamicIndexed>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x, y>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x, y>>
// CHECK:         dxsa.dcl_input_ps  constant v<2, <x, y>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.dcl_indexable_temp x<0>[6]
// CHECK:         dxsa.dcl_indexable_temp x<1>[4]
// CHECK:         dxsa.dmov x<[0, 0], <x, y>>, d(0x4020000000000000, 0x0)
// CHECK:         dxsa.dmov x<[0, 1], <x, y>>, d(0x3FF0000000000000, 0x0)
// CHECK:         dxsa.dmov x<[0, 2], <x, y>>, d(0x4000000000000000, 0x0)
// CHECK:         dxsa.dmov x<[0, 3], <x, y>>, d(0x400C7AE140000000, 0x0)
// CHECK:         dxsa.dmov x<[0, 4], <x, y>>, d(0x401C000000000000, 0x0)
// CHECK:         dxsa.dmov x<[0, 5], <x, y>>, d(0x4040800000000000, 0x0)
// CHECK:         dxsa.dmov x<[1, 0], <x, y>>, d(0x3FF0000000000000, 0x0)
// CHECK:         dxsa.dmov x<[1, 1], <x, y>>, d(0x4000000000000000, 0x0)
// CHECK:         dxsa.dmov x<[1, 2], <x, y>>, d(0x400C7AE140000000, 0x0)
// CHECK:         dxsa.dmov x<[1, 3], <x, y>>, d(0x401C000000000000, 0x0)
// CHECK:         dxsa.mov r<0, <x, y>>, cb<[0, 0], vector, <x, y, x, x>>
// CHECK:         dxsa.dmov r<0, <z, w>>, x<[1, r<0, <x>>], <x, y, x, y>>
// CHECK:         dxsa.dadd r<0, <z, w>>, r<0, <z, w, z, w>>, cb<[0, 1 + r<0, <x>>], vector, <x, y, x, y>>
// CHECK:         dxsa.dmov r<1, <x, y>>, x<[0, r<0, <y>>], <x, y, x, y>>
// CHECK:         dxsa.dadd r<0, <z, w>>, r<0, <z, w, z, w>>, r<1, <x, y, x, y>>
// CHECK:         dxsa.mov r<1, <x, y>>, v<0, <x, y, x, x>>
// CHECK:         dxsa.mov r<1, <z, w>>, v<1, <x, x, x, y>>
// CHECK:         dxsa.dadd r<1, <x, y>>, r<1, <z, w, z, w>>, r<1, <x, y, x, y>>
// CHECK:         dxsa.mov r<1, <z, w>>, v<2, <x, x, x, y>>
// CHECK:         dxsa.dadd r<1, <x, y>>, r<1, <z, w, z, w>>, r<1, <x, y, x, y>>
// CHECK:         dxsa.dadd r<0, <z, w>>, r<0, <z, w, z, w>>, r<1, <x, y, x, y>>
// CHECK:         dxsa.dmov x<[1, r<0, <y>>], <x, y>>, r<0, <z, w, z, w>>
// CHECK:         dxsa.dmov r<0, <x, y>>, x<[1, r<0, <x>>], <x, y, x, y>>
// CHECK:         dxsa.dadd r<0, <x, y>>, r<0, <x, y, x, y>>, r<0, <z, w, z, w>>
// CHECK:         dxsa.mov o<0>, r<0, <x, y, x, y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | enableDoublePrecisionFloatOps
dcl_constantbuffer_dynamicIndexed cb0[5].xyzw
dcl_input_ps constant v0.xy
dcl_input_ps constant v1.xy
dcl_input_ps constant v2.xy
dcl_output o0.xyzw
dcl_temps 2
dcl_indexableTemp x0[6], 4
dcl_indexableTemp x1[4], 4
dmov x0[0].xy, d(0x4020000000000000, 0x0000000000000000)
dmov x0[1].xy, d(0x3FF0000000000000, 0x0000000000000000)
dmov x0[2].xy, d(0x4000000000000000, 0x0000000000000000)
dmov x0[3].xy, d(0x400C7AE140000000, 0x0000000000000000)
dmov x0[4].xy, d(0x401C000000000000, 0x0000000000000000)
dmov x0[5].xy, d(0x4040800000000000, 0x0000000000000000)
dmov x1[0].xy, d(0x3FF0000000000000, 0x0000000000000000)
dmov x1[1].xy, d(0x4000000000000000, 0x0000000000000000)
dmov x1[2].xy, d(0x400C7AE140000000, 0x0000000000000000)
dmov x1[3].xy, d(0x401C000000000000, 0x0000000000000000)
mov r0.xy, cb0[0].xyxx
dmov r0.zw, x1[r0.x].xyxy
dadd r0.zw, r0.zwzw, cb0[1 + r0.x].xyxy
dmov r1.xy, x0[r0.y].xyxy
dadd r0.zw, r0.zwzw, r1.xyxy
mov r1.xy, v0.xyxx
mov r1.zw, v1.xxxy
dadd r1.xy, r1.zwzw, r1.xyxy
mov r1.zw, v2.xxxy
dadd r1.xy, r1.zwzw, r1.xyxy
dadd r0.zw, r0.zwzw, r1.xyxy
dmov x1[r0.y].xy, r0.zwzw
dmov r0.xy, x1[r0.x].xyxy
dadd r0.xy, r0.xyxy, r0.zwzw
mov o0.xyzw, r0.xyxy
ret
