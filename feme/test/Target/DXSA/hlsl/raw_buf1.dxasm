// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_resource_raw t0
dcl_uav_raw u1
dcl_input_ps linear v0.x
dcl_input_ps linear v0.y
dcl_output o0.xyzw
dcl_temps 16
ftou r0.xy, v0.xyxx
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.z, r0.x, u1.xxxx
add r1.xyz, v0.xxxx, l(0x3F800000, 0x40000000, 0x40400000, 0x00000000)
ftou r1.xyz, r1.xyzx
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r2.xy, r1.x, u1.xyxx
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r3.xyz, r1.y, u1.xyzx
utof r3.xyz, r3.xyzx
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r4.xyzw, r1.z, u1.xyzw
utof r4.xyzw, r4.xyzw
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r5.x, r6.x, r0.x, u1.xxxx
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r7.x, r8.x, r1.x, u1.xxxx
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r9.x, r10.x, r1.y, u1.xxxx
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r11.x, r12.x, r1.z, u1.xxxx
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.w, r0.x, t0.xxxx
utof r13.x{min16f}, r0.w
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r2.zw, r1.x, t0.xxxy
utof r2.xyzw, r2.xyzw
add r2.zw, r2.zzzw, r13.xxxx{min16f}
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r5.yzw, r1.y, t0.xxyz
utof r5.yzw, r5.yyzw
add r14.xy, r2.zwzz, r5.yzyy
add r14.z, r5.w, r13.x{min16f}
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r15.xyzw, r1.z, t0.xyzw
utof r15.xyzw, r15.xyzw
add r14.xyz, r14.xyzx, r15.xyzx
add r14.w, r13.x{min16f}, r15.w
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.x, r15.x, r0.x, t0.xxxx
check_access_fully_mapped r0.w, r15.x
utof r0.xzw, r0.xxzw
add r13.xyzw, r0.xxxx, r14.xyzw
add r13.xyzw, r0.wwww, r13.xyzw
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.x, r1.x, r1.x, t0.xxxx
check_access_fully_mapped r0.w, r1.x
utof r0.xw, r0.xxxw
add r13.xy, r0.xxxx, r13.xyxx
add r13.xyzw, r0.wwww, r13.xyzw
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.x, r1.x, r1.y, t0.xxxx
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r14.x, r15.x, r1.z, t0.xxxx
check_access_fully_mapped r0.w, r1.x
utof r0.xw, r0.xxxw
add r13.xyz, r0.xxxx, r13.xyzx
add r1.xyzw, r0.wwww, r13.xyzw
utof r0.x, r14.x
check_access_fully_mapped r0.w, r15.x
utof r0.w, r0.w
add r1.xyzw, r0.xxxx, r1.xyzw
add r1.xyzw, r0.wwww, r1.xyzw
add r1.xyzw, r0.zzzz, r1.xyzw
add r1.xy, r2.xyxx, r1.xyxx
add r1.xyz, r3.xyzx, r1.xyzx
add r1.xyzw, r4.xyzw, r1.xyzw
utof r0.x, r5.x
check_access_fully_mapped r0.z, r6.x
utof r0.z, r0.z
add r1.xyzw, r0.xxxx, r1.xyzw
add r1.xyzw, r0.zzzz, r1.xyzw
utof r0.x, r7.x
check_access_fully_mapped r0.z, r8.x
utof r0.z, r0.z
add r1.xy, r0.xxxx, r1.xyxx
add r1.xyzw, r0.zzzz, r1.xyzw
utof r0.x, r9.x
check_access_fully_mapped r0.z, r10.x
utof r0.z, r0.z
add r1.xyz, r0.xxxx, r1.xyzx
add r1.xyzw, r0.zzzz, r1.xyzw
utof r0.x, r11.x
check_access_fully_mapped r0.z, r12.x
utof r0.z, r0.z
add r1.xyzw, r0.xxxx, r1.xyzw
add r1.xyzw, r0.zzzz, r1.xyzw
ftou r0.xzw, r1.wwwz
store_raw u1.x, r0.y, r0.x
add r2.xyz, v0.yyyy, l(0x3F800000, 0x40000000, 0x40400000, 0x00000000)
ftou r2.xyz, r2.xyzx
store_raw u1.xy, r2.x, r0.zwzz
ftou r0.xyz, r1.wzyw
store_raw u1.xyz, r2.y, r0.xyzx
ftou r0.xyzw, r1.wzyx
mov o0.xyzw, r1.xyzw
store_raw u1.xyzw, r2.z, r0.xyzw
ret
