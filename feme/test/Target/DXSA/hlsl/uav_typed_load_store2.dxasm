// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed|enableMinimumPrecision>
// CHECK:         dxsa.dcl_uav_typed <id = 3, dim =  buffer>, <x =  sint, y =  sint, z =  sint, w =  sint>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x>>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <y>>
// CHECK:         dxsa.dcl_output o<0, <x, y, z>>
// CHECK:         dxsa.dcl_temps 5
// CHECK:         dxsa.ld_uav_typed r<0, min16i, <x, y, z>>, v<0, <y, y, y, y>>, u<3, vector>
// CHECK:         dxsa.ld_uav_typed r<1, min16i, <x, y, z>>, v<0, <x, x, x, x>>, u<3, vector>
// CHECK:         dxsa.iadd r<2, <x, y, z>>, r<0, min16i, <x, y, z, x>>, r<1, min16i, <x, y, z, x>>
// CHECK:         dxsa.ld_uav_typed_s null, v<0, <y, y, y, y>>, u<3, vector, <w, y, z, x>>, r<3, <x>>
// CHECK:         dxsa.ld_uav_typed_s r<0, min16i, <x, y, z>>, v<0, <x, x, x, x>>, u<3, vector, <w, y, z, x>>, r<4, <x>>
// CHECK:         dxsa.check_access_fully_mapped r<2, <w>>, r<3, <x>>
// CHECK:         dxsa.iadd r<2, <x, y, z>>, r<2, <w, w, w, w>>, r<2, <x, y, z, x>>
// CHECK:         dxsa.check_access_fully_mapped r<2, <w>>, r<4, <x>>
// CHECK:         dxsa.iadd r<2, <x, y, z>>, r<0, min16i, <x, y, z, x>>, r<2, <x, y, z, x>>
// CHECK:         dxsa.iadd r<2, <x, y, z>>, r<2, <w, w, w, w>>, r<2, <x, y, z, x>>
// CHECK:         %[[INDEX_4:.*]] = dxsa.index.imm {imm = 3 : i32}
// CHECK:         %[[OPERAND_4:.*]] = dxsa.operand %[[INDEX_4]] {mask = 240 : i32, num_components = 4 : i32, type = 30 : i32}
// CHECK:         %[[INDEX_5:.*]] = dxsa.index.imm {imm = 0 : i32}
// CHECK:         %[[OPERAND_5:.*]] = dxsa.operand %[[INDEX_5]] {num_components = 4 : i32, swizzle = dense<1> : vector<4xi32>, type = 1 : i32}
// CHECK:         %[[INDEX_6:.*]] = dxsa.index.imm {imm = 2 : i32}
// CHECK:         %[[OPERAND_6:.*]] = dxsa.operand %[[INDEX_6]] {num_components = 4 : i32, swizzle = dense<[0, 1, 2, 0]> : vector<4xi32>, type = 0 : i32}
// CHECK:         dxsa.instruction "store_uav_typed" %[[OPERAND_4]], %[[OPERAND_5]], %[[OPERAND_6]]
// CHECK:         dxsa.mov o<0, <x, y, z>>, r<2, <x, y, z, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed | enableMinimumPrecision
dcl_uav_typed_buffer (sint, sint, sint, sint) u3
dcl_input_ps constant v0.x
dcl_input_ps constant v0.y
dcl_output o0.xyz
dcl_temps 5
ld_uav_typed resource_dim(buffer) resource_return_type(sint, sint, sint, sint) r0.xyz{min16i}, v0.yyyy, u3.xyzw
ld_uav_typed resource_dim(buffer) resource_return_type(sint, sint, sint, sint) r1.xyz{min16i}, v0.xxxx, u3.xyzw
iadd r2.xyz, r0.xyzx{min16i}, r1.xyzx{min16i}
ld_uav_typed_s resource_dim(buffer) resource_return_type(sint, sint, sint, sint) null, r3.x, v0.yyyy, u3.wyzx
ld_uav_typed_s resource_dim(buffer) resource_return_type(sint, sint, sint, sint) r0.xyz{min16i}, r4.x, v0.xxxx, u3.wyzx
check_access_fully_mapped r2.w, r3.x
iadd r2.xyz, r2.wwww, r2.xyzx
check_access_fully_mapped r2.w, r4.x
iadd r2.xyz, r0.xyzx{min16i}, r2.xyzx
iadd r2.xyz, r2.wwww, r2.xyzx
store_uav_typed u3.xyzw, v0.yyyy, r2.xyzx
mov o0.xyz, r2.xyzx
ret
