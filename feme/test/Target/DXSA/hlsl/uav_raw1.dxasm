// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_uav_raw <id = 3>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x>>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <y>>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.ld_raw r<0, <x>>, v<0, <x>>, u<3, vector, <x, x, x, x>>
// CHECK:         dxsa.utof r<0, <x>>, r<0, <x>>
// CHECK:         dxsa.ld_raw_s null, v<0, <x>>, u<3, vector, <x, x, x, x>>, r<1, <x>>
// CHECK:         dxsa.check_access_fully_mapped r<0, <y>>, r<1, <x>>
// CHECK:         dxsa.utof r<0, <y>>, r<0, <y>>
// CHECK:         dxsa.mad r<0>, r<0, <y, y, y, y>>, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r<0, <x, x, x, x>>
// CHECK:         dxsa.ftou r<1, <x>>, r<0, <w>>
// CHECK:         dxsa.mov o<0>, r<0>
// CHECK:         dxsa.store_raw u<3, vector>, v<0, <y>>, r<1, <x, x, x, x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_uav_raw u3
dcl_input_ps constant v0.x
dcl_input_ps constant v0.y
dcl_output o0.xyzw
dcl_temps 2
ld_raw resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) r0.x, v0.x, u3.xxxx
utof r0.x, r0.x
ld_raw_s resource_dim(raw_buffer) resource_return_type(mixed, mixed, mixed, mixed) null, r1.x, v0.x, u3.xxxx
check_access_fully_mapped r0.y, r1.x
utof r0.y, r0.y
mad r0.xyzw, r0.yyyy, l(0x40000000, 0x40000000, 0x40000000, 0x40000000), r0.xxxx
ftou r1.x, r0.w
mov o0.xyzw, r0.xyzw
store_raw u3.xyzw, v0.y, r1.xxxx
ret
