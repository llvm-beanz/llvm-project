// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0>
// CHECK:         dxsa.dcl_input_ps  linear v<1>
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.deriv_rtx_coarse r<0>, v<1>
// CHECK:         dxsa.deriv_rty_coarse r<1>, v<1>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.deriv_rtx_coarse r<1>, v<0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.deriv_rty_coarse r<1>, v<0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.deriv_rtx_fine r<1>, v<0>
// CHECK:         dxsa.add r<0>, r<0>, r<1>
// CHECK:         dxsa.deriv_rty_fine r<1>, v<0>
// CHECK:         dxsa.add o<0>, r<0>, r<1>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.xyzw
dcl_input_ps linear v1.xyzw
dcl_output o0.xyzw
dcl_temps 2
deriv_rtx_coarse r0.xyzw, v1.xyzw
deriv_rty_coarse r1.xyzw, v1.xyzw
add r0.xyzw, r0.xyzw, r1.xyzw
deriv_rtx_coarse r1.xyzw, v0.xyzw
add r0.xyzw, r0.xyzw, r1.xyzw
deriv_rty_coarse r1.xyzw, v0.xyzw
add r0.xyzw, r0.xyzw, r1.xyzw
deriv_rtx_fine r1.xyzw, v0.xyzw
add r0.xyzw, r0.xyzw, r1.xyzw
deriv_rty_fine r1.xyzw, v0.xyzw
add o0.xyzw, r0.xyzw, r1.xyzw
ret
