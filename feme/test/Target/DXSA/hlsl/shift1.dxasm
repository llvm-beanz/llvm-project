// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <x>>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <y>>
// CHECK:         dxsa.dcl_input_ps  constant v<0, <z>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.ishl r<0, <x>>, v<0, <x>>, l(0x4D)
// CHECK:         dxsa.ishr r<0, <y>>, v<0, <x>>, l(0x3)
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.ushr r<0, <y>>, v<0, <y>>, l(0x8)
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.ishl r<0, <y>>, v<0, <x>>, v<0, <z>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.ishr r<0, <y>>, v<0, <x>>, v<0, <z>>
// CHECK:         dxsa.iadd r<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.ushr r<0, <y>>, v<0, <y>>, v<0, <z>>
// CHECK:         dxsa.iadd o<0, <x>>, r<0, <y>>, r<0, <x>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps constant v0.x
dcl_input_ps constant v0.y
dcl_input_ps constant v0.z
dcl_output o0.x
dcl_temps 1
ishl r0.x, v0.x, l(0x0000004D)
ishr r0.y, v0.x, l(0x00000003)
iadd r0.x, r0.y, r0.x
ushr r0.y, v0.y, l(0x00000008)
iadd r0.x, r0.y, r0.x
ishl r0.y, v0.x, v0.z
iadd r0.x, r0.y, r0.x
ishr r0.y, v0.x, v0.z
iadd r0.x, r0.y, r0.x
ushr r0.y, v0.y, v0.z
iadd o0.x, r0.y, r0.x
ret
