// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input_ps  linear v<0, <x>>
// CHECK:         dxsa.dcl_input_ps  constant v<1, <x, z>>
// CHECK:         dxsa.dcl_output o<0, <x>>
// CHECK:         dxsa.dcl_temps 1
// CHECK:         dxsa.mov r<0, <x>>, v<1, <z>>
// CHECK:         dxsa.mov r<0, <y, z>>, l(0x0, 0x0, 0x0, 0x0)
// CHECK:         dxsa.loop
// CHECK:         dxsa.ige r<0, <w>>, r<0, <z>>, v<1, <x>>
// CHECK:         dxsa.breakc_nz r<0, <w>>
// CHECK:         dxsa.ieq r<0, <w>>, r<0, <x>>, l(0x5)
// CHECK:         dxsa.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxsa.retc_nz r<0, <w>>
// CHECK:         dxsa.ieq r<0, <w>>, r<0, <x>>, l(0x7)
// CHECK:         dxsa.if_nz r<0, <w>>
// CHECK:         dxsa.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxsa.ret
// CHECK:         dxsa.endif
// CHECK:         dxsa.add r<0, <y>>, r<0, <y>>, v<0, <x>>
// CHECK:         dxsa.iadd r<0, <z>>, r<0, <z>>, l(0x1)
// CHECK:         dxsa.endloop
// CHECK:         dxsa.mov o<0, <x>>, r<0, <y>>
// CHECK:         dxsa.ret

.shader_model pixel 5 0
dcl_globalFlags refactoringAllowed
dcl_input_ps linear v0.x
dcl_input_ps constant v1.xz
dcl_output o0.x
dcl_temps 1
mov r0.x, v1.z
mov r0.yz, l(0x00000000, 0x00000000, 0x00000000, 0x00000000)
loop
ige r0.w, r0.z, v1.x
breakc_nz r0.w
ieq r0.w, r0.x, l(0x00000005)
mov o0.x, r0.y
retc_nz r0.w
ieq r0.w, r0.x, l(0x00000007)
if_nz r0.w
mov o0.x, r0.y
ret
endif
add r0.y, r0.y, v0.x
iadd r0.z, r0.z, l(0x00000001)
endloop
mov o0.x, r0.y
ret
