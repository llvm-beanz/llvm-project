// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_global_flags <refactoringAllowed>
// CHECK:         dxsa.dcl_input v<0>
// CHECK:         dxsa.dcl_input_sgv v<1, <x>>, <vertexID>
// CHECK:         dxsa.dcl_input_sgv v<2, <x>>, <instanceID>
// CHECK:         dxsa.dcl_output_siv o<0>, <position>
// CHECK:         dxsa.dcl_temps 2
// CHECK:         dxsa.utof r<0, <x>>, v<1, <x>>
// CHECK:         dxsa.add r<0>, r<0, <x, x, x, x>>, v<0>
// CHECK:         dxsa.utof r<1, <x>>, v<2, <x>>
// CHECK:         dxsa.add o<0>, r<0>, r<1, <x, x, x, x>>
// CHECK:         dxsa.ret

.shader_model vertex 5 0
dcl_globalFlags refactoringAllowed
dcl_input v0.xyzw
dcl_input_sgv v1.x, vertexID
dcl_input_sgv v2.x, instanceID
dcl_output_siv o0.xyzw, position
dcl_temps 2
utof r0.x, v1.x
add r0.xyzw, r0.xxxx, v0.xyzw
utof r1.x, v2.x
add o0.xyzw, r0.xyzw, r1.xxxx
ret
