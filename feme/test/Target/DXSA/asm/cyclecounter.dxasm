// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL:   dxsa.dcl_temps 1
// CHECK:         dxsa.dcl_output o<0>
// CHECK:         dxsa.dcl_input cycleCounter<<x>>
// CHECK:         dxsa.mov r<0>, l(0x0)
// CHECK:         dxsa.mov r<0, <z>>, cycleCounter<<x>>
// CHECK:         dxsa.mov o<0>, r<0>

.shader_model pixel 5 0
dcl_temps 1
dcl_output o0.xyzw
dcl_input cycleCounter.x
mov r0.xyzw, l(0x00000000)
mov r0.z, cycleCounter.x
mov o0.xyzw, r0.xyzw
