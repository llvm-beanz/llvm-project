// CHECK:         dxsa.dcl_input vpc<0, <x, y>>
// CHECK:         dxsa.dcl_input vpc<1, <x, y>>
// CHECK:         dxsa.dcl_input vpc<2, <x, y>>
// CHECK:         dxsa.dcl_input vpc<3, <x, y>>
// CHECK:         dxsa.dcl_index_range vpc<0>, 4
