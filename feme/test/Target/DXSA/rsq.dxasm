// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK:      dxsa.module {

// CHECK-NEXT:   dxsa.rsq r<0>, r<1>
rsq r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.rsq r<0>, -r<1>
rsq r0.xyzw, -r1.xyzw

// CHECK-NEXT:   dxsa.rsq r<0>, |r<1>|
rsq r0.xyzw, |r1.xyzw|

// CHECK-NEXT:   dxsa.rsq r<0>, -|r<1>|
rsq r0.xyzw, -|r1.xyzw|

// CHECK-NEXT:   dxsa.rsq r<0, <x>>, r<1, <y, z, w, y>>
rsq r0.x, r1.yzwy

// CHECK-NEXT:   dxsa.rsq precise <x, y> r<0>, r<1>
rsq precise(xy) r0.xyzw, r1.xyzw

// CHECK-NEXT:   dxsa.rsq_sat r<0>, r<1>
rsq_sat r0.xyzw, r1.xyzw
// CHECK-NEXT: }
