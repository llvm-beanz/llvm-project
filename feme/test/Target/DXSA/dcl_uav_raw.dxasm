// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | FileCheck %s
// RUN: dxbc-as %s | feme-translate --import-dxsa-bin - | feme-opt --verify-roundtrip

// CHECK:      module {

// CHECK-NEXT:   dxsa.dcl_uav_raw <id = 0>
dcl_uav_raw u0

// CHECK-NEXT:   dxsa.dcl_uav_raw <id = 1>, <flags =  globallyCoherent>
dcl_uav_raw globallyCoherent u1

// CHECK-NEXT:   dxsa.dcl_uav_raw <id = 2>, <flags =  globallyCoherent|rasterizerOrdered>
dcl_uav_raw globallyCoherent rasterizerOrdered u2

// CHECK-NEXT:   dxsa.dcl_uav_raw <id = 0, lbound = 0, ubound = 3, space = 1>
dcl_uav_raw u0[0][3], 1
// CHECK-NEXT: }
