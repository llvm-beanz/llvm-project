// Source for alu-ops.dxbc: a temp-register-only program covering
// saturate (_sat), negate (-), absolute value (| |), and movc -- matching
// feme/tools/dxbc-as-fuzzer/seed-corpus/alu-ops.dxasm.
// Regenerate the binary fixture with:
//   dxbc-as alu-ops.dxasm -o alu-ops.dxbc
dcl_temps 2
mov r0.xyzw, l(1.0, 2.0, 3.0, 4.0)
add r1.xy, r0.xyzw, -r0.zwzw
mul_sat r0.xyzw, r0.xyzw, r0.xyzw
mad r0.x, r0.y, r0.z, |r0.w|
itof r1.x, r0.x
movc r0.xyzw, r1.xyzw, r0.xyzw, r1.xyzw
ret
