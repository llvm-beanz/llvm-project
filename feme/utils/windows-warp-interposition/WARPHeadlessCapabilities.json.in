{
  "schema_version": @FEME_WARP_PROFILE_VERSION@,
  "profile": "internal-headless-w2-in-progress",
  "complete_product_feature_level": null,
  "pointer_bytes": @CMAKE_SIZEOF_VOID_P@,
  "runtime": "stock D3D12/DXGI with the existing unmodified WARP KMD",
  "ddi": {
    "device_core": "D3D12DDI_SUPPORTED_0072",
    "command_list": "D3D12DDI_COMMAND_LIST_FUNCS_3D_0062",
    "command_queue": "D3D12DDI_COMMAND_QUEUE_FUNCS_CORE_0001"
  },
  "compiler_bridge_version": 4,
  "artifact_abi_version": 11,
  "input_profiles": ["released SM 5.1", "released SM 6.0"],
  "shader_scope": ["application compute subset", "initialization vertex only"],
  "wave_policy": {
    "min": 4,
    "max": 4,
    "total": 4,
    "advertised_wave_ops": false,
    "native_requested_wave_4": "accepted",
    "native_requested_wave_8": "rejected",
    "public_sm_6_6": "not advertised"
  },
  "limits": {
    "nodes": 1,
    "root_buffer_descriptors": 32,
    "root_parameters": 64,
    "max_prepared_buffer_bindings": 64,
    "descriptor_heap_capacity": 1000000,
    "max_structured_buffer_stride": 2048,
    "root_dwords": 64,
    "root_gpuva_alignment": 16,
    "root_cbv_gpuva_alignment": 256,
    "buffer_allocation_alignment": 65536,
    "max_buffer_allocation_bytes": 4294901760,
    "dispatch_groups_per_dimension": 65535
  },
  "binding_scope": ["root raw SRV", "root raw UAV", "root CBV", "multiple inline constants", "finite CBV/SRV/UAV descriptor-table ranges", "non-uniform finite buffer-array selection", "all-stage compute visibility", "disjoint conventional graphics-stage root visibility", "compute preparation excludes non-compute-visible roots"],
  "descriptor_scope": ["CBV/SRV/UAV heap ownership", "CBV creation and null CBVs", "raw/structured buffer SRV/UAV creation and null views", "R32/R32G32/R32G32B32A32 UINT/SINT/FLOAT typed buffer SRV/UAVs", "R8/RGBA8 UINT/SINT/UNORM and R16/RGBA16 UINT/SINT/FLOAT typed buffer SRV/UAVs", "complete fifteen-format additional typed-UAV buffer set", "Direct3D narrow integer store saturation", "typed SRV component mappings and constant/default channels", "non-uniform live typed-buffer dimension queries", "CPU-source descriptor copies", "execution-time finite buffer table preparation", "live CPU-metadata residency"],
  "typed_uav_load_additional_formats": true,
  "resource_scope": ["committed L0 buffers", "placed L0 buffers", "upload", "readback", "default UAV"],
  "copy_scope": ["buffer byte regions", "exact-format uncompressed placed buffer footprints", "pitched row/depth region copies", "recorded layout and box snapshots"],
  "root_gpuva_alias_bounds": "largest matching live logical buffer extent; excludes implicit backing allocations",
  "barrier_scope": ["buffer transition", "buffer UAV", "whole-buffer aliasing via 0022 ranged flags"],
  "indirect_scope": ["dispatch-only signatures", "four-byte-aligned padded strides", "execution-time arguments and optional clamped count"],
  "synchronization": "runtime monitored fences and per-queue kernel Ready/Done gates",
  "predication_scope": ["execution-time 64-bit buffer values", "equal/not-equal-zero suppression", "direct/indirect dispatch and buffer copies", "recorded state and disabled list reset", "unpredicated barriers"],
  "counter_scope": ["structured UAV counter resource ownership", "4096-byte-aligned counter offsets", "execution-time exact four-byte storage", "per-active-lane increment/decrement", "bounded uint append/consume with guarded data and exact counts", "divergent fixed-counter selection and non-uniform output arrays", "CPU descriptor copies and null replacement", "pending submission lifetime"],
  "normative_requirements": [
    "D3D12_MAX_ROOT_COST",
    "D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT",
    "D3D12_CS_DISPATCH_MAX_THREAD_GROUPS_PER_DIMENSION",
    "D3D12DDI_ROOT_SIGNATURE_VERSION_1_1",
    "D3D12DDI_SHADER_CAPS_0012",
    "D3D11.3 functional specification 3.2.3.13 integer conversion",
    "D3D12DDI_RESOURCE_BARRIER_FLAG_0022_ALIASING",
    "D3D12DDIARG_CREATE_COMMAND_SIGNATURE_0001",
    "D3D12_DISPATCH_ARGUMENTS",
    "D3D12_PREDICATION_OP",
    "D3D12_UAV_COUNTER_PLACEMENT_ALIGNMENT",
    "D3DDDICB_WAITFORSYNCHRONIZATIONOBJECTFROMGPU",
